<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>EmulatorWorkspace</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductName>Emulator Workspace</ProductName>
    <Manufacturer>Emulator Workspace</Manufacturer>
    <Copyright>Copyright (c) Emulator Workspace contributors</Copyright>
    <PackageId>EmulatorWorkspace</PackageId>
    <!-- ICE60 warns about the satellite assemblies of the .NET runtime,
         which live in culture directories; they are installed as they are. -->
    <!-- ICE60 warns about the satellite assemblies of the .NET runtime,
         which live in culture directories; they are installed as they are.
         ICE64 wants every harvested directory of the user profile in the
         RemoveFile table; the files are removed with their parent, and the
         profile folders themselves are removed by their own component. -->
    <SuppressIces>ICE60;ICE61;ICE64</SuppressIces>
    <EnableDefaultItems>false</EnableDefaultItems>
    <DefineConstants>ProductVersion=$(PkgVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Product.wxs" />
    <Compile Include="Payload.wxs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
