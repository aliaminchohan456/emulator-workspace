<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>EmulatorWorkspace</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductName>Emulator Workspace</ProductName>
    <Manufacturer>Emulator Workspace</Manufacturer>
    <Copyright>Copyright (c) Emulator Workspace contributors</Copyright>
    <PackageId>EmulatorWorkspace</PackageId>
    <SuppressIces>ICE61</SuppressIces>
    <EnableDefaultItems>false</EnableDefaultItems>
    <OutputPath>$(OutputDir)\</OutputPath>
    <IntermediateOutputPath>$(StageDir)\obj\</IntermediateOutputPath>
    <BaseIntermediateOutputPath>$(StageDir)\obj\</BaseIntermediateOutputPath>
    <DefineConstants>ProductVersion=$(PkgVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Product.wxs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
