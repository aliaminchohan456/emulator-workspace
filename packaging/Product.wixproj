<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>EmulatorWorkspace</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductName>Emulator Workspace</ProductName>
    <Manufacturer>Emulator Workspace</Manufacturer>
    <Version Condition="$(VersionPrefix) != ''">$(VersionPrefix)</Version>
    <Version Condition="$(VersionPrefix) == ''">0.1.0</Version>
    <Copyright>Copyright (c) Emulator Workspace contributors</Copyright>
    <PackageId>EmulatorWorkspace</PackageId>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>ProductVersion=$(Version);StageDir=$(StageDir)</DefineConstants>
    <SuppressIces>ICE61</SuppressIces>
    <OutputPath>$(StageDir)\</OutputPath>
    <IntermediateOutputPath>$(StageDir)\obj\</IntermediateOutputPath>
    <BaseIntermediateOutputPath>$(StageDir)\obj\</BaseIntermediateOutputPath>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <Payload Include="$(StageDir)\payload\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Product.wxs" />
  </ItemGroup>

</Project>
