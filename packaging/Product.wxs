<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Emulator Workspace"
           Manufacturer="Emulator Workspace"
           Version="$(ProductVersion)"
           UpgradeCode="7C0B4F0E-9E1A-4A2E-9F41-6C9D4B2E5A11"
           Scope="perUser"
           Compressed="yes"
           InstallerVersion="500">
    <SummaryInformation Description="Emulator Workspace $(ProductVersion)" Manufacturer="Emulator Workspace" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Emulator Workspace is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPPRODUCTICON" Value="EmulatorWorkspace.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://localhost/emulator-workspace" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- The workspace state lives in the user profile, so an uninstall or an
         upgrade never touches the profiles of the operator. -->
    <Property Id="EMULATORWORKSPACEHOME" Secure="yes" />

    <Feature Id="Main" Title="Emulator Workspace" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

    <ui:WixUI Id="WixUI_FeatureTree" />

    <!-- The package installs into the user profile, where the installer keeps
         the files of a per-user package. They are removed by an explicit
         action, so an uninstall never leaves anything behind. -->
    <CustomAction Id="RemoveInstallFolder"
                  Directory="INSTALLFOLDER"
                  ExeCommand='cmd.exe /c rmdir /s /q "[INSTALLFOLDER]"'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RemoveInstallFolder" Before="RemoveFiles"
              Condition='REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE' />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <ComponentGroup Id="Shortcuts" Directory="MenuFolder">
      <Component Id="StartMenuShortcut" Guid="1B0B8C3A-8E3C-4F1E-9C2C-2E3C6D9A44F1">
        <Shortcut Id="DesktopShortcut"
                  Name="Emulator Workspace"
                  Description="Android emulator workspace"
                  Target="[INSTALLFOLDER]EmulatorWorkspace.Desktop.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveShortcutFolder" Directory="MenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\Emulator Workspace"
                       Name="Installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <!-- The directories in the user profile are removed on uninstall. -->
      <Component Id="RemoveProfileFolders" Guid="2C1D9E4B-7A65-4E3C-8B0D-9F2A5C6E7D81">
        <RemoveFolder Id="RemoveMenuFolder" Directory="MenuFolder" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\Emulator Workspace"
                       Name="ProfileFolders"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
