<Window x:Class="EmulatorWorkspace.Desktop.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EmulatorWorkspace.Desktop.Views"
        Title="Command palette"
        Width="560" Height="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}">
    <!-- UX-04b: the palette is a floating surface — 12 radius, specular edge and
         the two-layer shadow — and it arrives over 220 ms on the dialog curve
         (CommandPaletteWindow.xaml.cs, reduced motion aware). -->
    <Grid Margin="18">
        <views:FloatingSurface x:Name="PaletteCard" Style="{StaticResource FloatingDialog}"
                               Padding="16" RenderTransformOrigin="0.5,0.4">
            <views:FloatingSurface.RenderTransform>
                <TranslateTransform x:Name="PaletteRise" Y="0" />
            </views:FloatingSurface.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="Filter" Grid.Row="0" Margin="0,0,0,10"
                         AutomationProperties.Name="Command palette filter"
                         ToolTip="Type a command name and press Enter." />

                <ListBox x:Name="Results" Grid.Row="1" AutomationProperties.Name="Command palette results">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding Label}" FontSize="14" />
                                <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Margin="0,10,0,0"
                           Text="Enter runs the selected command, Escape closes the palette." />
            </Grid>
        </views:FloatingSurface>
    </Grid>
</Window>
