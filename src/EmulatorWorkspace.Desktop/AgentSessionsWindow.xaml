<Window x:Class="EmulatorWorkspace.Desktop.AgentSessionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EmulatorWorkspace.Desktop.Views"
        Title="Agent Sessions"
        Width="1240" Height="820" MinWidth="1000" MinHeight="640"
        Background="{DynamicResource WindowBg}"
        WindowStartupLocation="CenterOwner">

    <!-- UX-09 restyle to shots/08-agent-sessions.png. Same window, same three
         collections, same handlers: only the surface changed. The layout is the
         mockup's - an AUTOMATION eyebrow, the page title and its two-line
         description, one takeover action at the top right, an approval card on
         the left, the paired-session table and the operation log on the right -
         and the card stacks above the tables at 1024 DIP or narrower. -->
    <Window.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVis" />
        <views:CountToVisibilityConverter x:Key="CountVis" />
        <views:CountToVisibilityConverter x:Key="InverseCountVis" Invert="True" />
        <views:TextToVisibilityConverter x:Key="TextToVis" />
        <views:NullToVisibilityConverter x:Key="NullToVis" />

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The caps section headers the design sheet tracks (PAIRED SESSIONS). -->
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="views:Caps.Tracking" Value="True" />
        </Style>

        <!-- Column header of a table: 11 DIP text3, title case like the mockup. -->
        <Style x:Key="ColumnHead" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="RowText" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="RowMono" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <!-- A soft state chip. The tone word comes from the row (Tone), and every
             trigger sets both the tint and the label colour through
             DynamicResource brushes, so a live theme swap repaints the chip. The
             word is always printed next to the dot: colour never carries state. -->
        <Style x:Key="ToneChip" TargetType="Border" BasedOn="{StaticResource StatePill}">
            <Setter Property="Padding" Value="7,2,9,2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="ok">
                    <Setter Property="Background" Value="{DynamicResource SuccessBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warn">
                    <Setter Property="Background" Value="{DynamicResource WarningBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="err">
                    <Setter Property="Background" Value="{DynamicResource DangerBg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToneChipText" TargetType="TextBlock" BasedOn="{StaticResource StatePillText}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="10.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="ok">
                    <Setter Property="Foreground" Value="{DynamicResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warn">
                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="err">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToneDot" TargetType="Ellipse" BasedOn="{StaticResource StatePillDot}">
            <Setter Property="Width" Value="5" />
            <Setter Property="Height" Value="5" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Fill" Value="{DynamicResource TextTertiary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="ok">
                    <Setter Property="Fill" Value="{DynamicResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warn">
                    <Setter Property="Fill" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="err">
                    <Setter Property="Fill" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A granted scope: mono 10 on the raised chip tint, one per grant. -->
        <Style x:Key="ScopeChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ChipBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="ScopeChipText" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="LineHeight" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- One table row: hover through the shared 120 ms fade, selection in the
             shared tint. The mockup keeps the tables quiet, so there is no zebra
             striping and no grid line between rows, only the card's own edges. -->
        <Style x:Key="AgentRowItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="views:Motion.HoverFade" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <Border x:Name="Fill" Background="Transparent" CornerRadius="6" Margin="8,1" />
                            <Border x:Name="PART_Hover" Background="{DynamicResource HoverBg}" Opacity="0"
                                    CornerRadius="6" Margin="8,1" IsHitTestVisible="False" />
                            <Border x:Name="Ring" BorderThickness="1" CornerRadius="6" Margin="8,1"
                                    BorderBrush="{DynamicResource FocusRing}" Opacity="0"
                                    IsHitTestVisible="False" />
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SelectionBg}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A pairing request row in the approval card: client plus the request id
             on two lines, with the status chip on the right. -->
        <Style x:Key="PairingRowItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="views:Motion.HoverFade" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <Border x:Name="Fill" Background="Transparent" CornerRadius="6" />
                            <Border x:Name="PART_Hover" Background="{DynamicResource HoverBg}" Opacity="0"
                                    CornerRadius="6" IsHitTestVisible="False" />
                            <Border x:Name="Ring" BorderThickness="1" CornerRadius="6"
                                    BorderBrush="{DynamicResource FocusRing}" Opacity="0"
                                    IsHitTestVisible="False" />
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SelectionBg}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A 28 DIP ghost action inside a card header (Revoke). Destructive, so it
             takes the error text and never the accent. -->
        <Style x:Key="CardGhostAction" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <!-- The per-row Revoke: a 24 DIP err-outline button that is only live on a
             session that can still be revoked. -->
        <Style x:Key="RowRevoke" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: the mockup's eyebrow, page title and two-line description on the
             left; the session counts, reload and the single takeover action on the
             right. -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="AUTOMATION" Style="{StaticResource CardTitle}" />
                <TextBlock Text="Agent Sessions" Style="{StaticResource PageText}" Margin="0,2,0,0" />
                <StackPanel Margin="0,4,0,0">
                    <TextBlock Style="{StaticResource Body}" FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="Sessions are off by default; an agent cannot reach a guest until you pair it." />
                    <TextBlock Style="{StaticResource Body}" FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="Each pairing names the caller, device, scopes and expiry before anything runs." />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Style="{StaticResource Caption}"
                           Foreground="{DynamicResource TextTertiary}"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}"
                        Click="OnRefresh" Margin="0,0,8,0"
                        ToolTip="Reload sessions, pairings and recent operations"
                        AutomationProperties.Name="Refresh agent sessions">
                    <Path Data="{StaticResource IconRefresh}" Style="{StaticResource Glyph}" />
                </Button>
                <Button x:Name="TakeoverButton" Style="{StaticResource ToolButton}"
                        Height="34" Padding="12,0" Margin="0"
                        Background="Transparent"
                        BorderBrush="{DynamicResource DangerBorder}"
                        Foreground="{DynamicResource Danger}"
                        Click="OnTakeover"
                        ToolTip="Revoke every agent session on the selected guest and cancel new agent input"
                        AutomationProperties.Name="Take over selected agent guest">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconShield}" Style="{StaticResource Glyph}"
                              Width="14" Height="14" Margin="0,0,7,0" />
                        <TextBlock Text="Take over · revoke all" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Wide: the card beside the two tables. Stacked (1024 DIP and narrower):
             the card above them and the whole body scrolls, because the three
             panels need more height than a short window has. -->
        <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="BodyGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="280" />
                <ColumnDefinition x:Name="GapColumn" Width="16" />
                <ColumnDefinition x:Name="RightColumn" Width="*" MinWidth="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopRow" Height="*" />
                <RowDefinition x:Name="GapRow" Height="0" />
                <RowDefinition x:Name="BodyRow" Height="0" />
            </Grid.RowDefinitions>

            <!-- Approval card: the pairing requests, the template the approval
                 clones, the scopes it grants, and one accent primary. There is no
                 Deny action because the supervisor has no deny operation. -->
            <Border x:Name="PairingCard" Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Padding="14">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                        <Style.Triggers>
                            <!-- A real request waiting paints the card's edge in the
                                 accent, like the mockup's pending card. -->
                            <DataTrigger Binding="{Binding SelectedItem.IsPending, ElementName=PairingsGrid}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" CornerRadius="6" VerticalAlignment="Center"
                                Background="{DynamicResource PanelAlt}"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                            <Path Data="{StaticResource IconKey}" Style="{StaticResource Glyph}"
                                  Width="14" Height="14" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="Pairing request" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" FontSize="12"
                               Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Text="A local client asks to drive a lab guest. Select its request, then approve it against a stopped template." />

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Client" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}"
                                       Text="{Binding SelectedItem.Client, ElementName=PairingsGrid, TargetNullValue=—, FallbackValue=—}" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Template" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}"
                                       Text="{Binding SelectedItem.Template, ElementName=PairingsGrid, TargetNullValue=—, FallbackValue=—}" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Expires" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1"
                                       FontFamily="{StaticResource MonoFont}" FontWeight="Normal"
                                       Text="{Binding SelectedItem.Countdown, ElementName=PairingsGrid, TargetNullValue=—, FallbackValue=—}"
                                       ToolTip="{Binding SelectedItem.ExpiresText, ElementName=PairingsGrid}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FieldValue}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem.Expiring, ElementName=PairingsGrid}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock Text="Scopes" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <TextBox x:Name="ScopesBox" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                 Padding="7,4" MinHeight="44" Height="44" TextWrapping="Wrap"
                                 AcceptsReturn="False" VerticalScrollBarVisibility="Disabled"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Comma-separated scopes granted to the paired client."
                                 AutomationProperties.Name="Approval scopes" />

                        <TextBlock Text="Template" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                        <ComboBox x:Name="TemplateBox" Height="30"
                                  DisplayMemberPath="Display"
                                  AutomationProperties.Name="Approval template" />

                        <Button x:Name="ApproveButton" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch" Height="34" Margin="0,14,0,0"
                                Click="OnApprove" AutomationProperties.Name="Approve selected pairing">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconCheck}" Width="14" Height="14"
                                      Stretch="Uniform" Stroke="{DynamicResource AccentText}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="Approve" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource Caption}" FontSize="11"
                                   Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Text="Approval clones the stopped template and grants exactly these scopes." />
                    </StackPanel>

                    <!-- The request list fills whatever height is left between the
                         description and the approval form. With no request it is a
                         slim info line instead of an empty box. -->
                    <Grid Margin="0,10,0,0">
                        <ListBox x:Name="PairingsGrid"
                                 ItemContainerStyle="{StaticResource PairingRowItem}"
                                 SelectionMode="Single" MinHeight="88"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Agent pairing requests">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="44" AutomationProperties.Name="{Binding AccessibleName}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="6,0,6,0">
                                            <TextBlock Text="{Binding Client}" Style="{StaticResource RowText}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Pairing}" Style="{StaticResource RowMono}"
                                                       FontSize="10" Foreground="{DynamicResource TextTertiary}"
                                                       Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource ToneChip}"
                                                VerticalAlignment="Center" Margin="0,0,4,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource ToneDot}" />
                                                <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource ToneChipText}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border VerticalAlignment="Top" Margin="0,2,0,0" Padding="8,6"
                                Background="{DynamicResource PanelAlt}"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusInnerCard}"
                                Visibility="{Binding Items.Count, ElementName=PairingsGrid, Converter={StaticResource InverseCountVis}}">
                            <TextBlock Style="{StaticResource Caption}" FontSize="11"
                                       Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap"
                                       Text="No pairing requests · agents connect from the CLI" />
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <Grid x:Name="TableStack" Grid.Row="0" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.15*" MinHeight="210" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" MinHeight="170" />
                </Grid.RowDefinitions>

                <!-- Paired sessions: one card, a 30 DIP column header, 34 DIP rows. -->
                <Border Grid.Row="0" Style="{StaticResource Panel}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Height="42" Margin="14,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Paired sessions" Style="{StaticResource CardTitle}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="RevokeButton" Grid.Column="1" Style="{StaticResource CardGhostAction}"
                                    Click="OnRevoke"
                                    ToolTip="Revoke the selected session"
                                    AutomationProperties.Name="Revoke selected agent session">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconTrash}" Style="{StaticResource Glyph}"
                                          Width="12" Height="12" Margin="0,0,6,0" />
                                    <TextBlock Text="Revoke" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border DockPanel.Dock="Top" Height="30" Padding="14,0"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="0.95*" />
                                    <ColumnDefinition Width="0.75*" />
                                    <ColumnDefinition Width="1.6*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="0.85*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Session" Style="{StaticResource ColumnHead}" />
                                <TextBlock Grid.Column="1" Text="Client" Style="{StaticResource ColumnHead}" />
                                <TextBlock Grid.Column="2" Text="Guest" Style="{StaticResource ColumnHead}" />
                                <TextBlock Grid.Column="3" Text="Scopes" Style="{StaticResource ColumnHead}" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="4" Text="Expires" Style="{StaticResource ColumnHead}" />
                                <TextBlock Grid.Column="5" Text="State" Style="{StaticResource ColumnHead}" />
                            </Grid>
                        </Border>

                        <Grid>
                            <ListBox x:Name="SessionsGrid"
                                     ItemContainerStyle="{StaticResource AgentRowItem}"
                                     SelectionMode="Single"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Paired agent sessions">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="34" Margin="14,0" AutomationProperties.Name="{Binding AccessibleName}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="0.95*" />
                                                <ColumnDefinition Width="0.75*" />
                                                <ColumnDefinition Width="1.6*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="0.85*" />
                                                <ColumnDefinition Width="48" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Session}" Style="{StaticResource RowMono}"
                                                       ToolTip="{Binding Session}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Client}"
                                                       Style="{StaticResource RowText}" Margin="0,0,10,0"
                                                       ToolTip="{Binding Client}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Instance}"
                                                       Style="{StaticResource RowMono}" Margin="0,0,10,0"
                                                       ToolTip="{Binding Instance}" />
                                            <Grid Grid.Column="3" Margin="0,0,10,0" ClipToBounds="True">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                            ToolTip="{Binding ScopeTip}">
                                                    <ItemsControl ItemsSource="{Binding ScopeChips}" VerticalAlignment="Center">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource ScopeChip}">
                                                                    <TextBlock Text="{Binding}" Style="{StaticResource ScopeChipText}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Border Style="{StaticResource ScopeChip}"
                                                            Visibility="{Binding HiddenScopes, Converter={StaticResource CountVis}}"
                                                            ToolTip="{Binding ScopeTip}">
                                                        <TextBlock Text="{Binding HiddenScopeText}" Style="{StaticResource ScopeChipText}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Grid.Column="4" Text="{Binding Countdown}"
                                                       Margin="0,0,10,0"
                                                       ToolTip="{Binding ExpiresText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RowMono}">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tone}" Value="warn">
                                                                <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border Grid.Column="5" Style="{StaticResource ToneChip}"
                                                    HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Style="{StaticResource ToneDot}" />
                                                    <TextBlock Text="{Binding StateLabel}" Style="{StaticResource ToneChipText}" />
                                                </StackPanel>
                                            </Border>
                                            <Button Grid.Column="6" Style="{StaticResource RowRevoke}"
                                                    Content="Revoke"
                                                    IsEnabled="{Binding CanRevoke}"
                                                    ToolTip="{Binding RevokeTip}"
                                                    Click="OnRevoke"
                                                    AutomationProperties.Name="Revoke this agent session" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel x:Name="SessionsEmpty" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Margin="0,0,0,12"
                                        Visibility="{Binding Items.Count, ElementName=SessionsGrid, Converter={StaticResource InverseCountVis}}">
                                <Path Data="{StaticResource IconAgents}" Width="20" Height="20"
                                      Stretch="Uniform" StrokeThickness="1.5"
                                      Stroke="{DynamicResource TextTertiary}" Opacity="0.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="No paired sessions" FontSize="12" Margin="0,8,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="A client that completes a pairing appears here with its scopes and expiry."
                                           FontSize="11" Margin="0,2,0,0" MaxWidth="360"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextTertiary}" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Recent agent operations: newest first, one chip per outcome. -->
                <Border Grid.Row="2" Style="{StaticResource Panel}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Height="42" Margin="14,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Recent agent operations" Style="{StaticResource CardTitle}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Newest first · last 25" Style="{StaticResource Caption}"
                                       FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Border DockPanel.Dock="Top" Height="30" Padding="14,0"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.45*" />
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Time" Style="{StaticResource ColumnHead}" />
                                <TextBlock Grid.Column="1" Text="Caller" Style="{StaticResource ColumnHead}" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="2" Text="Operation" Style="{StaticResource ColumnHead}" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="3" Text="Outcome" Style="{StaticResource ColumnHead}" />
                                <TextBlock Grid.Column="4" Text="ms" Style="{StaticResource ColumnHead}"
                                           TextAlignment="Right" />
                            </Grid>
                        </Border>

                        <Grid>
                            <ListBox x:Name="OperationsGrid"
                                     ItemContainerStyle="{StaticResource AgentRowItem}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Recent agent operations">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="30" Margin="14,0" AutomationProperties.Name="{Binding AccessibleName}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="88" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="1.45*" />
                                                <ColumnDefinition Width="230" />
                                                <ColumnDefinition Width="52" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Style="{StaticResource RowMono}"
                                                       Foreground="{DynamicResource TextTertiary}" />
                                            <TextBlock Grid.Column="1" Text="{Binding CallerLabel}"
                                                       Style="{StaticResource RowText}" Margin="0,0,10,0"
                                                       ToolTip="{Binding Caller}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Operation}"
                                                       Style="{StaticResource RowMono}" Margin="0,0,10,0"
                                                       ToolTip="{Binding Operation}" />
                                            <Border Grid.Column="3" Style="{StaticResource ToneChip}"
                                                    HorizontalAlignment="Left" MaxWidth="220"
                                                    ToolTip="{Binding Code}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Style="{StaticResource ToneDot}" />
                                                    <TextBlock Text="{Binding OutcomeChipText}"
                                                               Style="{StaticResource ToneChipText}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Grid.Column="4" Text="{Binding Duration}"
                                                       Style="{StaticResource RowMono}" TextAlignment="Right"
                                                       Foreground="{DynamicResource TextTertiary}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel x:Name="OperationsEmpty" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Margin="0,0,0,12"
                                        Visibility="{Binding Items.Count, ElementName=OperationsGrid, Converter={StaticResource InverseCountVis}}">
                                <Path Data="{StaticResource IconLogs}" Width="20" Height="20"
                                      Stretch="Uniform" StrokeThickness="1.5"
                                      Stroke="{DynamicResource TextTertiary}" Opacity="0.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="No agent operations yet" FontSize="12" Margin="0,8,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="Every operation an agent runs against a lab guest is recorded here."
                                           FontSize="11" Margin="0,2,0,0" MaxWidth="360"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextTertiary}" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
        </ScrollViewer>
    </Grid>
</Window>
