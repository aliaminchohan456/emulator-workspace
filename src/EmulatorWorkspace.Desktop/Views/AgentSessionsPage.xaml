<UserControl x:Class="EmulatorWorkspace.Desktop.Views.AgentSessionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:EmulatorWorkspace.Desktop.Views"
             x:Name="Page"
             Background="{DynamicResource WindowBg}"
             AutomationProperties.Name="Agent sessions page">

    <!-- UX-13: the former Agent Sessions window, re-hosted as a shell page. The
         collections, the supervisor calls and every handler are the UX-09 ones;
         only the chrome moved. The shell draws the rail, title bar, command bar
         and status bar around this control. Layout is mockup 08: a 320 DIP
         pairing card beside the two tables, stacked above them below 1180 DIP. -->
    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVis" />
        <views:CountToVisibilityConverter x:Key="CountVis" />
        <views:CountToVisibilityConverter x:Key="InverseCountVis" Invert="True" />
        <views:TextToVisibilityConverter x:Key="TextToVis" />
        <views:NullToVisibilityConverter x:Key="NullToVis" />

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The caps section headers the design sheet tracks (PAIRED SESSIONS). -->
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="views:Caps.Tracking" Value="True" />
        </Style>

        <!-- Column header of a table: 11 DIP text3, title case like the mockup. -->
        <Style x:Key="ColumnHead" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="RowText" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="RowMono" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <!-- A soft state chip. The tone word comes from the row (Tone), and every
             trigger sets both the tint and the label colour through
             DynamicResource brushes, so a live theme swap repaints the chip. The
             word is always printed next to the dot: colour never carries state. -->
        <Style x:Key="ToneChip" TargetType="Border" BasedOn="{StaticResource StatePill}">
            <Setter Property="Padding" Value="7,2,9,2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="ok">
                    <Setter Property="Background" Value="{DynamicResource SuccessBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warn">
                    <Setter Property="Background" Value="{DynamicResource WarningBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="err">
                    <Setter Property="Background" Value="{DynamicResource DangerBg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToneChipText" TargetType="TextBlock" BasedOn="{StaticResource StatePillText}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="10.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="ok">
                    <Setter Property="Foreground" Value="{DynamicResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warn">
                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="err">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToneDot" TargetType="Ellipse" BasedOn="{StaticResource StatePillDot}">
            <Setter Property="Width" Value="5" />
            <Setter Property="Height" Value="5" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Fill" Value="{DynamicResource TextTertiary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="ok">
                    <Setter Property="Fill" Value="{DynamicResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warn">
                    <Setter Property="Fill" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="err">
                    <Setter Property="Fill" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A granted scope: mono 10 on the raised chip tint, one per grant. -->
        <Style x:Key="ScopeChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ChipBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="ScopeChipText" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="LineHeight" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- One table row: hover through the shared 120 ms fade, selection in the
             shared tint. The mockup keeps the tables quiet, so there is no zebra
             striping and no grid line between rows, only the card's own edges.
             EV-02: the container itself carries the human name UI Automation
             reads, because a ListBoxItem without one reports its item type
             ("AgentSessionsPage+SessionRow") to a screen reader. Extending this
             style leaves the hover, selection and template untouched. -->
        <Style x:Key="AgentRowItem" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="views:Motion.HoverFade" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <Border x:Name="Fill" Background="Transparent" CornerRadius="6" Margin="8,1" />
                            <Border x:Name="PART_Hover" Background="{DynamicResource HoverBg}" Opacity="0"
                                    CornerRadius="6" Margin="8,1" IsHitTestVisible="False" />
                            <Border x:Name="Ring" BorderThickness="1" CornerRadius="6" Margin="8,1"
                                    BorderBrush="{DynamicResource FocusRing}" Opacity="0"
                                    IsHitTestVisible="False" />
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SelectionBg}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A pairing request row in the approval card: client plus the request id
             on two lines, with the status chip on the right. EV-02: the container
             name is the row's human name, for the same reason as AgentRowItem. -->
        <Style x:Key="PairingRowItem" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="views:Motion.HoverFade" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <!-- UX-15: the hover/selection layers cover the 44 DIP
                                 row only, never the "Past" rule above it. -->
                            <Border x:Name="Fill" Background="Transparent" CornerRadius="6"
                                    Height="44" VerticalAlignment="Bottom" />
                            <Border x:Name="PART_Hover" Background="{DynamicResource HoverBg}" Opacity="0"
                                    CornerRadius="6" Height="44" VerticalAlignment="Bottom" IsHitTestVisible="False" />
                            <Border x:Name="Ring" BorderThickness="1" CornerRadius="6"
                                    BorderBrush="{DynamicResource FocusRing}" Opacity="0"
                                    Height="44" VerticalAlignment="Bottom"
                                    IsHitTestVisible="False" />
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SelectionBg}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- UX-15 item 5: the per-row Revoke is a ghost text button in text2
             that takes the err colour on hover and keyboard focus. It stays only
             live on a session that can still be revoked; the confirm flow in
             OnRevoke is unchanged. -->
        <Style x:Key="RowRevoke" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The empty state of one card: icon, one title, one caption, centred
             with a 120 DIP floor so an empty card still reads as a surface. -->
        <Style x:Key="EmptyState" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="120" />
            <Setter Property="Margin" Value="12,8" />
        </Style>

        <Style x:Key="EmptyIcon" TargetType="Path">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Stroke" Value="{DynamicResource TextTertiary}" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="EmptyTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style x:Key="EmptyCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="MaxWidth" Value="360" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header: the mockup's AUTOMATION eyebrow, the title and the
             one-line caption on the left, the real counts at the right. UX-15
             item 9: the counts sit in the caption's own row, so they share its
             baseline instead of hanging off the title. -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="AUTOMATION" Style="{StaticResource CardTitle}" />
            <TextBlock Grid.Row="1" Text="Agent Sessions" Style="{StaticResource PageText}" Margin="0,2,0,0" />

            <Grid Grid.Row="2" Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource Body}" FontSize="13"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}"
                           TextTrimming="CharacterEllipsis"
                           Text="Local clients bound to disposable lab guests. Off by default; each pairing names the caller, device, scopes and expiry." />

                <TextBlock Grid.Column="1" Text="{Binding SummaryText, ElementName=Page}"
                           Style="{StaticResource Body}" FontSize="13"
                           Typography.NumeralAlignment="Tabular"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="Session counts" />
            </Grid>
        </Grid>

        <!-- Refresh failure: err-soft band with one sentence and a Retry, the
             same surface the shell uses for its own typed errors. -->
        <Border Grid.Row="1" Margin="0,0,0,12" Padding="10,6"
                Background="{DynamicResource DangerBg}"
                BorderBrush="{DynamicResource DangerBorder}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusControl}"
                Visibility="{Binding HasError, ElementName=Page, Converter={StaticResource BoolToVis}}"
                AutomationProperties.Name="Agent sessions error">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Retry" Style="{StaticResource ToolButton}"
                        Height="26" MinHeight="26" Padding="10,0" Margin="10,0,0,0" FontSize="12"
                        VerticalAlignment="Center" Click="OnRetry"
                        ToolTip="Read sessions, pairings and recent operations again"
                        AutomationProperties.Name="Retry loading agent sessions" />
                <Path DockPanel.Dock="Left" Data="{StaticResource IconWarning}" Width="14" Height="14"
                      Stretch="Uniform" Stroke="{DynamicResource Danger}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding ErrorText, ElementName=Page}" Style="{StaticResource Caption}"
                           FontSize="12" Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ErrorText, ElementName=Page}" />
            </DockPanel>
        </Border>

        <!-- Wide: the 320 DIP card beside the two tables. Stacked (below 1180
             DIP): the card above them and the whole body scrolls, because the
             three panels need more height than a short window has. UX-15 item 8:
             at wide the body itself does not scroll; the left column owns a
             scroll viewer that shows a bar only when the card is taller than the
             window. -->
        <ScrollViewer x:Name="BodyScroll" Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="BodyGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftColumn" Width="320" />
                    <ColumnDefinition x:Name="GapColumn" Width="12" />
                    <ColumnDefinition x:Name="RightColumn" Width="*" MinWidth="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TopRow" Height="Auto" />
                    <RowDefinition x:Name="GapRow" Height="0" />
                    <RowDefinition x:Name="BodyRow" Height="0" />
                </Grid.RowDefinitions>

                <!-- Approval card: the pairing requests, the template the approval
                     clones, the scopes it grants, and one accent primary. There is
                     no Deny action because the supervisor has no deny operation.
                     UX-15 item 8: content-sized with 16 DIP under the caption. -->
                <ScrollViewer x:Name="LeftScroll" Grid.Row="0" Grid.Column="0"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <Border x:Name="PairingCard" Padding="14,14,14,16"
                        VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                            <Style.Triggers>
                                <!-- A real request waiting paints the card's edge in
                                     the accent, like the mockup's pending card. -->
                                <DataTrigger Binding="{Binding SelectedItem.IsPending, ElementName=PairingsGrid}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="6" VerticalAlignment="Center"
                                    Background="{DynamicResource PanelAlt}"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                <Path Data="{StaticResource IconKey}" Width="14" Height="14"
                                      Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Stretch="None" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Pairing request" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>

                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" FontSize="12"
                                   Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding Items.Count, ElementName=PairingsGrid, Converter={StaticResource CountVis}}"
                                   Text="A local client asks to drive a lab guest. Select its request, then approve it against a stopped template." />

                        <!-- The request list sits directly under the description and
                             caps at three 44 DIP rows with its own scroll, so the
                             Client/Template/Scopes detail follows it without a dead
                             gap. With no request the card shows the shared empty
                             state instead of an empty box. -->
                        <Grid DockPanel.Dock="Top" Margin="0,8,0,0"
                              Visibility="{Binding Items.Count, ElementName=PairingsGrid, Converter={StaticResource CountVis}}">
                            <ListBox x:Name="PairingsGrid"
                                     ItemContainerStyle="{StaticResource PairingRowItem}"
                                     SelectionMode="Single" MaxHeight="164"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Agent pairing requests">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- UX-15 item 1: answered requests sit under a
                                             thin "Past" rule, dimmed to 85 %. The strip
                                             exists only above the first past request. -->
                                        <Grid AutomationProperties.Name="{Binding AccessibleName}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal"
                                                        Margin="6,8,6,6"
                                                        Visibility="{Binding IsFirstPast, Converter={StaticResource BoolToVis}}">
                                                <Border Width="12" Height="1" VerticalAlignment="Center"
                                                        Background="{DynamicResource BorderSubtle}" />
                                                <TextBlock Text="Past" Style="{StaticResource Caption}"
                                                           FontSize="10" Margin="6,0,0,0"
                                                           Foreground="{DynamicResource TextTertiary}" />
                                                <Border Height="1" Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource BorderSubtle}"
                                                        HorizontalAlignment="Stretch" />
                                            </StackPanel>
                                            <Grid Grid.Row="1" Height="44" Opacity="{Binding RowOpacity}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="6,0,6,0">
                                                    <TextBlock Text="{Binding Client}" Style="{StaticResource RowText}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Pairing}" Style="{StaticResource RowMono}"
                                                               FontSize="10" Foreground="{DynamicResource TextTertiary}"
                                                               Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Style="{StaticResource ToneChip}"
                                                        VerticalAlignment="Center" Margin="0,0,4,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Style="{StaticResource ToneDot}" />
                                                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource ToneChipText}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <StackPanel x:Name="PairingsEmpty" DockPanel.Dock="Top"
                                    Style="{StaticResource EmptyState}"
                                    Visibility="{Binding Items.Count, ElementName=PairingsGrid, Converter={StaticResource InverseCountVis}}">
                            <Path Data="{StaticResource IconKey}" Style="{StaticResource EmptyIcon}" />
                            <TextBlock Text="No pairing requests" Style="{StaticResource EmptyTitle}" />
                            <TextBlock Text="An agent connects from the CLI; its request appears here for approval."
                                       Style="{StaticResource EmptyCaption}" />
                        </StackPanel>

                        <StackPanel x:Name="ApprovalDetail" DockPanel.Dock="Top" Margin="0,8,0,0"
                                    Visibility="{Binding SelectedItem, ElementName=PairingsGrid, Converter={StaticResource NullToVis}}">
                            <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Client" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}"
                                           Text="{Binding SelectedItem.Client, ElementName=PairingsGrid, TargetNullValue=—, FallbackValue=—}" />
                            </Grid>
                            <!-- UX-15 item 2: the request carries no template of its
                                 own (the field read empty), so the row prints the
                                 real guest the approval will clone - the same
                                 selection the dropdown below holds - and disappears
                                 when no template is selected at all. -->
                            <Grid Margin="0,0,0,6"
                                  Visibility="{Binding SelectedItem, ElementName=TemplateBox, Converter={StaticResource NullToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Template" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}"
                                           Text="{Binding SelectedItem.Name, ElementName=TemplateBox, TargetNullValue=—, FallbackValue=—}"
                                           ToolTip="{Binding SelectedItem.Display, ElementName=TemplateBox}" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Expires" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedItem.Countdown, ElementName=PairingsGrid, TargetNullValue=—, FallbackValue=—}"
                                           ToolTip="{Binding SelectedItem.ExpiresText, ElementName=PairingsGrid}">
                                    <TextBlock.Style>
                                        <!-- UX-15 item 2: a human countdown is a UI value,
                                             not an identifier, so it sets in the UI face
                                             with tabular figures and turns warn inside the
                                             last minute. -->
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FieldValue}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem.Expiring, ElementName=PairingsGrid}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <TextBlock Text="Scopes" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                            <!-- UX-15 item 3: one line tall when the grant is one
                                 scope, growing to four wrapped lines and then
                                 scrolling, with 12 DIP sides and 8 DIP top and
                                 bottom - no fixed 64 DIP box with dead space. -->
                            <TextBox x:Name="ScopesBox" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                     Padding="12,8" MinHeight="30" MaxHeight="78" TextWrapping="Wrap"
                                     AcceptsReturn="False" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Comma-separated scopes granted to the paired client."
                                     AutomationProperties.Name="Approval scopes" />

                            <TextBlock Text="Approve against" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                            <ComboBox x:Name="TemplateBox" Height="30"
                                      DisplayMemberPath="Display"
                                      AutomationProperties.Name="Approval template" />

                            <!-- UX-15 item 4: at 1024 the card spans the page, so the
                                 primary does not stretch across it - the caption keeps
                                 the left and the button sits right at content width (136
                                 minimum). Wide (320 DIP card) keeps the full-width
                                 primary with the caption beneath it. ApplyLayout moves
                                 the two children; the XAML here is the wide shape. -->
                            <Grid x:Name="ApproveRow" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                            <Button x:Name="ApproveButton" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                    HorizontalAlignment="Stretch" Height="34" Margin="0"
                                    Click="OnApprove" AutomationProperties.Name="Approve selected pairing">
                                <!-- Only a pending request can be approved: the
                                     supervisor rejects any other status, so the
                                     button is live only while the selected row is
                                     pending (UX-11's no-live-empty-Approve rule,
                                     extended to completed/expired rows). -->
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="ToolTip"
                                                Value="Approval clones the stopped template and grants exactly these scopes" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem.IsPending, ElementName=PairingsGrid}"
                                                         Value="False">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="ToolTip"
                                                        Value="Only a pending request can be approved; this request is already answered" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=PairingsGrid}"
                                                         Value="{x:Null}">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="ToolTip"
                                                        Value="Select a pending pairing request first" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconCheck}" Width="14" Height="14"
                                          Stretch="Uniform" Stroke="{DynamicResource AccentText}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="Approve" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="ApproveCaption" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       Style="{StaticResource Caption}" FontSize="11"
                                       Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Text="Approval clones the stopped template and grants exactly these scopes." />
                            </Grid>
                        </StackPanel>
                    </DockPanel>
                </Border>
                </ScrollViewer>

                <ScrollViewer x:Name="RightScroll" Grid.Row="0" Grid.Column="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <Grid x:Name="TableStack">
                    <Grid.RowDefinitions>
                        <!-- Both cards size to their content and keep a 120 DIP
                             floor for the empty state; the page body scrolls when
                             the pair together is taller than the window. -->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Paired sessions: one card, a 30 DIP column header, 34 DIP rows. -->
                    <Border Grid.Row="0" Style="{StaticResource Panel}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Height="42" Margin="14,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Paired sessions" Style="{StaticResource CardTitle}"
                                           VerticalAlignment="Center" />
                                <!-- The header Revoke is gone (igr-feedback-ux10 item 4):
                                     it duplicated the per-row action and could point at
                                     nothing. Every row carries its own Revoke. -->
                            </Grid>

                            <Border DockPanel.Dock="Top" Height="30" Padding="14,0"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="0.95*" />
                                        <ColumnDefinition Width="0.75*" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="0.85*" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Session" Style="{StaticResource ColumnHead}" />
                                    <TextBlock Grid.Column="1" Text="Client" Style="{StaticResource ColumnHead}" />
                                    <TextBlock Grid.Column="2" Text="Guest" Style="{StaticResource ColumnHead}" />
                                    <TextBlock Grid.Column="3" Text="Scopes" Style="{StaticResource ColumnHead}" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="4" Text="Expires" Style="{StaticResource ColumnHead}" />
                                    <TextBlock Grid.Column="5" Text="State" Style="{StaticResource ColumnHead}" />
                                </Grid>
                            </Border>

                            <Grid MinHeight="120">
                                <ListBox x:Name="SessionsGrid"
                                         ItemContainerStyle="{StaticResource AgentRowItem}"
                                         SelectionMode="Single" MaxHeight="260"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Paired agent sessions">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="34" Margin="14,0" AutomationProperties.Name="{Binding AccessibleName}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="0.95*" />
                                                    <ColumnDefinition Width="0.75*" />
                                                    <ColumnDefinition Width="1.6*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="0.85*" />
                                                    <ColumnDefinition Width="64" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Session}" Style="{StaticResource RowMono}"
                                                           ToolTip="{Binding Session}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Client}"
                                                           Style="{StaticResource RowText}" Margin="0,0,10,0"
                                                           ToolTip="{Binding Client}" />
                                                <!-- UX-15 item 6: the supervisor names the
                                                     guest, not a friendly alias, so the raw
                                                     id is what the column prints, in mono
                                                     text3. If a reported display name ever
                                                     arrives it takes the UI face and the id
                                                     stays beneath it. -->
                                                <Grid Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center"
                                                      ToolTip="{Binding GuestTip}">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding GuestName}"
                                                                   Style="{StaticResource RowText}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding HasGuestName, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding GuestId}" Style="{StaticResource RowMono}"
                                                                   FontSize="10.5" Foreground="{DynamicResource TextTertiary}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Grid.Column="3" Margin="0,0,10,0" ClipToBounds="True">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                ToolTip="{Binding ScopeTip}">
                                                        <ItemsControl ItemsSource="{Binding ScopeChips}" VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Style="{StaticResource ScopeChip}">
                                                                        <TextBlock Text="{Binding}" Style="{StaticResource ScopeChipText}" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Border Style="{StaticResource ScopeChip}"
                                                                Visibility="{Binding HiddenScopes, Converter={StaticResource CountVis}}"
                                                                ToolTip="{Binding ScopeTip}">
                                                            <TextBlock Text="{Binding HiddenScopeText}" Style="{StaticResource ScopeChipText}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Grid.Column="4" Text="{Binding Countdown}"
                                                           Margin="0,0,10,0"
                                                           ToolTip="{Binding ExpiresText}">
                                                    <TextBlock.Style>
                                                        <!-- UX-15 item 2: a countdown is a human
                                                             value, so it sets in the UI face with
                                                             tabular figures, and turns warn in the
                                                             last minute. -->
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource RowText}">
                                                            <Setter Property="FontSize" Value="12" />
                                                            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tone}" Value="warn">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Border Grid.Column="5" Style="{StaticResource ToneChip}"
                                                        HorizontalAlignment="Left">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Style="{StaticResource ToneDot}" />
                                                        <TextBlock Text="{Binding StateLabel}" Style="{StaticResource ToneChipText}" />
                                                    </StackPanel>
                                                </Border>
                                                <Button Grid.Column="6" Style="{StaticResource RowRevoke}"
                                                        Content="Revoke"
                                                        IsEnabled="{Binding CanRevoke}"
                                                        ToolTip="{Binding RevokeTip}"
                                                        Click="OnRevoke"
                                                        AutomationProperties.Name="Revoke this agent session" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel x:Name="SessionsEmpty" Style="{StaticResource EmptyState}"
                                            Visibility="{Binding Items.Count, ElementName=SessionsGrid, Converter={StaticResource InverseCountVis}}">
                                    <Path Data="{StaticResource IconAgents}" Style="{StaticResource EmptyIcon}" />
                                    <TextBlock Text="No paired sessions" Style="{StaticResource EmptyTitle}" />
                                    <TextBlock Text="A client that completes a pairing appears here with its scopes and expiry."
                                               Style="{StaticResource EmptyCaption}" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Recent agent operations: newest first, one chip per outcome. -->
                    <Border Grid.Row="2" Style="{StaticResource Panel}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Height="42" Margin="14,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Recent agent operations" Style="{StaticResource CardTitle}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Newest first · last 25" Style="{StaticResource Caption}"
                                           FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Border DockPanel.Dock="Top" Height="30" Padding="14,0"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.45*" />
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Time" Style="{StaticResource ColumnHead}" />
                                    <TextBlock Grid.Column="1" Text="Caller" Style="{StaticResource ColumnHead}" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="2" Text="Operation" Style="{StaticResource ColumnHead}" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="3" Text="Outcome" Style="{StaticResource ColumnHead}" />
                                    <TextBlock Grid.Column="4" Text="ms" Style="{StaticResource ColumnHead}"
                                               Typography.NumeralAlignment="Tabular"
                                               TextAlignment="Right" />
                                </Grid>
                            </Border>

                            <Grid MinHeight="120">
                                <ListBox x:Name="OperationsGrid"
                                         ItemContainerStyle="{StaticResource AgentRowItem}"
                                         MaxHeight="360"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Recent agent operations">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="30" Margin="14,0" AutomationProperties.Name="{Binding AccessibleName}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="88" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="1.45*" />
                                                    <ColumnDefinition Width="230" />
                                                    <ColumnDefinition Width="52" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Time}" Style="{StaticResource RowMono}"
                                                           Foreground="{DynamicResource TextTertiary}" />
                                                <TextBlock Grid.Column="1" Text="{Binding CallerLabel}"
                                                           Style="{StaticResource RowText}" Margin="0,0,10,0"
                                                           ToolTip="{Binding Caller}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Operation}"
                                                           Style="{StaticResource RowMono}" Margin="0,0,10,0"
                                                           ToolTip="{Binding Operation}" />
                                                <!-- UX-15 item 7: the outcome chip hugs its
                                                     words instead of filling the column; the
                                                     column width is the cap, not the size. -->
                                                <Border Grid.Column="3" Style="{StaticResource ToneChip}"
                                                        HorizontalAlignment="Left" MaxWidth="220"
                                                        Margin="0,0,10,0"
                                                        ToolTip="{Binding Code}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Style="{StaticResource ToneDot}" />
                                                        <TextBlock Text="{Binding OutcomeChipText}"
                                                                   Style="{StaticResource ToneChipText}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Grid.Column="4" Text="{Binding Duration}"
                                                           Style="{StaticResource RowText}" FontSize="12"
                                                           Typography.NumeralAlignment="Tabular"
                                                           TextAlignment="Right"
                                                           Foreground="{DynamicResource TextTertiary}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel x:Name="OperationsEmpty" Style="{StaticResource EmptyState}"
                                            Visibility="{Binding Items.Count, ElementName=OperationsGrid, Converter={StaticResource InverseCountVis}}">
                                    <Path Data="{StaticResource IconLogs}" Style="{StaticResource EmptyIcon}" />
                                    <TextBlock Text="No agent operations yet" Style="{StaticResource EmptyTitle}" />
                                    <TextBlock Text="Every operation an agent runs against a lab guest is recorded here."
                                               Style="{StaticResource EmptyCaption}" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
                </ScrollViewer>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
