<Window x:Class="EmulatorWorkspace.Desktop.ConsentDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EmulatorWorkspace.Desktop.Views"
        Title="Privileged action"
        Width="720" Height="760"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="Manual" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- UX-09: the privileged consent surface, restyled from the OS MessageBox to
         shots/06-magisk-consent-dialog.png and shared by every consequential root
         action. It is a 50 % scrim plus one 560 DIP floating dialog inside a
         borderless window sized to the owner's client area, so the dim lands on
         the studio exactly like the command palette. Every fact it prints comes
         from the caller's model; the decision is the same bool the MessageBox
         returned, and Cancel returns before the caller's first supervisor
         request, so no transaction or journal entry is created. -->
    <Window.Resources>
        <views:CountToVisibilityConverter x:Key="CountVis" />
        <views:TextToVisibilityConverter x:Key="TextToVis" />
        <views:BoolToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="views:Caps.Tracking" Value="True" />
        </Style>

        <!-- The confirm action of a destructive dialog: a SOLID error fill with
             its on-error label (igr-feedback-ux10 item 7), the way the sheet draws
             a live destructive primary. While the gates are unmet it falls back to
             the err-soft surface at half weight with muted text, so a disabled
             confirm never reads as a live red button. -->
        <Style x:Key="DangerPrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="{DynamicResource Danger}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
            <Setter Property="Foreground" Value="{DynamicResource OnDanger}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="B"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusControl}" />
                            <Border x:Name="PART_Hover" Background="{DynamicResource OnDanger}"
                                    CornerRadius="{StaticResource RadiusControl}" Opacity="0"
                                    IsHitTestVisible="False" />
                            <Border x:Name="PART_Press" Background="{DynamicResource OnDanger}"
                                    CornerRadius="{StaticResource RadiusControl}" Opacity="0"
                                    IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Hover" Property="Opacity" Value="0.12" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PART_Press" Property="Opacity" Value="0.2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource DangerBg}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource DangerBorder}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- One artifact row: role, file name, its sha256 and the check that the
             digest was read from that file. -->
        <Style x:Key="ArtifactRow" TargetType="Border">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="ScrimLayer" Background="{DynamicResource DialogScrimBg}"
                Opacity="0" MouseLeftButtonDown="OnScrimClick"
                AutomationProperties.Name="Consent scrim" />

        <Grid x:Name="DialogHost" HorizontalAlignment="Center" VerticalAlignment="Center">
            <views:FloatingSurface x:Name="Card" Style="{StaticResource FloatingDialog}"
                                   Width="560" Padding="0" Opacity="0"
                                   Background="{DynamicResource PanelBg}"
                                   RenderTransformOrigin="0.5,0.5">
                <views:FloatingSurface.RenderTransform>
                    <ScaleTransform x:Name="CardScale" ScaleX="0.98" ScaleY="0.98" />
                </views:FloatingSurface.RenderTransform>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header: the 40 DIP privileged tile (err by default, warn for
                         ADB root, accent for recovery), the question and the one
                         sentence that says what changes. -->
                    <Grid Grid.Row="0" Margin="20,18,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="10" VerticalAlignment="Top"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource DangerBg}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TileTone}" Value="warn">
                                            <Setter Property="Background" Value="{DynamicResource WarningBg}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBorder}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TileTone}" Value="accent">
                                            <Setter Property="Background" Value="{DynamicResource AccentSoftBg}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" HorizontalAlignment="Center"
                                  VerticalAlignment="Center" Data="{StaticResource IconShield}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Stroke" Value="{DynamicResource Danger}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TileTone}" Value="warn">
                                                <Setter Property="Stroke" Value="{DynamicResource Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TileTone}" Value="accent">
                                                <Setter Property="Stroke" Value="{DynamicResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                       LineHeight="22" Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="12"
                                       Margin="0,3,0,0" Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                        <StackPanel Margin="20,0,20,2">

                            <!-- The exact target: the managed instance, its ADB
                                 transport, the ABI and image it reports, with the
                                 supervisor's own state word. -->
                            <Border Background="{DynamicResource PanelAlt}"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusInnerCard}" Padding="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="6" VerticalAlignment="Center"
                                            Background="{DynamicResource AccentSoftBg}"
                                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                        <Path Data="{StaticResource IconDevice}" Width="14" Height="14"
                                              Stretch="Uniform" Stroke="{DynamicResource Accent}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GuestName}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding GuestMeta}" Style="{StaticResource Mono}"
                                                   FontSize="10.5" Foreground="{DynamicResource TextTertiary}"
                                                   Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding GuestMetaTooltip}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource StatePill}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StateTone}" Value="ok">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBg}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StateTone}" Value="warn">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBg}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse>
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse" BasedOn="{StaticResource StatePillDot}">
                                                        <Setter Property="Fill" Value="{DynamicResource TextTertiary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StateTone}" Value="ok">
                                                                <Setter Property="Fill" Value="{DynamicResource Success}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StateTone}" Value="warn">
                                                                <Setter Property="Fill" Value="{DynamicResource Warning}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding StateLabel}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StatePillText}">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StateTone}" Value="ok">
                                                                <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StateTone}" Value="warn">
                                                                <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- The artifacts the caller selected. The hash is read
                                 from the file itself; it is the only value here
                                 that the supervisor's record does not carry. -->
                            <StackPanel Visibility="{Binding Artifacts.Count, Converter={StaticResource CountVis}}">
                                <TextBlock Text="Artifacts" Style="{StaticResource SectionLabel}" Margin="0,12,0,5" />
                                <Border Background="{DynamicResource PanelAlt}"
                                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusInnerCard}">
                                    <ItemsControl ItemsSource="{Binding Artifacts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ArtifactRow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Path Data="{StaticResource IconPackage}" Width="14" Height="14"
                                                              Stretch="Uniform" Stroke="{DynamicResource TextTertiary}"
                                                              StrokeThickness="1.5" StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                              VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Role}"
                                                                   Style="{StaticResource Caption}" FontSize="11"
                                                                   VerticalAlignment="Center" MinWidth="82"
                                                                   Foreground="{DynamicResource TextTertiary}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding FileName}"
                                                                   Style="{StaticResource Mono}" FontSize="11"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Path}" Margin="0,0,10,0" />
                                                        <TextBlock Grid.Column="3" Text="{Binding HashText}"
                                                                   Style="{StaticResource Mono}" FontSize="10"
                                                                   Foreground="{DynamicResource TextTertiary}"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                                   ToolTip="{Binding HashTip}" />
                                                        <Path Grid.Column="4" Data="{StaticResource IconCheck}"
                                                              Width="13" Height="13" Stretch="Uniform"
                                                              Stroke="{DynamicResource Success}" StrokeThickness="1.7"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round" VerticalAlignment="Center"
                                                              ToolTip="{Binding HashTip}"
                                                              AutomationProperties.Name="The digest was read from this file" />
                                                        <!-- igr-feedback-ux10 item 8: a small copy action per
                                                             artifact. It stays visible (a keyboard user can
                                                             reach it) and brightens on hover. -->
                                                        <Button Grid.Column="5" Width="20" Height="20" Margin="6,0,0,0"
                                                                Tag="{Binding Hash}" Click="OnCopyArtifactHash"
                                                                ToolTip="{Binding HashTip}"
                                                                AutomationProperties.Name="Copy this file's sha256">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Focusable" Value="True" />
                                                                    <Setter Property="Cursor" Value="Hand" />
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="Chip" Background="Transparent"
                                                                                        CornerRadius="4">
                                                                                    <Path Data="{StaticResource IconCopy}"
                                                                                          Width="12" Height="12" Stretch="Uniform"
                                                                                          Stroke="{DynamicResource TextTertiary}"
                                                                                          StrokeThickness="1.4"
                                                                                          HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center" />
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="Chip" Property="Background"
                                                                                                Value="{DynamicResource HoverBg}" />
                                                                                    </Trigger>
                                                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                        <Setter TargetName="Chip" Property="Background"
                                                                                                Value="{DynamicResource HoverBg}" />
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>

                            <!-- What the action does, in the action's own terms. -->
                            <TextBlock Text="What this does" Style="{StaticResource SectionLabel}" Margin="0,12,0,6" />
                            <ItemsControl ItemsSource="{Binding Consequences}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" VerticalAlignment="Top" Margin="0,1,9,0">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Data" Value="{StaticResource IconInfo}" />
                                                        <Setter Property="Stroke" Value="{DynamicResource TextTertiary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tone}" Value="warn">
                                                                <Setter Property="Data" Value="{StaticResource IconWarning}" />
                                                                <Setter Property="Stroke" Value="{DynamicResource Warning}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tone}" Value="ok">
                                                                <Setter Property="Data" Value="{StaticResource IconCheck}" />
                                                                <Setter Property="Stroke" Value="{DynamicResource Success}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tone}" Value="err">
                                                                <Setter Property="Data" Value="{StaticResource IconClose}" />
                                                                <Setter Property="Stroke" Value="{DynamicResource Danger}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12" LineHeight="16"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- The consent gates sit below the scrolling facts, so they are
                         always on screen: acknowledge the change, and - for the
                         actions that need it - type the exact target. -->
                    <StackPanel Grid.Row="2" Margin="20,10,20,0">
                        <Border Background="{DynamicResource DangerBg}"
                                BorderBrush="{DynamicResource DangerBorder}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusInnerCard}" Padding="10,7">
                            <CheckBox x:Name="AckBox" Foreground="{DynamicResource TextPrimary}"
                                      AutomationProperties.Name="Acknowledge the change to this guest">
                                <TextBlock Text="{Binding AcknowledgeText}"
                                           Style="{StaticResource Body}" FontSize="12" TextWrapping="Wrap"
                                           MaxWidth="456"
                                           Foreground="{DynamicResource TextPrimary}" />
                            </CheckBox>
                        </Border>

                        <StackPanel Visibility="{Binding RequiresTypedTarget, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Type" Style="{StaticResource Caption}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ConfirmWord}" Style="{StaticResource Mono}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center" Margin="5,0" />
                                <TextBlock Text="to confirm the target" Style="{StaticResource Caption}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox x:Name="ConfirmBox" Margin="0,6,0,0" Height="30"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     VerticalContentAlignment="Center" Padding="8,0"
                                     AutomationProperties.Name="Type the guest name to confirm" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Footer: the honest sentence about Cancel, then the pair of
                         decisions. Cancel keeps the initial focus, like the mockup's
                         ring shows. -->
                    <Border Grid.Row="3" Height="56" Padding="20,0" Margin="0,10,0,0"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FooterNote}"
                                       Style="{StaticResource Caption}" FontSize="11"
                                       Foreground="{DynamicResource TextTertiary}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="280" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="CancelButton" Style="{StaticResource DialogButton}"
                                        Content="Cancel" Click="OnCancel"
                                        AutomationProperties.Name="Cancel this action" />
                                <Button x:Name="ConfirmButton" Style="{StaticResource DangerPrimaryButton}"
                                        Click="OnConfirm" Margin="0"
                                        AutomationProperties.Name="{Binding ConfirmLabel}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconShield}" Width="14" Height="14"
                                              Stretch="Uniform" StrokeThickness="1.5"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding ConfirmLabel}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </views:FloatingSurface>
        </Grid>
    </Grid>
</Window>
