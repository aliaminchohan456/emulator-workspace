<Window x:Class="EmulatorWorkspace.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EmulatorWorkspace.Desktop.Views"
        Title="Emulator Workspace"
        Width="1180" Height="820" MinWidth="980" MinHeight="620"
        Background="{DynamicResource WindowBg}"
        AllowDrop="True"
        Drop="OnFileDrop" DragOver="OnDragOver" DragEnter="OnDragEnter" DragLeave="OnDragLeave"
        Closing="OnClosing" KeyDown="OnKeyDown" SizeChanged="OnWindowSizeChanged">

    <Window.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVis" />
        <views:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <views:NullToVisibilityConverter x:Key="NullToVis" />
        <views:NullToVisibilityConverter x:Key="NotNullToVis" Invert="True" />
        <views:InverseBoolConverter x:Key="InverseBool" />
        <views:StateToBrushConverter x:Key="StateBrush" />
        <views:SeverityToBrushConverter x:Key="SeverityBrush" />
        <!-- UX-03: stage tone and boot-step colour mapping; both always pair the
             brush with a printed word. -->
        <views:StageToneToBrushConverter x:Key="ToneBrush" />
        <views:StepStateToBrushConverter x:Key="StepBrush" />
        <views:TextToVisibilityConverter x:Key="TextToVis" />
        <views:TextToVisibilityConverter x:Key="InverseTextToVis" Invert="True" />
        <views:ToneToBrushConverter x:Key="ToneRoles" />
        <views:StringEqualsToVisibilityConverter x:Key="StringVis" />
        <views:CountToVisibilityConverter x:Key="CountVis" />

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,0,8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- UX-04b shell: a 48 DIP navigation rail item. The active destination
             paints an accent-soft surface and a 2 DIP accent bar on the leading
             edge; the glyph is accent, the rest are text2 and brighten on hover.
             A destination that is not a real view is never rendered as a button. -->
        <Style x:Key="NavRailItem" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="views:Motion.HoverFade" Value="True" />
            <Setter Property="views:RailHover.IsEnabled" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="ActiveSurface" Background="{DynamicResource AccentSoftBg}"
                                    CornerRadius="6" Visibility="Collapsed" />
                            <Border x:Name="HoverLayer" Background="{DynamicResource ChipBg}"
                                    CornerRadius="6" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="PressLayer" Background="{DynamicResource PressedBg}"
                                    CornerRadius="6" Opacity="0" IsHitTestVisible="False" />
                            <Ellipse x:Name="PART_Glow" Width="34" Height="34" Opacity="0"
                                     Fill="{DynamicResource HoverGlow}" IsHitTestVisible="False" />
                            <Border x:Name="ActiveBar" Width="2" Height="18" HorizontalAlignment="Left"
                                    Margin="-7,0,0,0" Background="{DynamicResource Accent}"
                                    CornerRadius="1" Visibility="Collapsed" />
                            <ContentPresenter x:Name="PART_Glyph" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="ActiveSurface" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The current destination: not a button, because clicking it would go
             nowhere. Same geometry and accent treatment as an active rail item. -->
        <Style x:Key="NavRailCurrent" TargetType="Grid">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Inspector rows: label left in text3 at 12, value flush right. Mono is
             applied per row only where the value is an identifier (serial, port,
             ABI); everything else is UI text. Long values ellipsize and keep the
             full string in the tooltip. -->
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RowValue" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MaxWidth" Value="190" />
        </Style>

        <Style x:Key="RowValueMono" TargetType="TextBlock" BasedOn="{StaticResource RowValue}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <!-- B1: mono values are Normal weight even inside a selected tab (the
                 TabItem used to hand SemiBold down to its whole content). -->
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <Style x:Key="RowValueNumeric" TargetType="TextBlock" BasedOn="{StaticResource RowValueMono}">
            <Setter Property="MinWidth" Value="72" />
        </Style>

        <!-- Caps section header inside the inspector: IDENTITY / RESOURCES /
             SESSION, text3 at 11 with the design sheet's tracking. The tracking
             is the cheap Caps.Tracking transform (hair spaces + upper case) and
             it keeps the original word as the accessible name. -->
        <Style x:Key="RowSection" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="views:Caps.Tracking" Value="True" />
        </Style>

        <Style x:Key="RowRule" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="Margin" Value="0,12" />
        </Style>

        <!-- Identity pill (LOW item 10): ok-soft when Running, warn-soft while
             Starting/Stopping, err-soft when Failed, plain chip otherwise. -->
        <Style x:Key="IdentityPill" TargetType="Border" BasedOn="{StaticResource StatePill}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedDevice.State}" Value="Running">
                    <Setter Property="Background" Value="{DynamicResource SuccessBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedDevice.State}" Value="Starting">
                    <Setter Property="Background" Value="{DynamicResource WarningBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedDevice.State}" Value="Stopping">
                    <Setter Property="Background" Value="{DynamicResource WarningBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedDevice.State}" Value="Failed">
                    <Setter Property="Background" Value="{DynamicResource DangerBg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IdentityPillText" TargetType="TextBlock" BasedOn="{StaticResource StatePillText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedDevice.State}" Value="Running">
                    <Setter Property="Foreground" Value="{DynamicResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedDevice.State}" Value="Starting">
                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedDevice.State}" Value="Stopping">
                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedDevice.State}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IdentityPillDot" TargetType="Ellipse" BasedOn="{StaticResource StatePillDot}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedDevice.State}" Value="Running">
                    <Setter Property="Fill" Value="{DynamicResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedDevice.State}" Value="Starting">
                    <Setter Property="Fill" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedDevice.State}" Value="Stopping">
                    <Setter Property="Fill" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedDevice.State}" Value="Failed">
                    <Setter Property="Fill" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The command bar's one accent action keeps the primary geometry but
             sits inside a 30 DIP segmented group, so its radius stays 6 inside
             the group's 8. -->
        <Style x:Key="BarPrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="10,0" />
        </Style>

        <!-- igr-feedback-ux05 item 6: the quiet action in a privileged card.
             Same 32 DIP geometry as ToolButton, but no resting surface and no
             border, so only the consequential (warn/err) actions carry an
             outline. Hover and press still paint through the shared layers. -->
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
        </Style>

        <!-- UX-05 stage chip: a small pill that floats on the viewport colour.
             It always carries words (a value or an em dash), never colour alone. -->
        <Style x:Key="StageChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusInnerCard}" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Opacity" Value="0.94" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="StageChipText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Status bar segments: an 11 DIP label in text3 and a tabular mono
             value, separated by 1 px stroke-soft rules. -->
        <Style x:Key="StatusLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StatusValue" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <Style x:Key="StatusDivider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="11" />
            <Setter Property="Margin" Value="9,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
        </Style>

        <!-- A status-bar destination: text-only ghost, no surface until hover. -->
        <Style x:Key="StatusLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="views:Motion.HoverFade" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="HoverLayer" Background="{DynamicResource ChipBg}"
                                    CornerRadius="4" Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A telemetry number: tabular mono at 12 with a 3-character floor so a
             value ticking from 9.8 to 10.2 cannot shift the pill. -->
        <Style x:Key="TelemetryValue" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <!-- igr-feedback-ux05 item 1: the telemetry pill is a RAISED pill (10 DIP
             radius, 1 px stroke-soft edge) rather than a flat field, and it holds
             only what the frame stream measures. The CPU segment is gone at every
             width: the supervisor reports no sample, and "CPU —" behind a flat
             underline read like an empty input. -->
        <Style x:Key="TelemetryPillButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelAlt}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="views:Motion.HoverFade" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="B" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource RadiusCard}" />
                            <Border x:Name="PART_Hover" Background="{DynamicResource ChipBg}"
                                    CornerRadius="{StaticResource RadiusCard}" Opacity="0"
                                    IsHitTestVisible="False" />
                            <Border x:Name="PART_Press" Background="{DynamicResource PressedBg}"
                                    CornerRadius="{StaticResource RadiusCard}" Opacity="0"
                                    IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- UX-05 boot stepper item: done = ok fill with a check, current =
             accent with a 1.2 s pulse ring (suppressed when Windows reports
             reduced motion), pending = text3 hollow. One style shared by the
             three steps so their geometry cannot drift. -->
        <Style x:Key="BootStep" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="12" Height="12" VerticalAlignment="Top" Margin="0,2,0,0">
                                <Ellipse x:Name="Ring" Width="12" Height="12" StrokeThickness="1"
                                         Stroke="{DynamicResource Accent}" Opacity="0" Visibility="Collapsed"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="RingScale" ScaleX="0.8" ScaleY="0.8" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="Dot" Width="10" Height="10" StrokeThickness="1.4"
                                         Stroke="{DynamicResource TextTertiary}" Fill="Transparent"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Path x:Name="Check" Data="{StaticResource IconCheck}" Width="8" Height="8"
                                      Stretch="Uniform" Visibility="Collapsed"
                                      Stroke="{DynamicResource AccentText}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource SectionHeader}"
                                           FontSize="12" LineHeight="16" />
                                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                                           FontSize="11" LineHeight="15"
                                           Foreground="{DynamicResource TextTertiary}" />
                            </StackPanel>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="done">
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Success}" />
                                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Success}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="active">
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Ring" Property="Opacity" Value="0.55" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="unknown">
                                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource TextSecondary}" />
                            </DataTrigger>
                            <!-- The pulse: 1.2 s ease, and only when Windows reports
                                 client-area animation. Reduced motion keeps the
                                 static 55 % ring, which still reads as "current". -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding State}" Value="active" />
                                    <Condition Binding="{Binding MotionAllowed, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                               Value="True" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="StepPulse">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Ring"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.95" To="0" Duration="0:0:1.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RingScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             From="0.75" To="1.9" Duration="0:0:1.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RingScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             From="0.75" To="1.9" Duration="0:0:1.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="StepPulse" />
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 1 px stroke-soft divider inside the floating toolbar pill. -->
        <Style x:Key="PillDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="8,3" />
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
        </Style>

        <!-- Drawer tab in the always-visible bar above the status line: a text
             tab with a 2 DIP accent underline while its drawer is open. -->
        <Style x:Key="DrawerTab" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="views:Motion.HoverFade" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="HoverLayer" Background="{DynamicResource ChipBg}"
                                    CornerRadius="6" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="PressLayer" Background="{DynamicResource PressedBg}"
                                    CornerRadius="6" Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Opacity="0"
                                    Background="{DynamicResource Accent}" CornerRadius="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="Underline" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- UX-04b: the 48 DIP destination rail replaces the permanent
                 device column. It spans every row, so the rail is the window's
                 left edge from the command bar to the status bar. -->
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- UX-03: a persistent error bar sits between the command bar and
                 the body so it never covers the guest frame. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <!-- UX-04b: a persistent drawer tab bar, then the drawer itself. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Destination rail. Only real destinations appear: Studio (the view
             this window is), Devices (the U-04 library window), Logcat (the
             drawer), Agents (the sessions window) and Root Lab (the lab section
             of the inspector's Diagnostics tab). There is no Settings command in
             the app, so there is no Settings item. -->
        <Border x:Name="NavRail" Grid.Column="0" Grid.Row="0" Grid.RowSpan="6"
                Background="{DynamicResource NavBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,8">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,2">
                    <Button Style="{StaticResource NavRailItem}" Click="OnOpenPalette"
                            ToolTip="Search commands (Ctrl+K)" AutomationProperties.Name="Search commands">
                        <Path Data="{StaticResource IconSearch}" Style="{StaticResource Glyph}" />
                    </Button>
                    <Button Style="{StaticResource NavRailItem}" Command="{Binding ToggleThemeCommand}"
                            ToolTip="Switch between the dark and light theme"
                            AutomationProperties.Name="Switch theme">
                        <Path Data="{StaticResource IconTheme}" Style="{StaticResource Glyph}" />
                    </Button>
                    <Button Style="{StaticResource NavRailItem}" Command="{Binding RefreshCommand}"
                            Margin="0" ToolTip="Re-read the supervisor, the SDK report and the device state"
                            AutomationProperties.Name="Refresh workspace state">
                        <Path Data="{StaticResource IconRefresh}" Style="{StaticResource Glyph}" />
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top">
                    <!-- Current view: no button, so it cannot pretend to navigate. -->
                    <Grid Style="{StaticResource NavRailCurrent}"
                          ToolTip="Studio: the running guest view"
                          AutomationProperties.Name="Studio (current view)">
                        <Border Background="{DynamicResource AccentSoftBg}" CornerRadius="6" />
                        <Border Width="2" Height="18" HorizontalAlignment="Left" Margin="-6,0,0,0"
                                Background="{DynamicResource Accent}" CornerRadius="1" />
                        <Path Data="{StaticResource IconMonitor}" Stroke="{DynamicResource Accent}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Width="16" Height="16" Stretch="None"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Button Style="{StaticResource NavRailItem}" Margin="0" Click="OnDevices"
                                ToolTip="Devices: the managed instance library"
                                AutomationProperties.Name="Device library">
                            <Path Data="{StaticResource IconGrid}" Style="{StaticResource Glyph}" />
                        </Button>
                        <!-- Count badge from the live instance list. -->
                        <Border Background="{DynamicResource Accent}" CornerRadius="999"
                                MinWidth="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-3,-3,0" Padding="3,0" IsHitTestVisible="False"
                                Visibility="{Binding Devices.Count, Converter={StaticResource CountVis}}">
                            <TextBlock Text="{Binding Devices.Count}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AccentText}" />
                        </Border>
                    </Grid>

                    <Button Style="{StaticResource NavRailItem}" Command="{Binding ToggleLogcatCommand}"
                            Tag="{Binding IsLogcatOpen}"
                            ToolTip="Logcat: the bottom drawer"
                            AutomationProperties.Name="Logcat drawer">
                        <Path Data="{StaticResource IconLogs}" Style="{StaticResource Glyph}" />
                    </Button>

                    <Button Style="{StaticResource NavRailItem}" Click="OnAgents"
                            ToolTip="Agents: supervise paired agent sessions"
                            AutomationProperties.Name="Agent sessions">
                        <Path Data="{StaticResource IconAgents}" Style="{StaticResource Glyph}" />
                    </Button>

                    <Grid Margin="0,0,0,4">
                        <Button Style="{StaticResource NavRailItem}" Margin="0" Click="OnRootLab"
                                ToolTip="Root Lab: ADB daemon identity and the Magisk lab"
                                AutomationProperties.Name="Root Lab">
                            <Path Data="{StaticResource IconShield}" Style="{StaticResource Glyph}" />
                        </Button>
                        <!-- Status dot only when the supervisor reports a real lab
                             state: ok when prepared, warn when recovery is due. -->
                        <Ellipse Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,1,-1,0" IsHitTestVisible="False">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Fill" Value="{DynamicResource Success}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LabDotTone}" Value="ok">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Fill" Value="{DynamicResource Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LabDotTone}" Value="warn">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Fill" Value="{DynamicResource Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LabDotTone}" Value="err">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Fill" Value="{DynamicResource Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                </StackPanel>
                <Grid />
            </DockPanel>
        </Border>

        <!-- Command bar: device identity on the left, the live telemetry pill,
             then the device commands as segmented icon groups. One accent action
             (Install APK), everything else ghost. Identity is a fixed 2-line grid
             (18 + 16) so the name, the state pill and the subtitle sit on clean
             baselines and nothing clips. -->
        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource NavBg}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Identity (UX-05 fix pass, item 4): a 32 DIP device tile
                     centred against BOTH lines, the name at 14 SemiBold, the state
                     chip on the same baseline 8 DIP to its right, and the
                     'API · ABI · serial' subtitle at 12 in text3. The block is
                     content-sized and left-aligned, so the chip always sits 8 DIP
                     from the name instead of drifting to the far edge. -->
                <Grid Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition Height="17" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.RowSpan="2" Width="32" Height="32" CornerRadius="8"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentSoftBg}"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                        <Path Data="{StaticResource IconDevice}" Style="{StaticResource Glyph}"
                              Width="18" Height="18" Stretch="Uniform"
                              Stroke="{DynamicResource Accent}" />
                    </Border>
                    <Grid Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                          HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- The name keeps a bounded width so a long guest name
                             ellipsizes instead of pushing the state pill away. -->
                        <TextBlock Grid.Column="0" Text="{Binding SelectedDevice.Name, FallbackValue=No device selected, TargetNullValue=No device selected}"
                                   FontFamily="{StaticResource UiFont}" FontSize="14" FontWeight="SemiBold"
                                   LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   TextTrimming="CharacterEllipsis" MaxWidth="180"
                                   ToolTip="{Binding SelectedDevice.Name}" />
                        <Border Grid.Column="1" Style="{StaticResource IdentityPill}" Margin="8,0,0,0"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource IdentityPillDot}" />
                                <TextBlock Text="{Binding SelectedDevice.State}"
                                           Style="{StaticResource IdentityPillText}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDevice.Subtitle}" Style="{StaticResource Caption}"
                               Margin="10,0,0,0"
                               Foreground="{DynamicResource TextTertiary}" FontSize="12"
                               LineHeight="17" LineStackingStrategy="BlockLineHeight"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               TextTrimming="CharacterEllipsis" MaxWidth="240"
                               ToolTip="{Binding SelectedDevice.Subtitle}" />
                </Grid>

                <!-- UX-05 telemetry micro-pill (addendum 7, reshaped by
                     igr-feedback-ux05 item 1): a raised 10 DIP pill with a 1 px
                     stroke-soft edge, "FPS n" in tabular mono, and a 40 x 14
                     sparkline to its right drawn ONLY once there are two or more
                     real samples. The CPU segment is gone at every width (no
                     backend), and below 1120 DIP the pill keeps just "FPS n".
                     Clicking opens the popover with the fuller frame metrics. -->
                <Button x:Name="TelemetryPill" Grid.Column="1" VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        Style="{StaticResource TelemetryPillButton}"
                        Click="OnTelemetryClick"
                        ToolTip="{Binding TelemetryTooltip}"
                        AutomationProperties.Name="Live telemetry"
                        AutomationProperties.HelpText="{Binding TelemetryTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="FPS" Style="{StaticResource StatusLabel}" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding TelemetryFpsValue}" Style="{StaticResource TelemetryValue}" />
                        <!-- The sparkline host carries the responsive rule; the
                             polyline itself is drawn only with 2+ samples, so an
                             empty stream reserves no space at all. -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding CompactTelemetry, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}">
                            <Grid Width="40" Height="14" Margin="8,0,0,0" VerticalAlignment="Center"
                                  Visibility="{Binding HasSpark, Converter={StaticResource BoolToVis}}">
                                <Polygon Points="{Binding SparkAreaPoints}"
                                         Fill="{DynamicResource Accent}" Opacity="0.22" />
                                <Polyline x:Name="TelemetrySpark" Points="{Binding SparkPoints}"
                                          Stroke="{DynamicResource Accent}" StrokeThickness="1.2"
                                          StrokeLineJoin="Round" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Popup x:Name="TelemetryPopover" PlacementTarget="{Binding ElementName=TelemetryPill}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       HorizontalOffset="-120" VerticalOffset="6" PopupAnimation="None">
                    <views:FloatingSurface Style="{StaticResource FloatingCard}" Width="260"
                                           AutomationProperties.Name="Telemetry detail">
                        <StackPanel>
                            <TextBlock Text="FRAME PIPELINE" Style="{StaticResource RowSection}" />
                            <Grid Margin="0,6,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Frame rate" Style="{StaticResource RowLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding FrameRateText}"
                                           Style="{StaticResource RowValueNumeric}" />
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Delivered" Style="{StaticResource RowLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding DeliveredFrameText}"
                                           Style="{StaticResource RowValueNumeric}" />
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dropped" Style="{StaticResource RowLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding DroppedFramesText}"
                                           Style="{StaticResource RowValueNumeric}" />
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Guest display" Style="{StaticResource RowLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding GuestDisplayText}"
                                           Style="{StaticResource RowValueNumeric}" />
                            </Grid>
                            <Border Style="{StaticResource RowRule}" Margin="0,8" />
                            <TextBlock Text="{Binding TelemetrySamplingNote}" Style="{StaticResource Caption}"
                                       FontSize="11" Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </views:FloatingSurface>
                </Popup>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- restart | power (fix pass item 5): restart is the
                         rotate-ccw icon that used to be a text button, so the
                         segment reads restart | stop. Rotate itself lives in the
                         floating pill; no command was lost, and the duplicate in
                         the bar is retired rather than repeated a third time. -->
                    <Border Style="{StaticResource SegmentGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SegmentButton}" Command="{Binding RestartCommand}"
                                    ToolTip="Restart the selected guest" AutomationProperties.Name="Restart device">
                                <Path Data="{StaticResource IconRestart}" Style="{StaticResource Glyph}" />
                            </Button>
                            <Border Style="{StaticResource SegmentDivider}" />
                            <Button Style="{StaticResource SegmentButton}" Command="{Binding PrimaryActionCommand}"
                                    ToolTip="{Binding PrimaryActionText}"
                                    AutomationProperties.Name="Primary device action">
                                <Path Data="{StaticResource IconPower}" Style="{StaticResource Glyph}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- install APK | screenshot: the bar's one accent action. -->
                    <Border Style="{StaticResource SegmentGroup}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BarPrimary}" Command="{Binding InstallApkCommand}"
                                    ToolTip="Install an APK on the selected guest (drop a file on the viewport too)"
                                    AutomationProperties.Name="Install APK">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconInstall}" Width="16" Height="16" Stretch="None"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Install APK" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border Style="{StaticResource SegmentDivider}" />
                            <Button Style="{StaticResource SegmentButton}" Command="{Binding ScreenshotCommand}"
                                    IsEnabled="{Binding IsGuestInteractive}"
                                    ToolTip="Capture a PNG of the selected guest" AutomationProperties.Name="Screenshot">
                                <Path Data="{StaticResource IconScreenshot}" Style="{StaticResource Glyph}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- fit | 1:1 | zoom out | zoom in -->
                    <Border Style="{StaticResource SegmentGroup}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SegmentButton}" Click="OnFit"
                                    ToolTip="Fit to window (Ctrl+wheel zooms)" AutomationProperties.Name="Fit to window">
                                <Path Data="{StaticResource IconFit}" Style="{StaticResource Glyph}" />
                            </Button>
                            <Border Style="{StaticResource SegmentDivider}" />
                            <Button Style="{StaticResource SegmentButton}" Click="OnActualSize"
                                    ToolTip="Actual size (1:1)" AutomationProperties.Name="Actual size">
                                <Path Data="{StaticResource IconActualSize}" Style="{StaticResource Glyph}" />
                            </Button>
                            <Border Style="{StaticResource SegmentDivider}" />
                            <Button Style="{StaticResource SegmentButton}" Click="OnZoomOut"
                                    ToolTip="Zoom out (Ctrl+wheel)" AutomationProperties.Name="Zoom out">
                                <Path Data="{StaticResource IconMinus}" Style="{StaticResource Glyph}" />
                            </Button>
                            <Button Style="{StaticResource SegmentButton}" Click="OnZoomIn"
                                    ToolTip="Zoom in (Ctrl+wheel)" AutomationProperties.Name="Zoom in">
                                <Path Data="{StaticResource IconPlus}" Style="{StaticResource Glyph}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- pop out | fullscreen -->
                    <Border Style="{StaticResource SegmentGroup}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SegmentButton}" Click="OnPopOut"
                                    ToolTip="Pop out the viewport" AutomationProperties.Name="Pop-out">
                                <Path Data="{StaticResource IconPopOut}" Style="{StaticResource Glyph}" />
                            </Button>
                            <Border Style="{StaticResource SegmentDivider}" />
                            <Button Style="{StaticResource SegmentButton}" Click="OnFullscreen"
                                    ToolTip="Fullscreen (F11)" AutomationProperties.Name="Fullscreen">
                                <Path Data="{StaticResource IconFullscreen}" Style="{StaticResource Glyph}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- details | focus (fix pass item 5): the two trailing icons
                         are one 'view' segment and keep their tooltips and their
                         existing Click handlers. -->
                    <Border Style="{StaticResource SegmentGroup}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SegmentButton}" Click="OnToggleDetails"
                                    ToolTip="Toggle the details panel" AutomationProperties.Name="Toggle details">
                                <Path Data="{StaticResource IconDetails}" Style="{StaticResource Glyph}" />
                            </Button>
                            <Button Style="{StaticResource SegmentButton}" Click="OnToggleFocusView"
                                    ToolTip="Focus view: hide the rail, details and Logcat"
                                    AutomationProperties.Name="Focus view">
                                <Path Data="{StaticResource IconFocus}" Style="{StaticResource Glyph}" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- UX-03 typed error bar, UX-04b refinement: err-soft surface (~12%
             tint), 1 px error border at 35%, a 3 px error bar on the leading
             edge, title in text, body in text2, one sentence plus one next safe
             action, and the long technical string behind Copy details. Inset
             8 px from the window edges and sitting above the viewport card, so
             it never covers the frame. It stays until dismissed. -->
        <Border Grid.Row="1" Grid.Column="1" Margin="8,6,8,0" Background="{DynamicResource DangerBg}"
                BorderBrush="{DynamicResource DangerBorder}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusCard}"
                Visibility="{Binding HasErrorBar, Converter={StaticResource BoolToVis}}"
                AutomationProperties.Name="Error">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource Danger}" CornerRadius="10,0,0,10" />
                <Path Grid.Column="1" Data="{StaticResource IconWarning}" Stroke="{DynamicResource Danger}"
                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" Width="16" Height="16" Stretch="None"
                      VerticalAlignment="Top" Margin="12,12,10,0" />
                <StackPanel Grid.Column="2" Margin="0,10,12,10">
                    <TextBlock Text="{Binding ErrorBarTitle}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorBarText}" Style="{StaticResource Body}"
                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding ErrorBarAction}" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,8,8,0">
                    <Button Content="Retry" Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}"
                            ToolTip="Re-read the supervisor, the SDK report and the device state"
                            Visibility="{Binding ShowErrorRetry, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Retry the failed operation" />
                    <Button Content="Copy details" Style="{StaticResource ToolButton}"
                            Command="{Binding CopyErrorDetailsCommand}"
                            ToolTip="Copy the full technical message"
                            AutomationProperties.Name="Copy error details" />
                    <Button Content="Dismiss" Style="{StaticResource ToolButton}"
                            Command="{Binding DismissErrorCommand}" Margin="0"
                            AutomationProperties.Name="Dismiss the error" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid x:Name="BodyGrid" Grid.Row="2" Grid.Column="1" Margin="8">
            <Grid.ColumnDefinitions>
                <!-- UX-04b: the device column and its splitter are retired; the
                     rail above is the only navigation. Zero-width columns keep
                     every existing Grid.Column index and the viewport geometry
                     untouched. -->
                <ColumnDefinition Width="0" MinWidth="0" />
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="318" MinWidth="250" />
                <!-- UX-05: 0 wide. The floating pill replaced the device strip;
                     the column keeps its index so no child's Grid.Column moves. -->
                <ColumnDefinition Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Viewport (B3): in the light theme the stage keeps the 02/17 feel,
                 a soft stroke-soft edge over the viewport colour rather than a
                 full-strength panel border. UX-05 turns it into a stage: a
                 static ambient glow, a 1.5 % noise dither, a decorative device
                 frame behind the live frame, stage chips and the floating
                 toolbar pill. None of that is inside ViewportScroll, so the
                 canvas, the image and the input mapping are byte-identical. -->
            <Border Grid.Column="2" Style="{StaticResource Panel}" Background="{DynamicResource ViewportBg}"
                    BorderBrush="{DynamicResource BorderSubtle}" ClipToBounds="True">
                <Grid x:Name="StageRoot" SizeChanged="OnStageSizeChanged" MouseMove="OnStageMouseMove">
                    <!-- Ambient stage (addendum 6): accent ~7 % with an ok core,
                         both static, plus the noise tile that kills banding. -->
                    <Border Background="{DynamicResource StageGlow}" IsHitTestVisible="False" />
                    <Border Background="{DynamicResource StageGlowOk}" IsHitTestVisible="False" />
                    <Border Background="{DynamicResource StageNoise}" IsHitTestVisible="False" />

                    <!-- Decorative device frame: a rounded bezel drawn AROUND the
                         live frame (10 DIP bezel, soft shadow). igr-feedback-ux05
                         item 8: the outer radius is the screen radius plus the
                         bezel padding — the guest frame is square, so 0 + 10 = 10
                         and the corners are concentric with the frame they wrap.
                         It is a sibling behind ViewportScroll, sized from the
                         viewport canvas in code, so it never clips or covers a
                         guest pixel and never touches the input surface. -->
                    <Border x:Name="DeviceFrame" HorizontalAlignment="Center" VerticalAlignment="Center"
                            CornerRadius="10" Background="{DynamicResource DeviceFrameBg}"
                            BorderBrush="{DynamicResource DeviceBodyBorder}" BorderThickness="1"
                            Effect="{DynamicResource DeviceFrameShadow}" IsHitTestVisible="False" />

                    <Grid x:Name="ViewportScroll" ClipToBounds="True" Margin="12">
                        <Grid x:Name="ViewportCanvas" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="ViewportImage" Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   MouseLeftButtonDown="OnViewportMouseDown"
                                   MouseLeftButtonUp="OnViewportMouseUp"
                                   AutomationProperties.Name="Embedded Android viewport"
                                   Source="{Binding Frame}" />
                        </Grid>
                    </Grid>

                    <!-- igr-feedback-ux05 item 2: the stage cards (boot stepper,
                         first-run setup) live in a lane that stops short of the
                         floating pill's slot, so the pill can hold its bezel
                         position while the guest is Starting without sitting on
                         top of the card. The lane's right inset is set from the
                         pill's real left margin in code; with a frame it is 0. -->
                    <Grid x:Name="StageCardLane">
                    <!-- UX-03 inline stage, UX-05 stepper: boot readiness, frame
                         wait, stopped, failed, lab recovery and restricted
                         capture. It is a non-blocking card sourced from
                         supervisor state; the guest frame and the input surface
                         are never covered or dimmed by it. The separate
                         "waiting for Android" card and its progress bar are
                         folded in here: the three boot dots are the progress,
                         and the elapsed figure is the supervisor's own launch
                         timestamp, not a timer that turns green. -->
                    <Border VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Margin="24"
                            Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="20" IsHitTestVisible="False"
                            Visibility="{Binding StageVisible, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Device state">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0"
                                         Fill="{Binding StageTone, Converter={StaticResource ToneBrush}}" />
                                <TextBlock Text="{Binding StageTitle}" Style="{StaticResource PageText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="{Binding StageDetail}" Style="{StaticResource Body}"
                                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                       Margin="18,6,0,0" />

                            <!-- Connected dots: done = ok filled with a check,
                                 current = accent with a 1.2 s pulse ring (none
                                 under reduced motion), pending = text3 hollow.
                                 The connector takes the tone of the step it
                                 leaves, so progress reads as one line. -->
                            <StackPanel x:Name="BootStepper" Orientation="Horizontal" Margin="18,16,0,0"
                                        Visibility="{Binding ShowBootStages, Converter={StaticResource BoolToVis}}">
                                <ContentControl Style="{StaticResource BootStep}" DataContext="{Binding BootStages[0]}"
                                                AutomationProperties.Name="Boot stage 1" />
                                <Border Width="22" Height="1" Margin="8,7,8,0" VerticalAlignment="Top"
                                        Background="{Binding BootStages[0].State, Converter={StaticResource StepBrush}}" />
                                <ContentControl Style="{StaticResource BootStep}" DataContext="{Binding BootStages[1]}"
                                                AutomationProperties.Name="Boot stage 2" />
                                <Border Width="22" Height="1" Margin="8,7,8,0" VerticalAlignment="Top"
                                        Background="{Binding BootStages[1].State, Converter={StaticResource StepBrush}}" />
                                <ContentControl Style="{StaticResource BootStep}" DataContext="{Binding BootStages[2]}"
                                                AutomationProperties.Name="Boot stage 3" />
                            </StackPanel>

                            <TextBlock Text="{Binding BootElapsedText}" Style="{StaticResource Mono}"
                                       Foreground="{DynamicResource TextTertiary}" Margin="18,12,0,0"
                                       Visibility="{Binding BootElapsedText, Converter={StaticResource TextToVis}}" />

                            <TextBlock Text="{Binding StageHint}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="18,12,0,0"
                                       Visibility="{Binding StageHint, Converter={StaticResource TextToVis}}" />

                            <!-- igr-feedback-ux05 item 2: the top banner's
                                 supervisor note lives here now, as one 12 DIP
                                 text3 line at the bottom of the only progress
                                 surface, so boot has a single card. -->
                            <TextBlock Text="The supervisor owns the operation; closing this window will not stop the guest. Other panes stay usable."
                                       Style="{StaticResource Caption}" FontSize="12"
                                       Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap"
                                       Margin="18,10,0,0"
                                       Visibility="{Binding ShowBootStages, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- First-run setup -->
                    <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="24" MaxWidth="640"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowSetup, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Set up your first device" Style="{StaticResource H1}" />
                            <TextBlock Text="{Binding SetupSummary}" Style="{StaticResource Caption}" Margin="0,6,0,12"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding SetupIssues}" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource Warning}"
                                                   TextWrapping="Wrap" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Style="{StaticResource Panel}" Padding="10" Margin="0,0,0,14">
                                <TextBlock Text="{Binding DoctorText}" Style="{StaticResource Mono}"
                                           TextWrapping="Wrap" />
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <!-- The primary turns into a 40 % ghost with its
                                     reason in the tooltip when the supervisor or
                                     the SDK blocks creation (LOW item 11). -->
                                <Button Content="Create AOSP API 35 device" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding CreateDeviceCommand}"
                                        ToolTip="{Binding SetupSummary}"
                                        AutomationProperties.HelpText="{Binding SetupSummary}" />
                                <Button Content="Copy diagnostics" Style="{StaticResource ToolButton}"
                                        Command="{Binding CopyDiagnosticsCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </Grid>

                    <!-- UX-03 busy strip: real indeterminate progress, no dimming
                         and no hit-test cover, so the window keeps working while
                         the supervisor owns the operation. igr-feedback-ux05
                         item 2: while the boot stepper is on screen it is the
                         ONLY progress surface, so this strip stands down (its
                         supervisor note moved into the stepper card). -->
                    <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16,46,16,0" MaxWidth="460"
                            Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="12,10" IsHitTestVisible="False"
                            AutomationProperties.Name="Operation in progress">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowBootStages}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding BusyText}" TextWrapping="Wrap" />
                            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0" />
                            <TextBlock Text="The supervisor owns the operation; closing this window will not stop the guest. Other panes stay usable."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- UX-03 stale frame, UX-05 chip pass: the last frame stays
                         visible and is stamped. One line, bottom-centre over the
                         stage, warn-soft with warn text, at most 90 % of the
                         stage wide: "Frame stalled · 17s · input paused" with
                         the real age of the last delivered frame. A supervised
                         operation that holds the ADB channel keeps the same chip
                         with its own words ("Frames paused ..."). -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,46"
                            MaxWidth="640" Background="{DynamicResource WarningBg}"
                            BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1"
                            CornerRadius="6" Padding="10,5" IsHitTestVisible="False"
                            Visibility="{Binding IsFrameStale, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Frame stream paused">
                        <TextBlock Width="Auto" MaxWidth="600" Text="{Binding StaleChipText}"
                                   Style="{StaticResource Caption}" FontSize="11"
                                   Foreground="{DynamicResource Warning}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                    </Border>

                    <!-- UX-03 APK drag affordance, UX-05 full-viewport dropzone:
                         the whole viewport card is the target. A raised veil (92 %
                         so the ghost phone and the pill do not read through it), a
                         2 px dashed edge that runs accent when the drag is
                         accepted and warn when it is refused, a 1.2 s opacity
                         pulse (static under reduced motion) and the exact target
                         guest in words. igr-feedback-ux05 item 7: the dashed edge
                         is inset 6 DIP with a 4 DIP radius — the card is r10, so
                         4 + 6 keeps the corners concentric. -->
                    <Border x:Name="DropVeil" Margin="0" CornerRadius="0" IsHitTestVisible="False"
                            Panel.ZIndex="30"
                            Background="{DynamicResource DropVeilBg}"
                            Visibility="{Binding DropVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Rectangle x:Name="DropDash" Margin="6" RadiusX="4" RadiusY="4"
                                       StrokeThickness="2" StrokeDashArray="4 3" Opacity="1">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Stroke" Value="{DynamicResource Warning}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DropAccepted}" Value="True">
                                                <Setter Property="Stroke" Value="{DynamicResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                                <!-- igr-feedback-ux05 item 7: a 48 DIP accent-soft
                                     circle (the accent-soft FILL, not the neutral
                                     navigation tint), with the install glyph at
                                     the accent. -->
                                <Border Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center"
                                        Background="{DynamicResource AccentSoftTint}">
                                    <Path Data="{StaticResource IconInstall}" Stroke="{DynamicResource Accent}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Width="22" Height="22" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding DropTitle}" Style="{StaticResource H1}" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,14,0,0" />
                                <TextBlock Text="{Binding DropDetail}"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                            <Style.Triggers>
                                                <!-- A refusal keeps UX-03's warn wording and tone. -->
                                                <DataTrigger Binding="{Binding DropAccepted}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- UX-03 capture/install toast: success only, ~6 s, paused on
                         hover, with Open and Copy. Errors go to the error bar. It is
                         a floating surface: 10 radius, specular edge, two-layer
                         shadow. -->
                    <views:FloatingSurface HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                          Margin="16" MaxWidth="360" Style="{StaticResource FloatingCard}"
                                          Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVis}}"
                                          MouseEnter="OnToastEnter" MouseLeave="OnToastLeave"
                                          AutomationProperties.Name="Result">
                        <StackPanel>
                            <TextBlock Text="{Binding ToastTitle}" Style="{StaticResource SectionHeader}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{Binding ToastText}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Margin="0,2,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Open" Style="{StaticResource ToolButton}"
                                        Command="{Binding OpenToastCommand}"
                                        Visibility="{Binding HasToastPath, Converter={StaticResource BoolToVis}}"
                                        AutomationProperties.Name="Open the saved artifact" />
                                <Button Content="Copy path" Style="{StaticResource ToolButton}"
                                        Command="{Binding CopyToastCommand}"
                                        Visibility="{Binding HasToastPath, Converter={StaticResource BoolToVis}}"
                                        AutomationProperties.Name="Copy the artifact path" />
                                <Button Content="Dismiss" Style="{StaticResource ToolButton}"
                                        Command="{Binding DismissToastCommand}" Margin="0"
                                        AutomationProperties.Name="Dismiss the result" />
                            </StackPanel>
                        </StackPanel>
                    </views:FloatingSurface>

                    <!-- UX-05 stage chips (igr-feedback-ux03 MEDIUM 5): the guest
                         display top-left, orientation + zoom mode top-right, the
                         APK drop hint bottom-left and the real input capability
                         bottom-right (this chip replaces the "Capability:"
                         paragraph that used to live in the inspector). Every
                         value is live state; a value the supervisor has not
                         reported prints an em dash. -->
                    <Border Style="{StaticResource StageChip}" HorizontalAlignment="Left"
                            VerticalAlignment="Top" Margin="14"
                            ToolTip="{Binding StageGuestChipTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconMonitor}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <TextBlock Text="{Binding StageGuestChip}" Style="{StaticResource StageChipText}"
                                       Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StageChip}" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="14"
                            ToolTip="{Binding StageOrientationChipTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRotate}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <TextBlock Text="{Binding StageOrientationChip}" Style="{StaticResource StageChipText}"
                                       Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StageChip}" HorizontalAlignment="Left"
                            VerticalAlignment="Bottom" Margin="14" Opacity="0.85">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconInstall}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <TextBlock Text="{Binding StageDropHint}" Style="{StaticResource StageChipText}"
                                       Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StageChip}" HorizontalAlignment="Right"
                            VerticalAlignment="Bottom" Margin="14" Opacity="0.85"
                            ToolTip="{Binding InputCapabilityDetail}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTouch}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <TextBlock Text="{Binding InputCapabilityChip}" Style="{StaticResource StageChipText}"
                                       Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- UX-05 floating toolbar pill (MEDIUM 6 + addendum 5):
                         igr-feedback-ux05 item 4 orders it nav group first, then a
                         1 px stroke-soft separator, then the utilities:
                         back, home, recents | rotate, screenshot, sample. Every
                         command is the one that already existed, and the pill sits
                         16 DIP off the frame's right bezel (computed in code).
                         Item 2: the nav cluster and screenshot are disabled until
                         the guest is interactive, from existing state only.
                         Item 3: the shadow host is NOT clipped, so the light
                         theme's soft shadow keeps its rounded corner. -->
                    <Grid x:Name="ToolbarPillHost" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Panel.ZIndex="20" Margin="0"
                          MouseEnter="OnPillEnter" MouseLeave="OnPillLeave"
                          GotKeyboardFocus="OnPillFocus">
                        <views:FloatingSurface x:Name="ToolbarPill" Style="{StaticResource FloatingPill}"
                                               AutomationProperties.Name="Device toolbar">
                            <StackPanel x:Name="PillButtons" Orientation="Vertical">
                                <Button Style="{StaticResource PillIconButton}" Command="{Binding BackCommand}"
                                        ToolTip="Back" AutomationProperties.Name="Back"
                                        IsEnabled="{Binding IsGuestInteractive}">
                                    <Path Data="{StaticResource IconBack}" Style="{StaticResource Glyph}" />
                                </Button>
                                <Button Style="{StaticResource PillIconButton}" Command="{Binding HomeCommand}"
                                        ToolTip="Home" AutomationProperties.Name="Home"
                                        IsEnabled="{Binding IsGuestInteractive}">
                                    <Path Data="{StaticResource IconHome}" Style="{StaticResource Glyph}" />
                                </Button>
                                <Button Style="{StaticResource PillIconButton}" Command="{Binding RecentsCommand}"
                                        ToolTip="Recents" AutomationProperties.Name="Recents"
                                        IsEnabled="{Binding IsGuestInteractive}">
                                    <Path Data="{StaticResource IconRecents}" Style="{StaticResource Glyph}" />
                                </Button>
                                <Border Style="{StaticResource PillDivider}" />
                                <Button Style="{StaticResource PillIconButton}" Command="{Binding RotateCommand}"
                                        ToolTip="Rotate the guest display" AutomationProperties.Name="Rotate">
                                    <Path Data="{StaticResource IconRotate}" Style="{StaticResource Glyph}" />
                                </Button>
                                <Button Style="{StaticResource PillIconButton}" Command="{Binding ScreenshotCommand}"
                                        ToolTip="Capture a PNG of the selected guest" AutomationProperties.Name="Screenshot"
                                        IsEnabled="{Binding IsGuestInteractive}">
                                    <Path Data="{StaticResource IconScreenshot}" Style="{StaticResource Glyph}" />
                                </Button>
                                <Button Style="{StaticResource PillIconButton}" Command="{Binding LaunchSampleCommand}"
                                        Margin="0" ToolTip="Launch the sample application" AutomationProperties.Name="Launch sample">
                                    <Path Data="{StaticResource IconPlay}" Style="{StaticResource Glyph}" />
                                </Button>
                            </StackPanel>
                        </views:FloatingSurface>

                        <!-- Collapsed state: a 3x48 edge handle at 35 %. -->
                        <Border x:Name="PillHandle" Width="3" Height="48" CornerRadius="2"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{DynamicResource TextTertiary}" Opacity="0"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                        <!-- 24 DIP approach zone: the pointer within 24 px of the
                             handle expands it again. -->
                        <Border x:Name="PillHoverZone" Width="28" Height="60" Background="Transparent"
                                HorizontalAlignment="Center" Visibility="Collapsed"
                                MouseEnter="OnPillZoneEnter" />
                    </Grid>
                </Grid>
            </Border>

            <!-- UX-05: the old right-side vertical device strip is retired. Its
                 four commands (sample launch, back, home, recents) moved into the
                 floating pill above, with the same Command bindings; nothing was
                 added twice and nothing was lost. Column 5 keeps the same index
                 so no Grid.Column in this body moves, and it is now 0 wide. -->

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Inspector: three tabs. Device is identity and live resources,
                 Capture is the frame pipeline, Diagnostics holds the doctor text,
                 the SDK paths and the Root Lab so neither of them crowds the
                 identity rows. Every value is supervisor data; a field the
                 supervisor does not report is not rendered at all. -->
            <Border x:Name="InspectorPanel" Grid.Column="4" Style="{StaticResource Panel}" Padding="12">
                <TabControl x:Name="InspectorTabs" Background="Transparent" BorderThickness="0" Padding="0">
                    <TabItem Header="Device">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Device header row: thumbnail, name, subtitle. -->
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="8"
                                            Background="{DynamicResource DeviceBodyBg}"
                                            BorderBrush="{DynamicResource DeviceBodyBorder}" BorderThickness="1">
                                        <Path Data="{StaticResource IconDevice}" Width="20" Height="20" Stretch="Uniform"
                                              Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedDevice.Name, FallbackValue=No device selected}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SelectedDevice.Name}" />
                                        <TextBlock Text="{Binding SelectedDevice.Subtitle, FallbackValue=Select a device}"
                                                   Style="{StaticResource Caption}" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SelectedDevice.Subtitle}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource RowRule}" />

                                <TextBlock Text="IDENTITY" Style="{StaticResource RowSection}" />
                                <Grid Margin="0,5,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Serial" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.Serial}"
                                               Style="{StaticResource RowValueMono}"
                                               ToolTip="{Binding SelectedDevice.Serial}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ABI / API" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.AbiApi}"
                                               Style="{StaticResource RowValueMono}"
                                               ToolTip="{Binding SelectedDevice.AbiApi}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ports" Style="{StaticResource RowLabel}"
                                               ToolTip="Console and gRPC controller port" />
                                    <TextBlock Grid.Column="1" Text="{Binding PortsText}"
                                               Style="{StaticResource RowValueMono}" ToolTip="{Binding PortsText}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="GPU" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.Gpu}"
                                               Style="{StaticResource RowValue}"
                                               ToolTip="{Binding SelectedDevice.Gpu}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Image" Style="{StaticResource RowLabel}" />
                                    <!-- igr-feedback-ux05 item 5: the reading name
                                         is derived from the real package; the raw
                                         path stays in the tooltip. -->
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.ImageDisplay}"
                                               Style="{StaticResource RowValue}"
                                               ToolTip="{Binding SelectedDevice.ImagePackage}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Foreground" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.ForegroundDisplay}"
                                               Style="{StaticResource RowValueMono}"
                                               ToolTip="{Binding SelectedDevice.Foreground}" />
                                </Grid>

                                <Border Style="{StaticResource RowRule}" />

                                <TextBlock Text="RESOURCES" Style="{StaticResource RowSection}" />
                                <Grid Margin="0,5,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Guest display" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding GuestDisplayText}"
                                               Style="{StaticResource RowValueNumeric}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Frame" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding DeliveredFrameText}"
                                               Style="{StaticResource RowValueNumeric}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Frame rate" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding FrameRateText}"
                                               Style="{StaticResource RowValueNumeric}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Dropped" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding DroppedFramesText}"
                                               Style="{StaticResource RowValueNumeric}" />
                                </Grid>
                                <!-- Fix pass item 6b: one 12 DIP text3 line with a
                                     small info icon instead of a paragraph. The
                                     full sentence stays in the tooltip. -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            ToolTip="The supervisor does not report CPU, memory or disk usage for a running guest, so those rows are not rendered.">
                                    <Path Data="{StaticResource IconInfo}" Width="12" Height="12" Stretch="Uniform"
                                          Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          VerticalAlignment="Center" Margin="0,1,6,0" />
                                    <TextBlock Text="CPU, memory and disk: not reported"
                                               Style="{StaticResource Caption}" FontSize="12"
                                               Foreground="{DynamicResource TextTertiary}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <Border Style="{StaticResource RowRule}" />

                                <TextBlock Text="SESSION" Style="{StaticResource RowSection}" />
                                <Grid Margin="0,5,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Supervisor" Style="{StaticResource RowLabel}" />
                                    <!-- Fix pass item 6c: the session state is an
                                         ok-soft / err-soft chip driven by the real
                                         IsConnected state, never a coloured word. -->
                                    <Border Grid.Column="1" HorizontalAlignment="Right">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource StatePill}">
                                                <Setter Property="Background" Value="{DynamicResource DangerBg}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBg}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource Danger}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource Success}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StatePillText}">
                                                        <Setter Property="Text" Value="not connected" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                <Setter Property="Text" Value="connected" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <!-- B2: short human values; the supervisor's own
                                     words stay in the tooltip, and a field it did
                                     not report is an em dash, not a sentence. -->
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ADB daemon" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding AdbUidValue}"
                                               Style="{StaticResource RowValueMono}"
                                               ToolTip="{Binding AdbUidTooltip}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Boot" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding BootValueText}"
                                               Style="{StaticResource RowValueMono}"
                                               ToolTip="{Binding BootTooltip}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Magisk lab" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding MagiskLabValue}"
                                               Style="{StaticResource RowValue}"
                                               ToolTip="{Binding MagiskLabTooltip}" />
                                </Grid>
                                <TextBlock Text="{Binding SelectedDevice.LastError}"
                                           Foreground="{DynamicResource Danger}" TextWrapping="Wrap"
                                           FontSize="12" Margin="0,8,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Capture">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,2,0,0">
                                <TextBlock Text="PIPELINE" Style="{StaticResource RowSection}" />
                                <Grid Margin="0,5,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Frame" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding DeliveredFrameText}"
                                               Style="{StaticResource RowValueNumeric}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Frame rate" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding FrameRateText}"
                                               Style="{StaticResource RowValueNumeric}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Dropped" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding DroppedFramesText}"
                                               Style="{StaticResource RowValueNumeric}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Zoom" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ZoomStatus}"
                                               Style="{StaticResource RowValueMono}" />
                                </Grid>

                                <Border Style="{StaticResource RowRule}" />

                                <TextBlock Text="INPUT" Style="{StaticResource RowSection}" />
                                <TextBlock Text="{Binding InputLatencyText}" Style="{StaticResource Mono}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <!-- UX-05: the capability sentence moved to the
                                     stage's bottom-right chip; the Capture tab
                                     keeps the measurement and one pointer line. -->
                                <TextBlock Text="{Binding InputCapabilityDetail}" Style="{StaticResource Caption}"
                                           Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap"
                                           FontSize="11" Margin="0,6,0,0" />

                                <Border Style="{StaticResource RowRule}" />

                                <TextBlock Text="LAST CAPTURE" Style="{StaticResource RowSection}" />
                                <TextBlock Text="{Binding ScreenshotPath}" Style="{StaticResource Mono}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"
                                           ToolTip="{Binding ScreenshotPath}"
                                           Visibility="{Binding ScreenshotPath, Converter={StaticResource TextToVis}}" />
                                <TextBlock Text="No capture in this session." Style="{StaticResource Caption}"
                                           Foreground="{DynamicResource TextTertiary}" Margin="0,6,0,0"
                                           Visibility="{Binding ScreenshotPath, Converter={StaticResource InverseTextToVis}}" />

                                <Border Style="{StaticResource RowRule}" />
                                <TextBlock Text="Multi-touch is not enabled in this phase; the viewport never overlays the guest frame."
                                           Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiary}"
                                           TextWrapping="Wrap" FontSize="11" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Diagnostics">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,2,0,0">
                                <TextBlock Text="DOCTOR" Style="{StaticResource RowSection}" />
                                <TextBlock Text="{Binding DoctorText}" Style="{StaticResource Mono}" TextWrapping="Wrap"
                                           FontSize="11" Margin="0,6,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Copy" Style="{StaticResource ToolButton}"
                                            Command="{Binding CopyDiagnosticsCommand}"
                                            AutomationProperties.Name="Copy diagnostics" />
                                    <Button Content="Cold boot" Style="{StaticResource ToolButton}"
                                            Command="{Binding ColdBootCommand}"
                                            AutomationProperties.Name="Cold boot the guest" />
                                </StackPanel>

                                <Border Style="{StaticResource RowRule}" />

                                <!-- igr-feedback-ux05 item 6: the ROOT LAB eyebrow
                                     keeps a top gap so it is never flush against
                                     the rule (or the scroll edge) above it. -->
                                <TextBlock Text="ROOT LAB" Style="{StaticResource RowSection}" Margin="0,6,0,0" />

                                <!-- UX-05 (part D, 05-root-lab.png): the privileged
                                     surface. It names the exact target guest and
                                     serial, shows the ADB daemon identity and the
                                     Magisk lab state as worded chips, and keeps
                                     every action and confirmation exactly as it
                                     was: the same commands, the same OS consent
                                     dialog before anything is approved. Restyle
                                     only - no root logic lives in this markup. -->
                                <Border Style="{StaticResource InnerCard}" Padding="10" Margin="0,6,0,0"
                                        Background="{DynamicResource PanelAlt}">
                                    <StackPanel>
                                        <TextBlock Text="Target guest" Style="{StaticResource StatusLabel}" />
                                        <TextBlock Text="{Binding RootLabTarget}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,2"
                                                   ToolTip="{Binding RootLabTargetTooltip}" />
                                        <TextBlock Text="ADB root and the Magisk lab apply to this guest only. Nothing here runs without your explicit consent."
                                                   Style="{StaticResource Caption}" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- ADB daemon identity -->
                                <Border Style="{StaticResource InnerCard}" Padding="10" Margin="0,6,0,0"
                                        ToolTip="{Binding AdbRootState}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconShield}" Width="13" Height="13"
                                                      Stretch="Uniform" Stroke="{DynamicResource TextSecondary}"
                                                      StrokeThickness="1.5" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" VerticalAlignment="Center"
                                                      Margin="0,0,7,0" />
                                                <TextBlock Text="ADB daemon" Style="{StaticResource SectionHeader}"
                                                           FontSize="13" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource StatePill}"
                                                    Background="{Binding AdbDaemonChipTone, Converter={StaticResource ToneRoles}, ConverterParameter=bg}">
                                                <TextBlock Text="{Binding AdbDaemonChip}"
                                                           Style="{StaticResource StatePillText}"
                                                           Foreground="{Binding AdbDaemonChipTone, Converter={StaticResource ToneRoles}, ConverterParameter=fg}" />
                                            </Border>
                                        </Grid>
                                        <!-- igr-feedback-ux05 item 6: one text3 line —
                                             "UID · not reported", or the real uid —
                                             instead of a 24 DIP em-dash badge. The
                                             daemon's detail sentence is the tooltip. -->
                                        <TextBlock Text="{Binding AdbUidLine}" Style="{StaticResource Caption}"
                                                   FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                                   ToolTip="{Binding AdbDaemonDetail}" />
                                        <!-- One row: root, unroot, and the quiet
                                             Refresh state. Only ADB root keeps an
                                             outline here (it is the consequential
                                             one); the other two are ghosts. -->
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="ADB root" Style="{StaticResource WarnButton}"
                                                    Height="32" Padding="10,0"
                                                    Command="{Binding AdbRootCommand}" Margin="0,0,6,4"
                                                    ToolTip="Run adb root on the selected guest (confirmation is the supervisor's approval)"
                                                    AutomationProperties.Name="ADB root" />
                                            <Button Content="ADB unroot" Style="{StaticResource GhostButton}"
                                                    Command="{Binding AdbUnrootCommand}" Margin="0,0,6,4"
                                                    ToolTip="Return the guest ADB daemon to the shell user"
                                                    AutomationProperties.Name="ADB unroot" />
                                            <Button Content="Refresh state" Style="{StaticResource GhostButton}"
                                                    Command="{Binding RefreshAdbStateCommand}" Margin="0,0,0,4"
                                                    ToolTip="Re-read the ADB daemon identity"
                                                    AutomationProperties.Name="Refresh ADB daemon state" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Magisk lab state. igr-feedback-ux05 item 6: the raw
                                     "Magisk lab: not_configured" line is gone (it
                                     duplicated the chip's word), and the supervisor's
                                     own sentence is the card's tooltip. -->
                                <Border Style="{StaticResource InnerCard}" Padding="10" Margin="0,6,0,0"
                                        ToolTip="{Binding MagiskState}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Magisk lab" Style="{StaticResource SectionHeader}"
                                                       FontSize="13" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Style="{StaticResource StatePill}"
                                                    Background="{Binding LabDotTone, Converter={StaticResource ToneRoles}, ConverterParameter=bg}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Style="{StaticResource StatePillDot}"
                                                             Fill="{Binding LabDotTone, Converter={StaticResource ToneRoles}, ConverterParameter=fg}" />
                                                    <TextBlock Text="{Binding MagiskLabValue}"
                                                               Style="{StaticResource StatePillText}"
                                                               Foreground="{Binding LabDotTone, Converter={StaticResource ToneRoles}, ConverterParameter=fg}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <!-- Recovery first: an err-soft callout only while a
                                             lab needs it, with the supervisor's own words. -->
                                        <Border Background="{DynamicResource DangerBg}"
                                                BorderBrush="{DynamicResource DangerBorder}" BorderThickness="1"
                                                CornerRadius="6" Padding="8,6" Margin="0,10,0,0"
                                                Visibility="{Binding LabDotTone, Converter={StaticResource StringVis}, ConverterParameter=err}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconWarning}" Width="13" Height="13"
                                                      Stretch="Uniform" Stroke="{DynamicResource Danger}"
                                                      StrokeThickness="1.5" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" VerticalAlignment="Top"
                                                      Margin="0,1,7,0" />
                                                <TextBlock Text="Recovery is required before this guest can start again. Agents stay fenced until stock is restored."
                                                           Style="{StaticResource Caption}" FontSize="11"
                                                           Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <!-- Both of these are consequential, so both keep
                                             their outlines: install is err-soft, recovery
                                             is warn. Same commands, same consent. -->
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="Install Magisk lab…" Style="{StaticResource DangerButton}"
                                                    Height="32" Padding="10,0"
                                                    Command="{Binding MagiskInstallCommand}" Margin="0,0,6,4"
                                                    ToolTip="Patch this guest's boot image with a verified Magisk build (asks for consent)"
                                                    AutomationProperties.Name="Install Magisk lab" />
                                            <Button Content="Recover stock…" Style="{StaticResource WarnButton}"
                                                    Height="32" Padding="10,0"
                                                    Command="{Binding MagiskRecoverCommand}" Margin="0,0,0,4"
                                                    ToolTip="Restore the stock boot image from the verified recovery point (asks for consent)"
                                                    AutomationProperties.Name="Recover stock boot" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Drawer tab bar: always visible, one real destination (Logcat), the
             live retained-line count in tabular mono plus warning/error counts
             only when they exist, and the expand toggle. There is no Activity
             tab because the app has no real activity/event feed to show; the
             tab bar would have to invent one. The Logcat toggle moved here from
             the command bar in UX-04b. -->
        <Border Grid.Row="3" Grid.Column="1" Background="{DynamicResource NavBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="8,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource DrawerTab}" Command="{Binding ToggleLogcatCommand}"
                        Tag="{Binding IsLogcatOpen}"
                        ToolTip="Logcat: the guest log stream"
                        AutomationProperties.Name="Toggle Logcat">
                    <TextBlock Text="Logcat" />
                </Button>
                <!-- Fix pass item 7: the mono count appears only when there are
                     real lines; an empty drawer says 'No lines yet' in text3. -->
                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource MonoNumeric}" TextAlignment="Left" MinWidth="0"
                           FontSize="11" Foreground="{DynamicResource TextTertiary}"
                           Text="{Binding LogCountText}"
                           Visibility="{Binding HasLogEntries, Converter={StaticResource BoolToVis}}"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource Caption}" FontSize="12"
                           Foreground="{DynamicResource TextTertiary}" Text="No lines yet"
                           Visibility="{Binding HasLogEntries, Converter={StaticResource InverseBoolToVis}}" />
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="24"
                        Margin="0" Command="{Binding ToggleLogcatCommand}"
                        ToolTip="Expand or collapse the drawer"
                        AutomationProperties.Name="Expand or collapse the Logcat drawer">
                    <Path Data="{StaticResource IconChevronDown}" Style="{StaticResource Glyph}" Width="12" Height="12">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="DrawerChevron" Angle="0" CenterX="6" CenterY="6" />
                        </Path.RenderTransform>
                    </Path>
                </Button>
            </Grid>
        </Border>

        <!-- Drawer body. Its height is animated in code-behind (220 ms, the
             drawer curve) instead of snapping through a GridLength binding. -->
        <Border x:Name="LogcatHost" Grid.Row="4" Grid.Column="1" Height="0" ClipToBounds="True"
                Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Visibility="{Binding IsLogcatOpen, Converter={StaticResource BoolToVis}}"
                AutomationProperties.Name="Logcat drawer">
            <DockPanel Margin="8">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Width="220" Text="{Binding LogSearch, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search message or tag" AutomationProperties.Name="Search logcat" />
                        <TextBox Width="130" Margin="6,0,0,0" Text="{Binding LogTag, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Filter by tag" AutomationProperties.Name="Filter logcat by tag" />
                        <ComboBox Width="76" Margin="6,0,0,0" ItemsSource="{Binding LogLevels}"
                                  SelectedItem="{Binding LogLevel}" AutomationProperties.Name="Minimum log level" />
                        <CheckBox Content="Pause" Margin="10,0,0,0" IsChecked="{Binding LogPaused}"
                                  VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Clear" Style="{StaticResource ToolButton}" Command="{Binding ClearLogCommand}" />
                        <Button Content="Export" Style="{StaticResource ToolButton}" Command="{Binding ExportLogCommand}" />
                    </StackPanel>
                </Grid>
                <ListView ItemsSource="{Binding LogView}" Background="{DynamicResource LogBg}"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          AutomationProperties.Name="Logcat entries">
                    <ListView.View>
                        <!-- AllowsColumnReorder=False: the themed
                             GridViewColumnHeader template has no
                             PART_FloatingHeaderCanvas, so a drag-reorder would
                             show a blank floating ghost header. -->
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Header="Time" Width="90" DisplayMemberBinding="{Binding Time}" />
                            <GridViewColumn Header="Lvl" Width="36">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Level}" FontFamily="{StaticResource MonoFont}"
                                                   Foreground="{Binding Level, Converter={StaticResource SeverityBrush}}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Tag" Width="150" DisplayMemberBinding="{Binding Tag}" />
                            <GridViewColumn Header="Message" Width="620" DisplayMemberBinding="{Binding Message}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <!-- Status bar (UX-05, MEDIUM 9; fix pass item 8): REAL segments only.
             ADB serial, FPS from the capture stream, GPU mode and the supervisor
             state, then the Agents and Workspace destinations. The CPU, RAM and
             em-dash uid segments are gone: a metric the supervisor does not
             report is not rendered at all. The uid appears only when a real value
             is already known, and that costs no supervisor call. The workspace
             path stays a tooltip, never on screen. -->
        <Border Grid.Row="5" Grid.Column="1" Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconDevice}" Width="11" Height="11" Stretch="Uniform"
                          Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.4"
                          VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBlock Text="ADB" Style="{StaticResource StatusLabel}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding StatusSerial}" Style="{StaticResource StatusValue}"
                               ToolTip="{Binding StatusSerialTooltip}" />

                    <!-- uid only when the supervisor has already reported one. -->
                    <Border Style="{StaticResource StatusDivider}"
                            Visibility="{Binding HasAdbUid, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusUid}" Style="{StaticResource StatusValue}"
                               ToolTip="{Binding AdbUidTooltip}"
                               Visibility="{Binding HasAdbUid, Converter={StaticResource BoolToVis}}" />

                    <Border Style="{StaticResource StatusDivider}" />
                    <TextBlock Text="FPS" Style="{StaticResource StatusLabel}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding TelemetryFpsValue}" Style="{StaticResource StatusValue}"
                               ToolTip="{Binding FrameRateText}" />

                    <Border Style="{StaticResource StatusDivider}" />
                    <Path Data="{StaticResource IconChip}" Width="11" Height="11" Stretch="Uniform"
                          Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.4"
                          VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBlock Text="GPU" Style="{StaticResource StatusLabel}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding StatusGpu}" Style="{StaticResource StatusValue}"
                               ToolTip="{Binding StatusGpuTooltip}" />
                </StackPanel>

                <!-- The operational sentence (drop refusals, install results,
                     refresh notes) has the flexible middle, so it never pushes
                     the metrics or the destinations off the bar. -->
                <Grid Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusSentence}" Style="{StaticResource StatusLabel}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding StatusMessage}" />
                    <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}"
                               Style="{StaticResource StatusLabel}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="380"
                               ToolTip="{Binding ErrorMessage}"
                               Visibility="{Binding ShowStatusError, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource StatusLink}" Click="OnAgents"
                            ToolTip="Agent sessions: pairings, scopes and takeover"
                            AutomationProperties.Name="Agent sessions">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconAgents}" Width="11" Height="11" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="Agents" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource StatusDivider}" />
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,5,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource Danger}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Success}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatusLabel}">
                                <Setter Property="Text" Value="Supervisor not connected" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Text" Value="Supervisor connected" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Style="{StaticResource StatusDivider}" />
                    <!-- Item 11: the workspace temp path is a tooltip, not a
                         status-bar value. -->
                    <Path Data="{StaticResource IconStack}" Width="11" Height="11" Stretch="Uniform"
                          Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.4"
                          VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBlock Text="Workspace" Style="{StaticResource StatusLabel}"
                               VerticalAlignment="Center"
                               ToolTip="{Binding WorkspaceRoot}"
                               AutomationProperties.Name="Workspace root"
                               AutomationProperties.HelpText="{Binding WorkspaceRoot}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
