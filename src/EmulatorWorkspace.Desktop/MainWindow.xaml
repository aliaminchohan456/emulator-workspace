<Window x:Class="EmulatorWorkspace.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EmulatorWorkspace.Desktop.Views"
        Title="Emulator Workspace"
        Width="1180" Height="820" MinWidth="980" MinHeight="620"
        Background="{DynamicResource WindowBg}"
        AllowDrop="True"
        Drop="OnFileDrop" DragOver="OnDragOver" DragEnter="OnDragEnter" DragLeave="OnDragLeave"
        Closing="OnClosing" KeyDown="OnKeyDown" SizeChanged="OnWindowSizeChanged">

    <Window.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVis" />
        <views:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <views:NullToVisibilityConverter x:Key="NullToVis" />
        <views:NullToVisibilityConverter x:Key="NotNullToVis" Invert="True" />
        <views:InverseBoolConverter x:Key="InverseBool" />
        <views:StateToBrushConverter x:Key="StateBrush" />
        <!-- UX-03: stage tone and boot-step colour mapping; both always pair the
             brush with a printed word. -->
        <views:StageToneToBrushConverter x:Key="ToneBrush" />
        <views:StepStateToBrushConverter x:Key="StepBrush" />
        <views:TextToVisibilityConverter x:Key="TextToVis" />
        <views:TextToVisibilityConverter x:Key="InverseTextToVis" Invert="True" />
        <views:ToneToBrushConverter x:Key="ToneRoles" />
        <views:StringEqualsToVisibilityConverter x:Key="StringVis" />
        <views:CountToVisibilityConverter x:Key="CountVis" />
        <!-- UX-06: a path keeps its leaf folder visible in a narrow drawer. -->
        <views:MiddleEllipsisConverter x:Key="MiddleEllipsis" />

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,0,8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- UX-04b shell: a 48 DIP navigation rail item. The active destination
             paints an accent-soft surface and a 2 DIP accent bar on the leading
             edge; the glyph is accent, the rest are text2 and brighten on hover.
             A destination that is not a real view is never rendered as a button. -->
        <Style x:Key="NavRailItem" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="views:Motion.HoverFade" Value="True" />
            <Setter Property="views:RailHover.IsEnabled" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="ActiveSurface" Background="{DynamicResource AccentSoftBg}"
                                    CornerRadius="6" Visibility="Collapsed" />
                            <Border x:Name="HoverLayer" Background="{DynamicResource ChipBg}"
                                    CornerRadius="6" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="PressLayer" Background="{DynamicResource PressedBg}"
                                    CornerRadius="6" Opacity="0" IsHitTestVisible="False" />
                            <Ellipse x:Name="PART_Glow" Width="34" Height="34" Opacity="0"
                                     Fill="{DynamicResource HoverGlow}" IsHitTestVisible="False" />
                            <Border x:Name="ActiveBar" Width="2" Height="18" HorizontalAlignment="Left"
                                    Margin="-7,0,0,0" Background="{DynamicResource Accent}"
                                    CornerRadius="1" Visibility="Collapsed" />
                            <ContentPresenter x:Name="PART_Glyph" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="ActiveSurface" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The current destination: not a button, because clicking it would go
             nowhere. Same geometry and accent treatment as an active rail item. -->
        <Style x:Key="NavRailCurrent" TargetType="Grid">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Inspector rows: label left in text3 at 12, value flush right. Mono is
             applied per row only where the value is an identifier (serial, port,
             ABI); everything else is UI text. Long values ellipsize and keep the
             full string in the tooltip. -->
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RowValue" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MaxWidth" Value="190" />
        </Style>

        <Style x:Key="RowValueMono" TargetType="TextBlock" BasedOn="{StaticResource RowValue}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <!-- B1: mono values are Normal weight even inside a selected tab (the
                 TabItem used to hand SemiBold down to its whole content). -->
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <Style x:Key="RowValueNumeric" TargetType="TextBlock" BasedOn="{StaticResource RowValueMono}">
            <Setter Property="MinWidth" Value="72" />
        </Style>

        <!-- Caps section header inside the inspector: IDENTITY / RESOURCES /
             SESSION, text3 at 11 with the design sheet's tracking. The tracking
             is the cheap Caps.Tracking transform (hair spaces + upper case) and
             it keeps the original word as the accessible name. -->
        <Style x:Key="RowSection" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="views:Caps.Tracking" Value="True" />
        </Style>

        <Style x:Key="RowRule" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="Margin" Value="0,12" />
        </Style>

        <!-- Identity pill (LOW item 10): ok-soft when Running, warn-soft while
             Starting/Stopping, err-soft when Failed, plain chip otherwise. -->
        <Style x:Key="IdentityPill" TargetType="Border" BasedOn="{StaticResource StatePill}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedDevice.State}" Value="Running">
                    <Setter Property="Background" Value="{DynamicResource SuccessBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedDevice.State}" Value="Starting">
                    <Setter Property="Background" Value="{DynamicResource WarningBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedDevice.State}" Value="Stopping">
                    <Setter Property="Background" Value="{DynamicResource WarningBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedDevice.State}" Value="Failed">
                    <Setter Property="Background" Value="{DynamicResource DangerBg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IdentityPillText" TargetType="TextBlock" BasedOn="{StaticResource StatePillText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedDevice.State}" Value="Running">
                    <Setter Property="Foreground" Value="{DynamicResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedDevice.State}" Value="Starting">
                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedDevice.State}" Value="Stopping">
                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedDevice.State}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IdentityPillDot" TargetType="Ellipse" BasedOn="{StaticResource StatePillDot}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedDevice.State}" Value="Running">
                    <Setter Property="Fill" Value="{DynamicResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedDevice.State}" Value="Starting">
                    <Setter Property="Fill" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedDevice.State}" Value="Stopping">
                    <Setter Property="Fill" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedDevice.State}" Value="Failed">
                    <Setter Property="Fill" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The command bar's one accent action keeps the primary geometry but
             sits inside a 30 DIP segmented group, so its radius stays 6 inside
             the group's 8. -->
        <Style x:Key="BarPrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="10,0" />
        </Style>

        <!-- igr-feedback-ux05 item 6: the quiet action in a privileged card.
             Same 32 DIP geometry as ToolButton. igr-feedback-ux06 (UX-05 nit 1):
             a ghost keeps a 1 px stroke-soft edge at rest, so it reads as a
             control rather than as a word, and hover raises the surface through
             the shared ChipBg layer. A consequential action still takes the
             warn/err outline; only the quiet one uses this hairline. -->
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
        </Style>

        <!-- UX-05 stage chip: a small pill that floats on the viewport colour.
             It always carries words (a value or an em dash), never colour alone. -->
        <Style x:Key="StageChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusInnerCard}" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Opacity" Value="0.94" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="StageChipText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Status bar segments: an 11 DIP label in text3 and a tabular mono
             value, separated by 1 px stroke-soft rules. -->
        <Style x:Key="StatusLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StatusValue" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <Style x:Key="StatusDivider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="11" />
            <Setter Property="Margin" Value="9,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
        </Style>

        <!-- A status-bar destination: text-only ghost, no surface until hover. -->
        <Style x:Key="StatusLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="views:Motion.HoverFade" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="HoverLayer" Background="{DynamicResource ChipBg}"
                                    CornerRadius="4" Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A telemetry number: tabular mono at 12 with a 3-character floor so a
             value ticking from 9.8 to 10.2 cannot shift the pill. -->
        <Style x:Key="TelemetryValue" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <!-- igr-feedback-ux05 item 1: the telemetry pill is a RAISED pill (10 DIP
             radius, 1 px stroke-soft edge) rather than a flat field, and it holds
             only what the frame stream measures. The CPU segment is gone at every
             width: the supervisor reports no sample, and "CPU �?"" behind a flat
             underline read like an empty input. -->
        <Style x:Key="TelemetryPillButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelAlt}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="views:Motion.HoverFade" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="B" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource RadiusCard}" />
                            <Border x:Name="PART_Hover" Background="{DynamicResource ChipBg}"
                                    CornerRadius="{StaticResource RadiusCard}" Opacity="0"
                                    IsHitTestVisible="False" />
                            <Border x:Name="PART_Press" Background="{DynamicResource PressedBg}"
                                    CornerRadius="{StaticResource RadiusCard}" Opacity="0"
                                    IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- UX-05 boot stepper item: done = ok fill with a check, current =
             accent with a 1.2 s pulse ring (suppressed when Windows reports
             reduced motion), pending = text3 hollow. One style shared by the
             three steps so their geometry cannot drift. -->
        <Style x:Key="BootStep" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="12" Height="12" VerticalAlignment="Top" Margin="0,2,0,0">
                                <Ellipse x:Name="Ring" Width="12" Height="12" StrokeThickness="1"
                                         Stroke="{DynamicResource Accent}" Opacity="0" Visibility="Collapsed"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="RingScale" ScaleX="0.8" ScaleY="0.8" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="Dot" Width="10" Height="10" StrokeThickness="1.4"
                                         Stroke="{DynamicResource TextTertiary}" Fill="Transparent"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Path x:Name="Check" Data="{StaticResource IconCheck}" Width="8" Height="8"
                                      Stretch="Uniform" Visibility="Collapsed"
                                      Stroke="{DynamicResource AccentText}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource SectionHeader}"
                                           FontSize="12" LineHeight="16" />
                                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                                           FontSize="11" LineHeight="15"
                                           Foreground="{DynamicResource TextTertiary}" />
                            </StackPanel>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="done">
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Success}" />
                                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Success}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="active">
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Ring" Property="Opacity" Value="0.55" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="unknown">
                                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource TextSecondary}" />
                            </DataTrigger>
                            <!-- The pulse: 1.2 s ease, and only when Windows reports
                                 client-area animation. Reduced motion keeps the
                                 static 55 % ring, which still reads as "current". -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding State}" Value="active" />
                                    <Condition Binding="{Binding MotionAllowed, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                               Value="True" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="StepPulse">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Ring"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.95" To="0" Duration="0:0:1.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RingScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             From="0.75" To="1.9" Duration="0:0:1.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RingScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             From="0.75" To="1.9" Duration="0:0:1.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="StepPulse" />
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 1 px stroke-soft divider inside the floating toolbar pill. -->
        <Style x:Key="PillDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="8,3" />
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
        </Style>

        <!-- Drawer tab in the always-visible bar above the status line: a text
             tab with a 2 DIP accent underline while its drawer is open. -->
        <Style x:Key="DrawerTab" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="views:Motion.HoverFade" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="HoverLayer" Background="{DynamicResource ChipBg}"
                                    CornerRadius="6" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="PressLayer" Background="{DynamicResource PressedBg}"
                                    CornerRadius="6" Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Opacity="0"
                                    Background="{DynamicResource Accent}" CornerRadius="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="Underline" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- UX-08 Logcat drawer. The dock is a bottom drawer on the panel surface,
             so it keeps the 1 DIP specular top edge the other floating surfaces
             carry; everything inside it reuses a shared token or control style and
             only the log-specific geometry is new. -->

        <!-- One filter field: raised surface, 1 px input edge, a leading line icon
             and a mono placeholder, because every value typed here is matched
             against the guest's own mono log text. -->
        <Style x:Key="LogField" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- A level chip is a toggle: a colour dot plus the level's word. On, it
             is raised (panel surface) with a 1 px stroke; off, it drops the fill
             and the label falls to text3, with the dot dimmed so the level stays
             identifiable. The same chip serves the dock and the page. -->
        <Style x:Key="LogLevelChip" TargetType="ToggleButton">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Background" Value="{DynamicResource PanelAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Body" CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" />
                            <ContentPresenter x:Name="Chip" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Body" Property="Background" Value="Transparent" />
                                <Setter TargetName="Body" Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{DynamicResource ChipBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource FocusRing}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The dot inside a level chip: the level's own colour when the chip is
             on, faded to 40 % when it is off (never a different colour, so the
             legend stays learnable). -->
        <Style x:Key="LogLevelDot" TargetType="Border">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource TextSecondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A 30 DIP ghost icon action inside the 36 DIP toolbar. Same hover layer,
             press layer, 1.07 glyph scale over the accent-soft radial and 2 px
             accent focus ring as every other icon button; only the size is local. -->
        <Style x:Key="LogIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>

        <!-- Pause is a toggle, so it is a ToggleButton and needs its own template;
             it is the same geometry as LogIconButton plus a checked state (accent
             glyph on an accent-soft surface) so the paused stream is visible
             without reading the icon. -->
        <Style x:Key="LogToggleIconButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="views:Motion.HoverFade" Value="True" />
            <Setter Property="views:RailHover.IsEnabled" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="PART_Glow" Width="30" Height="30" Opacity="0"
                                     Fill="{DynamicResource HoverGlow}" IsHitTestVisible="False" />
                            <Border x:Name="B" Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource RadiusControl}" />
                            <Border x:Name="PART_Hover" Background="{DynamicResource ChipBg}"
                                    CornerRadius="{StaticResource RadiusControl}" Opacity="0"
                                    IsHitTestVisible="False" />
                            <Border x:Name="PART_Press" Background="{DynamicResource PressedBg}"
                                    CornerRadius="{StaticResource RadiusControl}" Opacity="0"
                                    IsHitTestVisible="False" />
                            <ContentPresenter x:Name="PART_Glyph" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentSoftBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One log row: 24 DIP, no margin, hover on the row surface, selection in
             the shared selection tint and a 1 DIP accent edge while it holds
             keyboard focus. The row template supplies the content. -->
        <Style x:Key="LogRowItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="views:Motion.HoverFade" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="B" Background="Transparent" BorderBrush="Transparent"
                                    BorderThickness="1" />
                            <!-- igr-feedback-ux11 new nit 9: only E/F earn a full-row
                                 tint, and only at half of the err-soft token (~6 %);
                                 W keeps the badge and the tag as its colour. -->
                            <Border x:Name="Tone" Background="{DynamicResource DangerBg}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="PART_Hover" Background="{DynamicResource HoverBg}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="E">
                                <Setter TargetName="Tone" Property="Opacity" Value="0.5" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="F">
                                <Setter TargetName="Tone" Property="Opacity" Value="0.5" />
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource SelectionBg}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource FocusRing}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The table's column names: 11 DIP, text3, aligned to the row columns by
             the same fixed widths. The page prints them in caps; the dock keeps
             the same word in sentence case. -->
        <Style x:Key="LogHeaderCell" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The level badge is a 14 DIP square: neutral for V/D (text3/text2), the
             soft tint for I/W/E with the letter in the level's own colour. Every
             colour is a DynamicResource chosen by a DataTrigger, so a live theme
             switch repaints it (a converter would hand back the brush it resolved
             before the swap). -->
        <Style x:Key="LogLevelGlyph" TargetType="Border">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ChipBg}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="I">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="W">
                    <Setter Property="Background" Value="{DynamicResource WarningBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="E">
                    <Setter Property="Background" Value="{DynamicResource DangerBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="F">
                    <Setter Property="Background" Value="{DynamicResource DangerBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="A">
                    <Setter Property="Background" Value="{DynamicResource DangerBg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LogLevelGlyphText" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="V">
                    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="I">
                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="W">
                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="E">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="F">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="A">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The page's message text: text1 at rest, err when the line is one, so a
             loud line is loud by its own words rather than a row fill.
             igr-feedback-ux11 new nit 9: a W line keeps its message in text1; only
             its badge and tag carry the warning colour. -->
        <Style x:Key="LogMessageText" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="E">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="F">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="A">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A warning row's tag is the second coloured element (the badge is the
             first); everything else stays text2. -->
        <Style x:Key="LogTagText" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="W">
                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The full page's card: a 12 radius surface on the viewport colour, one
             1 px stroke-soft edge, sticky header inside. -->
        <Style x:Key="LogPageCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource LogBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusDialog}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <!-- One 28 DIP page row: no zebra, a 1 px stroke-soft divider, hover raises
             the fill and selection uses the shared accent-soft selection tint. -->
        <Style x:Key="LogPageRowItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="views:Motion.HoverFade" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="B" Background="Transparent" BorderBrush="Transparent"
                                    BorderThickness="1" />
                            <Border x:Name="PART_Hover" Background="{DynamicResource PanelAlt}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <Border Height="1" VerticalAlignment="Bottom"
                                    Background="{DynamicResource BorderSubtle}" />
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource SelectionBg}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource FocusRing}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The stream state chip's tone ("ok" / "warning" / "info") to the soft
             tint and the dot, again through DynamicResource so the light theme and
             High Contrast repaint it live. -->
        <Style x:Key="LogStateChip" TargetType="Border" BasedOn="{StaticResource StatePill}">
            <Setter Property="Background" Value="{DynamicResource PanelAlt}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LogState.Tone}" Value="ok">
                    <Setter Property="Background" Value="{DynamicResource SuccessBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LogState.Tone}" Value="warning">
                    <Setter Property="Background" Value="{DynamicResource WarningBg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LogStateDot" TargetType="Ellipse" BasedOn="{StaticResource StatePillDot}">
            <Setter Property="Fill" Value="{DynamicResource TextTertiary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LogState.Tone}" Value="ok">
                    <Setter Property="Fill" Value="{DynamicResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LogState.Tone}" Value="warning">
                    <Setter Property="Fill" Value="{DynamicResource Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The page's stream chip: ok-soft "Live", warn-soft "Paused", neutral
             otherwise. The dot pulses only while the stream is live and only when
             Windows reports animations are enabled. -->
        <Style x:Key="LogPageStateChip" TargetType="Border" BasedOn="{StaticResource StatePill}">
            <Setter Property="Background" Value="{DynamicResource PanelAlt}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LogPageState.Tone}" Value="ok">
                    <Setter Property="Background" Value="{DynamicResource SuccessBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LogPageState.Tone}" Value="warning">
                    <Setter Property="Background" Value="{DynamicResource WarningBg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LogPageStateDot" TargetType="Ellipse" BasedOn="{StaticResource StatePillDot}">
            <Setter Property="Fill" Value="{DynamicResource TextTertiary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LogPageState.Tone}" Value="ok">
                    <Setter Property="Fill" Value="{DynamicResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LogPageState.Tone}" Value="warning">
                    <Setter Property="Fill" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding LogPageState.Tone}" Value="ok" />
                        <Condition Binding="{Binding MotionEnabled}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard x:Name="LogLivePulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.35" Duration="0:0:0.9">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="LogLivePulse" />
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The page's paused chip: warn-soft, a dot and the real buffered count. -->
        <Style x:Key="LogPausedChip" TargetType="Border" BasedOn="{StaticResource StatePill}">
            <Setter Property="Background" Value="{DynamicResource WarningBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- UX-06 settings slide-over (polish addendum item 8). It reuses the
             two-layer floating shadow (wide ambient behind, tight key on the
             surface), the same 12 radius on the leading corners and the same
             specular edge, now also run down the left edge so the panel separates
             from the scrim without a hard line. -->
        <Style x:Key="SettingsDrawerAmbient" TargetType="Border">
            <!-- PanelBg, not PopupBg: the shell has to sit below its own cards.
                 PopupBg equals PanelAlt in the dark sheet, which would make a
                 raised card invisible against the shell. -->
            <Setter Property="Background" Value="{DynamicResource PanelBg}" />
            <Setter Property="CornerRadius" Value="12,0,0,12" />
            <Setter Property="Effect" Value="{DynamicResource FloatingShadowAmbient}" />
        </Style>

        <Style x:Key="SettingsDrawerSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="CornerRadius" Value="12,0,0,12" />
            <Setter Property="Effect" Value="{DynamicResource FloatingShadowKey}" />
        </Style>

        <!-- One settings group: a raised 12 radius card with a hairline edge on
             the drawer's panel surface, so the group reads as a surface rather
             than a stretch of white space. -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusDialog}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- Rows inside a card are separated by stroke-soft dividers, never by
             gaps: the divider is inset to the text column, so the card keeps a
             clean outer edge. -->
        <Style x:Key="SettingsDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="SettingsRowLabel" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingsRowDescription" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- A read-only policy value (a Windows setting the drawer only reports). -->
        <Style x:Key="SettingsRowValue" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- UX-07 fix pass: a read-only value is a neutral raised chip, not bare
             text, so "Full"/"Off" reads as a fact the drawer reports rather than
             as a control the operator can change. The chip sits on a PanelAlt
             card, so ChipBg is one step raised instead of the same colour. -->
        <Style x:Key="SettingsReadOnlyChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ChipBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- The ok-soft companion chip the acceleration row prints when the
             engine probe passed. -->
        <Style x:Key="SettingsOkChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SuccessBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- A doctor value: mono, one line, middle ellipsis (the converter keeps
             both ends of a long path or package id), full text in the tooltip. -->
        <Style x:Key="SettingsDoctorValue" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <!-- Segmented tabs inside the drawer. One WindowBg surface holds the tab
             headers, which are 6 DIP pills inside 3 DIP of padding (outer 8 =
             inner 5 + padding, close enough that the corners read concentric);
             the selected pill is accent-soft, the same selected treatment the
             inspector tabs use. TabPanel is the items host so Tab/arrow keys
             keep their standard behaviour. Three real groups fit, so there is no
             More overflow and no scrolling strip. -->
        <Style x:Key="SettingsTabs" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border HorizontalAlignment="Left" Background="{DynamicResource WindowBg}"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusInnerCard}" Padding="3"
                                    SnapsToDevicePixels="True">
                                <TabPanel IsItemsHost="True" />
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                              ContentSource="SelectedContent" Margin="0,14,0,0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Pill" Background="Transparent" Padding="12,4"
                                CornerRadius="{StaticResource RadiusControl}">
                            <!-- The weight lives on the presenter, not the
                                 TabItem: FontWeight inherits, and a SemiBold
                                 TabItem would embolden the whole tab body. -->
                            <ContentPresenter x:Name="H" ContentSource="Header" RecognizesAccessKey="True"
                                              TextElement.FontWeight="Normal"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource ChipBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <!-- igr-feedback-ux11 item 6: the active segment is a
                                     raised fill with text1, no border; the accent
                                     ring stays a keyboard-focus signal only. -->
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource PanelAlt}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Setter TargetName="H" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Theme segmented control: the card is raised, so the group sits on a
             PanelBg surface with 2 DIP of padding around 6 DIP pills (outer 8 =
             inner 6 + 2). Only the two real modes are offered. -->
        <Style x:Key="SettingsSegment" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusInnerCard}" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="SettingsSegmentRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" Background="Transparent" Padding="12,4"
                                CornerRadius="{StaticResource RadiusControl}">
                            <ContentPresenter x:Name="H" ContentSource="Content" RecognizesAccessKey="True"
                                              TextElement.FontWeight="Normal"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource ChipBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentSoftBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                <Setter TargetName="H" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A shortcut key in Cascadia Mono: the design sheet's key chip. The chip
             sits on a PanelAlt card, so its surface is ChipBg, not PanelAlt.
             UX-07 moved this pair to Themes/Common.xaml so the command palette
             prints the same chip; the key and its look are unchanged. -->

        <!-- A path in the drawer: mono, one line, middle ellipsis (the converter
             keeps the leaf folder) and the full string in the tooltip. No
             editable box, because this build cannot change the workspace root. -->
        <Style x:Key="SettingsPathValue" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- 28 DIP path action (copy, open folder): the spec's path row size,
             with the shared hover/press layers, focus ring and 1.07 glyph scale. -->
        <Style x:Key="SettingsIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <!-- 32 DIP close control in the 56 DIP header. -->
        <Style x:Key="SettingsCloseButton" TargetType="Button" BasedOn="{StaticResource SettingsIconButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <!-- UX-04b: the 48 DIP destination rail replaces the permanent
                 device column. It spans every row, so the rail is the window's
                 left edge from the command bar to the status bar. -->
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- UX-03: a persistent error bar sits between the command bar and
                 the body so it never covers the guest frame. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <!-- UX-04b: a persistent drawer tab bar, then the drawer itself. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Destination rail. Only real destinations appear: Studio (the view
             this window is), Devices (the U-04 library window), Logcat (the
             drawer), Agents (the sessions window) and Root Lab (the lab section
             of the inspector's Diagnostics tab). UX-06 adds Settings at the
             bottom: it opens the in-window settings drawer, not a separate OS
             window, so the rail keeps exactly one surface per destination. -->
        <Border x:Name="NavRail" Grid.Column="0" Grid.Row="0" Grid.RowSpan="6"
                Background="{DynamicResource NavBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,8">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,2">
                    <Button Style="{StaticResource NavRailItem}" Click="OnOpenPalette"
                            ToolTip="Search commands (Ctrl+K)" AutomationProperties.Name="Search commands">
                        <Path Data="{StaticResource IconSearch}" Style="{StaticResource Glyph}" />
                    </Button>
                    <Button Style="{StaticResource NavRailItem}" Command="{Binding ToggleThemeCommand}"
                            ToolTip="Theme"
                            AutomationProperties.Name="Switch theme">
                        <Path Data="{StaticResource IconTheme}" Style="{StaticResource Glyph}" />
                    </Button>
                    <Button Style="{StaticResource NavRailItem}" Command="{Binding RefreshCommand}"
                            Margin="0,0,0,4" ToolTip="Refresh"
                            AutomationProperties.Name="Refresh workspace state">
                        <Path Data="{StaticResource IconRefresh}" Style="{StaticResource Glyph}" />
                    </Button>
                    <!-- UX-06: the drawer's opener. 36 DIP icon button with the
                         shared hover/press layers, the 1.07 glyph scale over the
                         accent-soft radial and the 2 px keyboard focus ring; the
                         accent-soft surface marks it while the drawer is open
                         (Tag is set in code with the drawer state, the same flag
                         the drawer's own open/close writes). -->
                    <Button x:Name="SettingsRailButton" Style="{StaticResource NavRailItem}" Margin="0"
                            Click="OnOpenSettings"
                            ToolTip="Settings (Esc)"
                            AutomationProperties.Name="Settings">
                        <Path Data="{StaticResource IconSettings}" Style="{StaticResource Glyph}" />
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top">
                    <!-- Current view: no button, so it cannot pretend to navigate. While
                         the full Logcat page is open it is the page - not Studio - that
                         carries the active treatment, and Studio becomes the way back. -->
                    <Grid Style="{StaticResource NavRailCurrent}"
                          Visibility="{Binding IsStudioVisible, Converter={StaticResource BoolToVis}}"
                          ToolTip="Studio: the running guest view"
                          AutomationProperties.Name="Studio (current view)">
                        <Border Background="{DynamicResource AccentSoftBg}" CornerRadius="6" />
                        <Border Width="2" Height="18" HorizontalAlignment="Left" Margin="-6,0,0,0"
                                Background="{DynamicResource Accent}" CornerRadius="1" />
                        <Path Data="{StaticResource IconMonitor}" Stroke="{DynamicResource Accent}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Width="16" Height="16" Stretch="None"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <Button Style="{StaticResource NavRailItem}" Margin="0,0,0,4"
                            Command="{Binding CloseLogcatPageCommand}"
                            Visibility="{Binding IsLogcatPage, Converter={StaticResource BoolToVis}}"
                            ToolTip="Studio: the running guest view"
                            AutomationProperties.Name="Back to Studio">
                        <Path Data="{StaticResource IconMonitor}" Style="{StaticResource Glyph}" />
                    </Button>

                    <Grid Margin="0,0,0,4">
                        <Button Style="{StaticResource NavRailItem}" Margin="0" Click="OnDevices"
                                ToolTip="Devices"
                                AutomationProperties.Name="Device library">
                            <Path Data="{StaticResource IconGrid}" Style="{StaticResource Glyph}" />
                        </Button>
                        <!-- Count badge from the live instance list. -->
                        <Border Background="{DynamicResource Accent}" CornerRadius="999"
                                MinWidth="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-3,-3,0" Padding="3,0" IsHitTestVisible="False"
                                Visibility="{Binding Devices.Count, Converter={StaticResource CountVis}}">
                            <TextBlock Text="{Binding Devices.Count}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AccentText}" />
                        </Border>
                    </Grid>

                    <Button Style="{StaticResource NavRailItem}" Command="{Binding OpenLogcatPageCommand}"
                            Tag="{Binding LogcatRailActive}"
                            ToolTip="Logcat"
                            AutomationProperties.Name="Logcat page">
                        <Path Data="{StaticResource IconLogs}" Style="{StaticResource Glyph}" />
                    </Button>

                    <Button Style="{StaticResource NavRailItem}" Click="OnAgents"
                            ToolTip="Agents"
                            AutomationProperties.Name="Agent sessions">
                        <Path Data="{StaticResource IconAgents}" Style="{StaticResource Glyph}" />
                    </Button>

                    <Grid Margin="0,0,0,4">
                        <Button Style="{StaticResource NavRailItem}" Margin="0" Click="OnRootLab"
                                ToolTip="Root Lab"
                                AutomationProperties.Name="Root Lab">
                            <Path Data="{StaticResource IconShield}" Style="{StaticResource Glyph}" />
                        </Button>
                        <!-- Status dot only when the supervisor reports a real lab
                             state: ok when prepared, warn when recovery is due. -->
                        <Ellipse Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,1,-1,0" IsHitTestVisible="False">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Fill" Value="{DynamicResource Success}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LabDotTone}" Value="ok">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Fill" Value="{DynamicResource Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LabDotTone}" Value="warn">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Fill" Value="{DynamicResource Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LabDotTone}" Value="err">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Fill" Value="{DynamicResource Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                </StackPanel>
                <Grid />
            </DockPanel>
        </Border>

        <!-- Command bar: device identity on the left, the live telemetry pill,
             then the device commands as segmented icon groups. One accent action
             (Install APK), everything else ghost. Identity is a fixed 2-line grid
             (18 + 16) so the name, the state pill and the subtitle sit on clean
             baselines and nothing clips. -->
        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource NavBg}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Identity (UX-05 fix pass, item 4): a 32 DIP device tile
                     centred against BOTH lines, the name at 14 SemiBold, the state
                     chip on the same baseline 8 DIP to its right, and the
                     'API · ABI · serial' subtitle at 12 in text3. The block is
                     content-sized and left-aligned, so the chip always sits 8 DIP
                     from the name instead of drifting to the far edge. -->
                <Grid Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition Height="17" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.RowSpan="2" Width="32" Height="32" CornerRadius="8"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentSoftBg}"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                        <Path Data="{StaticResource IconDevice}" Style="{StaticResource Glyph}"
                              Width="18" Height="18" Stretch="Uniform"
                              Stroke="{DynamicResource Accent}" />
                    </Border>
                    <Grid Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                          HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- The name keeps a bounded width so a long guest name
                             ellipsizes instead of pushing the state pill away. -->
                        <TextBlock Grid.Column="0" Text="{Binding SelectedDevice.Name, FallbackValue=No device selected, TargetNullValue=No device selected}"
                                   FontFamily="{StaticResource UiFont}" FontSize="14" FontWeight="SemiBold"
                                   LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   TextTrimming="CharacterEllipsis" MaxWidth="180"
                                   ToolTip="{Binding SelectedDevice.Name}" />
                        <Border Grid.Column="1" Style="{StaticResource IdentityPill}" Margin="8,0,0,0"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource IdentityPillDot}" />
                                <TextBlock Text="{Binding SelectedDevice.StateLabel}"
                                           Style="{StaticResource IdentityPillText}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDevice.Subtitle}" Style="{StaticResource Caption}"
                               Margin="10,0,0,0"
                               Foreground="{DynamicResource TextTertiary}" FontSize="12"
                               LineHeight="17" LineStackingStrategy="BlockLineHeight"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               TextTrimming="CharacterEllipsis" MaxWidth="240"
                               ToolTip="{Binding SelectedDevice.Subtitle}" />
                </Grid>

                <!-- UX-05 telemetry micro-pill (addendum 7, reshaped by
                     igr-feedback-ux05 item 1): a raised 10 DIP pill with a 1 px
                     stroke-soft edge, "FPS n" in tabular mono, and a 40 x 14
                     sparkline to its right drawn ONLY once there are two or more
                     real samples. The CPU segment is gone at every width (no
                     backend), and below 1120 DIP the pill keeps just "FPS n".
                     Clicking opens the popover with the fuller frame metrics. -->
                <Button x:Name="TelemetryPill" Grid.Column="1" VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        Click="OnTelemetryClick"
                        ToolTip="{Binding TelemetryTooltip}"
                        AutomationProperties.Name="Live telemetry"
                        AutomationProperties.HelpText="{Binding TelemetryTooltip}">
                    <!-- UX-11: at 1024 DIP the pill steps aside so the command bar
                         keeps one clean row; the status bar still prints the live
                         frame rate, so no measured value is lost. -->
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TelemetryPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NarrowLayout, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="FPS" Style="{StaticResource StatusLabel}" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding TelemetryFpsValue}" Style="{StaticResource TelemetryValue}" />
                        <!-- The sparkline host carries the responsive rule; the
                             polyline itself is drawn only with 2+ samples, so an
                             empty stream reserves no space at all. -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding CompactTelemetry, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}">
                            <Grid Width="40" Height="14" Margin="8,0,0,0" VerticalAlignment="Center"
                                  Visibility="{Binding HasSpark, Converter={StaticResource BoolToVis}}">
                                <Polygon Points="{Binding SparkAreaPoints}"
                                         Fill="{DynamicResource Accent}" Opacity="0.12" />
                                <Polyline x:Name="TelemetrySpark" Points="{Binding SparkPoints}"
                                          Stroke="{DynamicResource Accent}" StrokeThickness="1.5"
                                          StrokeLineJoin="Round" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Popup x:Name="TelemetryPopover" PlacementTarget="{Binding ElementName=TelemetryPill}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       HorizontalOffset="-120" VerticalOffset="6" PopupAnimation="None">
                    <views:FloatingSurface Style="{StaticResource FloatingCard}" Width="260"
                                           AutomationProperties.Name="Telemetry detail">
                        <StackPanel>
                            <TextBlock Text="FRAME PIPELINE" Style="{StaticResource RowSection}" />
                            <Grid Margin="0,6,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Frame rate" Style="{StaticResource RowLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding FrameRateText}"
                                           Style="{StaticResource RowValueNumeric}" />
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Delivered" Style="{StaticResource RowLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding DeliveredFrameText}"
                                           Style="{StaticResource RowValueNumeric}" />
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dropped" Style="{StaticResource RowLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding DroppedFramesText}"
                                           Style="{StaticResource RowValueNumeric}" />
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Guest display" Style="{StaticResource RowLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding GuestDisplayText}"
                                           Style="{StaticResource RowValueNumeric}" />
                            </Grid>
                            <Border Style="{StaticResource RowRule}" Margin="0,8" />
                            <TextBlock Text="{Binding TelemetrySamplingNote}" Style="{StaticResource Caption}"
                                       FontSize="11" Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </views:FloatingSurface>
                </Popup>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- restart | power (fix pass item 5): restart is the
                         rotate-ccw icon that used to be a text button, so the
                         segment reads restart | stop. Rotate itself lives in the
                         floating pill; no command was lost, and the duplicate in
                         the bar is retired rather than repeated a third time. -->
                    <Border Style="{StaticResource SegmentGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SegmentButton}" Command="{Binding RestartCommand}"
                                    ToolTip="Restart the selected guest" AutomationProperties.Name="Restart device">
                                <Path Data="{StaticResource IconRestart}" Style="{StaticResource Glyph}" />
                            </Button>
                            <Border Style="{StaticResource SegmentDivider}" />
                            <Button Style="{StaticResource SegmentButton}" Command="{Binding PrimaryActionCommand}"
                                    ToolTip="{Binding PrimaryActionText}"
                                    AutomationProperties.Name="Primary device action">
                                <Path Data="{StaticResource IconPower}" Style="{StaticResource Glyph}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- install APK | screenshot: the bar's one accent action. -->
                    <Border Style="{StaticResource SegmentGroup}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BarPrimary}" Command="{Binding InstallApkCommand}"
                                    ToolTip="Install an APK on the selected guest (drop a file on the viewport too)"
                                    AutomationProperties.Name="Install APK">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconInstall}" Width="16" Height="16" Stretch="None"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Install APK" VerticalAlignment="Center">
                                        <!-- UX-11: icon-only at 1024, with the
                                             name and the tooltip kept intact. -->
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NarrowLayout, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                 Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Border Style="{StaticResource SegmentDivider}" />
                            <Button Style="{StaticResource SegmentButton}" Command="{Binding ScreenshotCommand}"
                                    IsEnabled="{Binding IsGuestInteractive}"
                                    ToolTip="Capture a PNG of the selected guest" AutomationProperties.Name="Screenshot">
                                <Path Data="{StaticResource IconScreenshot}" Style="{StaticResource Glyph}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- fit | 1:1 | zoom out | zoom in. UX-11: the first group to
                         overflow at 1024; it moves into the "..." menu below. -->
                    <Border Margin="8,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SegmentGroup}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NarrowLayout, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SegmentButton}" Click="OnFit"
                                    ToolTip="Fit to window (Ctrl+wheel zooms)" AutomationProperties.Name="Fit to window">
                                <Path Data="{StaticResource IconFit}" Style="{StaticResource Glyph}" />
                            </Button>
                            <Border Style="{StaticResource SegmentDivider}" />
                            <Button Style="{StaticResource SegmentButton}" Click="OnActualSize"
                                    ToolTip="Actual size (1:1)" AutomationProperties.Name="Actual size">
                                <Path Data="{StaticResource IconActualSize}" Style="{StaticResource Glyph}" />
                            </Button>
                            <Border Style="{StaticResource SegmentDivider}" />
                            <Button Style="{StaticResource SegmentButton}" Click="OnZoomOut"
                                    ToolTip="Zoom out (Ctrl+wheel)" AutomationProperties.Name="Zoom out">
                                <Path Data="{StaticResource IconMinus}" Style="{StaticResource Glyph}" />
                            </Button>
                            <Button Style="{StaticResource SegmentButton}" Click="OnZoomIn"
                                    ToolTip="Zoom in (Ctrl+wheel)" AutomationProperties.Name="Zoom in">
                                <Path Data="{StaticResource IconPlus}" Style="{StaticResource Glyph}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- pop out | fullscreen. UX-11: the second overflow group. -->
                    <Border Margin="8,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SegmentGroup}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NarrowLayout, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SegmentButton}" Click="OnPopOut"
                                    ToolTip="Pop out the viewport" AutomationProperties.Name="Pop-out">
                                <Path Data="{StaticResource IconPopOut}" Style="{StaticResource Glyph}" />
                            </Button>
                            <Border Style="{StaticResource SegmentDivider}" />
                            <Button Style="{StaticResource SegmentButton}" Click="OnFullscreen"
                                    ToolTip="Fullscreen (F11)" AutomationProperties.Name="Fullscreen">
                                <Path Data="{StaticResource IconFullscreen}" Style="{StaticResource Glyph}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- details | focus (fix pass item 5): the two trailing icons
                         are one 'view' segment and keep their tooltips and their
                         existing Click handlers. -->
                    <Border Style="{StaticResource SegmentGroup}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SegmentButton}" Click="OnToggleDetails"
                                    ToolTip="Toggle the details panel" AutomationProperties.Name="Toggle details">
                                <Path Data="{StaticResource IconDetails}" Style="{StaticResource Glyph}" />
                            </Button>
                            <Button Style="{StaticResource SegmentButton}" Click="OnToggleFocusView"
                                    ToolTip="Focus view: hide the rail, details and Logcat"
                                    AutomationProperties.Name="Focus view">
                                <Path Data="{StaticResource IconFocus}" Style="{StaticResource Glyph}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- UX-11: the overflow for the two lowest-priority groups
                         (zoom first, then the window tools). They keep their exact
                         commands and handlers; only where they live changes, and
                         only at 1024. Install APK and the power action never
                         overflow. -->
                    <Border Style="{StaticResource SegmentGroup}" Margin="8,0,0,0"
                            Visibility="{Binding NarrowLayout, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <Button x:Name="BarOverflowButton" Style="{StaticResource SegmentButton}"
                                Click="OnOverflowMenu" ToolTip="More view tools"
                                AutomationProperties.Name="More view tools">
                            <TextBlock Text="&#x2026;" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,-4,0,0" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Fit to window" Click="OnFit"
                                              AutomationProperties.Name="Fit to window" />
                                    <MenuItem Header="Actual size (1:1)" Click="OnActualSize"
                                              AutomationProperties.Name="Actual size" />
                                    <MenuItem Header="Zoom out" Click="OnZoomOut"
                                              AutomationProperties.Name="Zoom out" />
                                    <MenuItem Header="Zoom in" Click="OnZoomIn"
                                              AutomationProperties.Name="Zoom in" />
                                    <Separator />
                                    <MenuItem Header="Pop out the viewport" Click="OnPopOut"
                                              AutomationProperties.Name="Pop-out" />
                                    <MenuItem Header="Fullscreen (F11)" Click="OnFullscreen"
                                              AutomationProperties.Name="Fullscreen" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- UX-03 typed error bar, UX-04b refinement: err-soft surface (~12%
             tint), 1 px error border at 35%, a 3 px error bar on the leading
             edge, title in text, body in text2, one sentence plus one next safe
             action, and the long technical string behind Copy details. Inset
             8 px from the window edges and sitting above the viewport card, so
             it never covers the frame. It stays until dismissed. -->
        <Border Grid.Row="1" Grid.Column="1" Margin="8,6,8,0" Background="{DynamicResource DangerBg}"
                BorderBrush="{DynamicResource DangerBorder}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusCard}"
                Visibility="{Binding HasErrorBar, Converter={StaticResource BoolToVis}}"
                AutomationProperties.Name="Error">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource Danger}" CornerRadius="10,0,0,10" />
                <Path Grid.Column="1" Data="{StaticResource IconWarning}" Stroke="{DynamicResource Danger}"
                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" Width="16" Height="16" Stretch="None"
                      VerticalAlignment="Top" Margin="12,12,10,0" />
                <StackPanel Grid.Column="2" Margin="0,10,12,10">
                    <TextBlock Text="{Binding ErrorBarTitle}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorBarText}" Style="{StaticResource Body}"
                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding ErrorBarAction}" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,8,8,0">
                    <Button Content="Retry" Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}"
                            ToolTip="Re-read the supervisor, the SDK report and the device state"
                            Visibility="{Binding ShowErrorRetry, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Retry the failed operation" />
                    <Button Content="Copy details" Style="{StaticResource ToolButton}"
                            Command="{Binding CopyErrorDetailsCommand}"
                            ToolTip="Copy the full technical message"
                            AutomationProperties.Name="Copy error details" />
                    <Button Content="Dismiss" Style="{StaticResource ToolButton}"
                            Command="{Binding DismissErrorCommand}" Margin="0"
                            AutomationProperties.Name="Dismiss the error" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid x:Name="BodyGrid" Grid.Row="2" Grid.Column="1" Margin="8">
            <Grid.ColumnDefinitions>
                <!-- UX-04b: the device column and its splitter are retired; the
                     rail above is the only navigation. Zero-width columns keep
                     every existing Grid.Column index and the viewport geometry
                     untouched. -->
                <ColumnDefinition Width="0" MinWidth="0" />
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="318" MinWidth="250" />
                <!-- UX-11: 0 wide at wide sizes. At 1024 it holds the 48 DIP
                     inspector strip that reopens the collapsed panel. -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Viewport (B3): in the light theme the stage keeps the 02/17 feel,
                 a soft stroke-soft edge over the viewport colour rather than a
                 full-strength panel border. UX-05 turns it into a stage: a
                 static ambient glow, a 1.5 % noise dither, a decorative device
                 frame behind the live frame, stage chips and the floating
                 toolbar pill. None of that is inside ViewportScroll, so the
                 canvas, the image and the input mapping are byte-identical. -->
            <Border Grid.Column="2" Background="{DynamicResource ViewportBg}"
                    BorderBrush="{DynamicResource BorderSubtle}" ClipToBounds="True">
                <!-- UX-11 (igr-feedback-ux11): below 1180 DIP the stage spans the
                     splitter and the inspector column, so the inspector can open
                     over it instead of taking width away from the guest. Above the
                     breakpoint the span is 1 and the layout is exactly as before. -->
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                        <Setter Property="Background" Value="{DynamicResource ViewportBg}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding InspectorNarrow, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="True">
                                <Setter Property="Grid.ColumnSpan" Value="3" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid x:Name="StageRoot" SizeChanged="OnStageSizeChanged" MouseMove="OnStageMouseMove">
                    <!-- Ambient stage (addendum 6): accent ~7 % with an ok core,
                         both static, plus the noise tile that kills banding. -->
                    <Border Background="{DynamicResource StageGlow}" IsHitTestVisible="False" />
                    <Border Background="{DynamicResource StageGlowOk}" IsHitTestVisible="False" />
                    <Border Background="{DynamicResource StageNoise}" IsHitTestVisible="False" />

                    <!-- Decorative device frame: a rounded bezel drawn AROUND the
                         live frame (10 DIP bezel, soft shadow). igr-feedback-ux05
                         item 8: the outer radius is the screen radius plus the
                         bezel padding �?" the guest frame is square, so 0 + 10 = 10
                         and the corners are concentric with the frame they wrap.
                         It is a sibling behind ViewportScroll, sized from the
                         viewport canvas in code, so it never clips or covers a
                         guest pixel and never touches the input surface. -->
                    <Border x:Name="DeviceFrame" HorizontalAlignment="Center" VerticalAlignment="Center"
                            CornerRadius="10" Background="{DynamicResource DeviceFrameBg}"
                            BorderBrush="{DynamicResource DeviceBodyBorder}" BorderThickness="1"
                            Effect="{DynamicResource DeviceFrameShadow}" IsHitTestVisible="False" />

                    <Grid x:Name="ViewportScroll" ClipToBounds="True" Margin="12">
                        <Grid x:Name="ViewportCanvas" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="ViewportImage" Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   MouseLeftButtonDown="OnViewportMouseDown"
                                   MouseLeftButtonUp="OnViewportMouseUp"
                                   AutomationProperties.Name="Embedded Android viewport"
                                   Source="{Binding Frame}" />
                        </Grid>
                    </Grid>

                    <!-- igr-feedback-ux05 item 2: the stage cards (boot stepper,
                         first-run setup) live in a lane that stops short of the
                         floating pill's slot, so the pill can hold its bezel
                         position while the guest is Starting without sitting on
                         top of the card. The lane's right inset is set from the
                         pill's real left margin in code; with a frame it is 0. -->
                    <Grid x:Name="StageCardLane">
                    <!-- UX-03 inline stage, UX-05 stepper: boot readiness, frame
                         wait, stopped, failed, lab recovery and restricted
                         capture. It is a non-blocking card sourced from
                         supervisor state; the guest frame and the input surface
                         are never covered or dimmed by it. The separate
                         "waiting for Android" card and its progress bar are
                         folded in here: the three boot dots are the progress,
                         and the elapsed figure is the supervisor's own launch
                         timestamp, not a timer that turns green. -->
                    <Border VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Margin="24"
                            Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="20" IsHitTestVisible="False"
                            Visibility="{Binding StageVisible, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Device state">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0"
                                         Style="{StaticResource ToneTagDot}" Tag="{Binding StageTone}" />
                                <TextBlock Text="{Binding StageTitle}" Style="{StaticResource PageText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="{Binding StageDetail}" Style="{StaticResource Body}"
                                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                       Margin="18,6,0,0" />

                            <!-- Connected dots: done = ok filled with a check,
                                 current = accent with a 1.2 s pulse ring (none
                                 under reduced motion), pending = text3 hollow.
                                 The connector takes the tone of the step it
                                 leaves, so progress reads as one line. -->
                            <StackPanel x:Name="BootStepper" Orientation="Horizontal" Margin="18,16,0,0"
                                        Visibility="{Binding ShowBootStages, Converter={StaticResource BoolToVis}}">
                                <ContentControl Style="{StaticResource BootStep}" DataContext="{Binding BootStages[0]}"
                                                AutomationProperties.Name="Boot stage 1" />
                                <Border Width="22" Height="1" Margin="8,7,8,0" VerticalAlignment="Top"
                                        Background="{Binding BootStages[0].State, Converter={StaticResource StepBrush}}" />
                                <ContentControl Style="{StaticResource BootStep}" DataContext="{Binding BootStages[1]}"
                                                AutomationProperties.Name="Boot stage 2" />
                                <Border Width="22" Height="1" Margin="8,7,8,0" VerticalAlignment="Top"
                                        Background="{Binding BootStages[1].State, Converter={StaticResource StepBrush}}" />
                                <ContentControl Style="{StaticResource BootStep}" DataContext="{Binding BootStages[2]}"
                                                AutomationProperties.Name="Boot stage 3" />
                            </StackPanel>

                            <TextBlock Text="{Binding BootElapsedText}" Style="{StaticResource Mono}"
                                       Foreground="{DynamicResource TextTertiary}" Margin="18,12,0,0"
                                       Visibility="{Binding BootElapsedText, Converter={StaticResource TextToVis}}" />

                            <TextBlock Text="{Binding StageHint}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="18,12,0,0"
                                       Visibility="{Binding StageHint, Converter={StaticResource TextToVis}}" />

                            <!-- igr-feedback-ux05 item 2: the top banner's
                                 supervisor note lives here now, as one 12 DIP
                                 text3 line at the bottom of the only progress
                                 surface, so boot has a single card. -->
                            <TextBlock Text="The supervisor owns the operation; closing this window will not stop the guest. Other panes stay usable."
                                       Style="{StaticResource Caption}" FontSize="12"
                                       Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap"
                                       Margin="18,10,0,0"
                                       Visibility="{Binding ShowBootStages, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- First-run setup -->
                    <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="24" MaxWidth="640"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowSetup, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Set up your first device" Style="{StaticResource H1}" />
                            <TextBlock Text="{Binding SetupSummary}" Style="{StaticResource Caption}" Margin="0,6,0,12"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding SetupIssues}" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource Warning}"
                                                   TextWrapping="Wrap" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- igr-feedback-ux11 UX-09 #10: the first-run card is
                                 the last surface that printed the raw doctor dump.
                                 It shows the same three rows as Diagnostics, so the
                                 rows are the only doctor path in every state; the
                                 full report stays behind Copy diagnostics. -->
                            <Border Style="{StaticResource InnerCard}" Padding="10,2" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid MinHeight="26">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Image" Style="{StaticResource RowLabel}" />
                                        <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                                   Text="{Binding DoctorImage, Converter={StaticResource MiddleEllipsis}, ConverterParameter=36}"
                                                   ToolTip="{Binding DoctorImageTooltip}"
                                                   Style="{StaticResource SettingsDoctorValue}" />
                                    </Grid>
                                    <Border Style="{StaticResource SettingsDivider}" />
                                    <Grid MinHeight="26">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Acceleration" Style="{StaticResource RowLabel}" />
                                        <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                                   Text="{Binding DoctorAcceleration, Converter={StaticResource MiddleEllipsis}, ConverterParameter=36}"
                                                   ToolTip="{Binding DoctorAccelerationTooltip}"
                                                   Style="{StaticResource SettingsDoctorValue}" />
                                        <Border Grid.Column="2" Style="{StaticResource SettingsOkChip}"
                                                Visibility="{Binding DoctorAccelerationReady, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Ready" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Success}" />
                                        </Border>
                                    </Grid>
                                    <Border Style="{StaticResource SettingsDivider}" />
                                    <Grid MinHeight="26">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="GPU" Style="{StaticResource RowLabel}" />
                                        <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                                   Text="{Binding DoctorGpu, Converter={StaticResource MiddleEllipsis}, ConverterParameter=36}"
                                                   ToolTip="{Binding DoctorGpuTooltip}"
                                                   Style="{StaticResource SettingsDoctorValue}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <!-- The primary turns into a 40 % ghost with its
                                     reason in the tooltip when the supervisor or
                                     the SDK blocks creation (LOW item 11). -->
                                <Button Content="Create AOSP API 35 device" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding CreateDeviceCommand}"
                                        ToolTip="{Binding SetupSummary}"
                                        AutomationProperties.HelpText="{Binding SetupSummary}" />
                                <Button Content="Copy diagnostics" Style="{StaticResource ToolButton}"
                                        Command="{Binding CopyDiagnosticsCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </Grid>

                    <!-- UX-03 busy strip: real indeterminate progress, no dimming
                         and no hit-test cover, so the window keeps working while
                         the supervisor owns the operation. igr-feedback-ux05
                         item 2: while the boot stepper is on screen it is the
                         ONLY progress surface, so this strip stands down (its
                         supervisor note moved into the stepper card). -->
                    <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16,46,16,0" MaxWidth="460"
                            Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="12,10" IsHitTestVisible="False"
                            AutomationProperties.Name="Operation in progress">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowBootStages}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding BusyText}" TextWrapping="Wrap" />
                            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0" />
                            <TextBlock Text="The supervisor owns the operation; closing this window will not stop the guest. Other panes stay usable."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- UX-03 stale frame, UX-05 chip pass, igr-feedback-ux11 item 2:
                         the last frame stays visible and is stamped. One line,
                         top-centre UNDER the top chips, so it never covers guest
                         pixels: "Frame stalled · 17s · input paused" with the real
                         age of the last delivered frame. A supervised operation
                         that holds the ADB channel keeps the same chip with its
                         own words ("Frames paused ..."). -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,4,16,0"
                            MaxWidth="640" Background="{DynamicResource WarningBg}"
                            BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1"
                            CornerRadius="6" Padding="10,2" IsHitTestVisible="False"
                            Visibility="{Binding IsFrameStale, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Frame stream paused">
                        <TextBlock Width="Auto" MaxWidth="600" Text="{Binding StaleChipText}"
                                   Style="{StaticResource Caption}" FontSize="11"
                                   Foreground="{DynamicResource Warning}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                    </Border>

                    <!-- UX-03 APK drag affordance, UX-05 full-viewport dropzone:
                         the whole viewport card is the target. A raised veil (92 %
                         so the ghost phone and the pill do not read through it), a
                         2 px dashed edge that runs accent when the drag is
                         accepted and warn when it is refused, a 1.2 s opacity
                         pulse (static under reduced motion) and the exact target
                         guest in words. igr-feedback-ux05 item 7: the dashed edge
                         is inset 6 DIP with a 4 DIP radius �?" the card is r10, so
                         4 + 6 keeps the corners concentric. -->
                    <Border x:Name="DropVeil" Margin="0" CornerRadius="0" IsHitTestVisible="False"
                            Panel.ZIndex="30"
                            Background="{DynamicResource DropVeilBg}"
                            Visibility="{Binding DropVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Rectangle x:Name="DropDash" Margin="6" RadiusX="4" RadiusY="4"
                                       StrokeThickness="2" StrokeDashArray="4 3" Opacity="1">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Stroke" Value="{DynamicResource Warning}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DropAccepted}" Value="True">
                                                <Setter Property="Stroke" Value="{DynamicResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                                <!-- igr-feedback-ux05 item 7: a 48 DIP accent-soft
                                     circle (the accent-soft FILL, not the neutral
                                     navigation tint), with the install glyph at
                                     the accent. -->
                                <Border Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center"
                                        Background="{DynamicResource AccentSoftTint}">
                                    <Path Data="{StaticResource IconInstall}" Stroke="{DynamicResource Accent}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Width="22" Height="22" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding DropTitle}" Style="{StaticResource H1}" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,14,0,0" />
                                <TextBlock Text="{Binding DropDetail}"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                            <Style.Triggers>
                                                <!-- A refusal keeps UX-03's warn wording and tone. -->
                                                <DataTrigger Binding="{Binding DropAccepted}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- UX-03 capture/install toast: success only, ~6 s, paused on
                         hover, with Open and Copy. UX-08 fix pass: the same surface is
                         the one home for transient status sentences (2.5 s, one at a
                         time), and it sits bottom-centre like the mockup. -->
                    <views:FloatingSurface HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                          Margin="16" MaxWidth="420" Style="{StaticResource FloatingCard}"
                                          Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVis}}"
                                          MouseEnter="OnToastEnter" MouseLeave="OnToastLeave"
                                          AutomationProperties.Name="Result">
                        <StackPanel>
                            <TextBlock Text="{Binding ToastTitle}" Style="{StaticResource SectionHeader}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{Binding ToastText}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Margin="0,2,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Open" Style="{StaticResource ToolButton}"
                                        Command="{Binding OpenToastCommand}"
                                        Visibility="{Binding HasToastPath, Converter={StaticResource BoolToVis}}"
                                        AutomationProperties.Name="Open the saved artifact" />
                                <Button Content="Copy path" Style="{StaticResource ToolButton}"
                                        Command="{Binding CopyToastCommand}"
                                        Visibility="{Binding HasToastPath, Converter={StaticResource BoolToVis}}"
                                        AutomationProperties.Name="Copy the artifact path" />
                                <Button Content="Dismiss" Style="{StaticResource ToolButton}"
                                        Command="{Binding DismissToastCommand}" Margin="0"
                                        AutomationProperties.Name="Dismiss the result" />
                            </StackPanel>
                        </StackPanel>
                    </views:FloatingSurface>

                    <!-- UX-05 stage chips (igr-feedback-ux03 MEDIUM 5): the guest
                         display top-left, orientation + zoom mode top-right, the
                         APK drop hint bottom-left and the real input capability
                         bottom-right (this chip replaces the "Capability:"
                         paragraph that used to live in the inspector). Every
                         value is live state; a value the supervisor has not
                         reported prints an em dash. -->
                    <Border Style="{StaticResource StageChip}" HorizontalAlignment="Left"
                            VerticalAlignment="Top" Margin="14"
                            ToolTip="{Binding StageGuestChipTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconMonitor}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <TextBlock Text="{Binding StageGuestChip}" Style="{StaticResource StageChipText}"
                                       Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StageChip}" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="14"
                            ToolTip="{Binding StageOrientationChipTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRotate}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <TextBlock Text="{Binding StageOrientationChip}" Style="{StaticResource StageChipText}"
                                       Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- UX-06 carry-over from the UX-05 review: below 1120 DIP
                         the stage is too narrow for the two bottom chips and the
                         bottom-left drop hint overlapped the device frame's
                         lower-left corner at 1024. Both bottom chips stand down
                         there; the top pair (guest display, orientation) and the
                         dropzone veil still carry the same information. -->
                    <Border Style="{StaticResource StageChip}" HorizontalAlignment="Left"
                            VerticalAlignment="Bottom" Margin="14" Opacity="0.85"
                            Visibility="{Binding CompactStage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconInstall}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <TextBlock Text="{Binding StageDropHint}" Style="{StaticResource StageChipText}"
                                       Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StageChip}" HorizontalAlignment="Right"
                            VerticalAlignment="Bottom" Margin="14" Opacity="0.85"
                            ToolTip="{Binding InputCapabilityDetail}"
                            Visibility="{Binding CompactStage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTouch}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <TextBlock Text="{Binding InputCapabilityChip}" Style="{StaticResource StageChipText}"
                                       Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- UX-05 floating toolbar pill (MEDIUM 6 + addendum 5):
                         igr-feedback-ux05 item 4 orders it nav group first, then a
                         1 px stroke-soft separator, then the utilities:
                         back, home, recents | rotate, screenshot, sample. Every
                         command is the one that already existed, and the pill sits
                         16 DIP off the frame's right bezel (computed in code).
                         Item 2: the nav cluster and screenshot are disabled until
                         the guest is interactive, from existing state only.
                         Item 3: the shadow host is NOT clipped, so the light
                         theme's soft shadow keeps its rounded corner. -->
                    <Grid x:Name="ToolbarPillHost" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Panel.ZIndex="20" Margin="0"
                          MouseEnter="OnPillEnter" MouseLeave="OnPillLeave"
                          GotKeyboardFocus="OnPillFocus">
                        <views:FloatingSurface x:Name="ToolbarPill" Style="{StaticResource FloatingPill}"
                                               AutomationProperties.Name="Device toolbar">
                            <StackPanel x:Name="PillButtons" Orientation="Vertical">
                                <Button Style="{StaticResource PillIconButton}" Command="{Binding BackCommand}"
                                        ToolTip="Back" AutomationProperties.Name="Back"
                                        IsEnabled="{Binding IsGuestInteractive}">
                                    <Path Data="{StaticResource IconBack}" Style="{StaticResource Glyph}" />
                                </Button>
                                <Button Style="{StaticResource PillIconButton}" Command="{Binding HomeCommand}"
                                        ToolTip="Home" AutomationProperties.Name="Home"
                                        IsEnabled="{Binding IsGuestInteractive}">
                                    <Path Data="{StaticResource IconHome}" Style="{StaticResource Glyph}" />
                                </Button>
                                <Button Style="{StaticResource PillIconButton}" Command="{Binding RecentsCommand}"
                                        ToolTip="Recents" AutomationProperties.Name="Recents"
                                        IsEnabled="{Binding IsGuestInteractive}">
                                    <Path Data="{StaticResource IconRecents}" Style="{StaticResource Glyph}" />
                                </Button>
                                <Border Style="{StaticResource PillDivider}" />
                                <Button Style="{StaticResource PillIconButton}" Command="{Binding RotateCommand}"
                                        ToolTip="Rotate the guest display" AutomationProperties.Name="Rotate">
                                    <Path Data="{StaticResource IconRotate}" Style="{StaticResource Glyph}" />
                                </Button>
                                <Button Style="{StaticResource PillIconButton}" Command="{Binding ScreenshotCommand}"
                                        ToolTip="Capture a PNG of the selected guest" AutomationProperties.Name="Screenshot"
                                        IsEnabled="{Binding IsGuestInteractive}">
                                    <Path Data="{StaticResource IconScreenshot}" Style="{StaticResource Glyph}" />
                                </Button>
                                <Button Style="{StaticResource PillIconButton}" Command="{Binding LaunchSampleCommand}"
                                        Margin="0" ToolTip="Launch the sample application" AutomationProperties.Name="Launch sample">
                                    <Path Data="{StaticResource IconPlay}" Style="{StaticResource Glyph}" />
                                </Button>
                            </StackPanel>
                        </views:FloatingSurface>

                        <!-- Collapsed state: a 3x48 edge handle at 35 %. -->
                        <Border x:Name="PillHandle" Width="3" Height="48" CornerRadius="2"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{DynamicResource TextTertiary}" Opacity="0"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                        <!-- 24 DIP approach zone: the pointer within 24 px of the
                             handle expands it again. -->
                        <Border x:Name="PillHoverZone" Width="28" Height="60" Background="Transparent"
                                HorizontalAlignment="Center" Visibility="Collapsed"
                                MouseEnter="OnPillZoneEnter" />
                    </Grid>

                    <!-- UX-11 (igr-feedback-ux11): while the inspector is open as
                         an overlay at a narrow width, this 30 % scrim dims the stage
                         under it so the panel reads as a floating surface. It is
                         the last child of the stage, so it covers the chips, the
                         pill and the guest alike, and it never exists at wide
                         sizes or while the panel is collapsed. -->
                    <Border x:Name="InspectorOverlayScrim" Panel.ZIndex="60"
                            Background="{DynamicResource InspectorScrimBg}"
                            Visibility="{Binding InspectorOverlay, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                            IsHitTestVisible="False" />
                </Grid>
            </Border>

            <!-- UX-05: the old right-side vertical device strip is retired. Its
                 four commands (sample launch, back, home, recents) moved into the
                 floating pill above, with the same Command bindings; nothing was
                 added twice and nothing was lost. Column 5 keeps the same index
                 so no Grid.Column in this body moves, and it is now 0 wide. -->

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Inspector: three tabs. Device is identity and live resources,
                 Capture is the frame pipeline, Diagnostics holds the doctor text,
                 the SDK paths and the Root Lab so neither of them crowds the
                 identity rows. Every value is supervisor data; a field the
                 supervisor does not report is not rendered at all. -->
            <Border x:Name="InspectorPanel" Grid.Column="4" Padding="12">
                <!-- UX-11: as an overlay the panel is a floating surface, so it
                     takes the shared ambient shadow and the card stroke; in the
                     docked layout it keeps the plain Panel look it always had. -->
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding InspectorOverlay, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
                                <Setter Property="Effect" Value="{DynamicResource FloatingShadowAmbient}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TabControl x:Name="InspectorTabs" Background="Transparent" BorderThickness="0" Padding="0">
                    <TabItem Header="Device">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Device header row: thumbnail, name, subtitle. -->
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="8"
                                            Background="{DynamicResource DeviceBodyBg}"
                                            BorderBrush="{DynamicResource DeviceBodyBorder}" BorderThickness="1">
                                        <Path Data="{StaticResource IconDevice}" Width="20" Height="20" Stretch="Uniform"
                                              Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedDevice.Name, FallbackValue=No device selected}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SelectedDevice.Name}" />
                                        <TextBlock Text="{Binding SelectedDevice.Subtitle, FallbackValue=Select a device}"
                                                   Style="{StaticResource Caption}" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SelectedDevice.Subtitle}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource RowRule}" />

                                <TextBlock Text="IDENTITY" Style="{StaticResource RowSection}" />
                                <Grid Margin="0,5,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Serial" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.Serial}"
                                               Style="{StaticResource RowValueMono}"
                                               ToolTip="{Binding SelectedDevice.Serial}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ABI / API" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.AbiApi}"
                                               Style="{StaticResource RowValueMono}"
                                               ToolTip="{Binding SelectedDevice.AbiApi}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ports" Style="{StaticResource RowLabel}"
                                               ToolTip="Console and gRPC controller port" />
                                    <TextBlock Grid.Column="1" Text="{Binding PortsText}"
                                               Style="{StaticResource RowValueMono}" ToolTip="{Binding PortsText}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="GPU" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.Gpu}"
                                               Style="{StaticResource RowValue}"
                                               ToolTip="{Binding SelectedDevice.Gpu}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Image" Style="{StaticResource RowLabel}" />
                                    <!-- igr-feedback-ux05 item 5: the reading name
                                         is derived from the real package; the raw
                                         path stays in the tooltip. -->
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.ImageDisplay}"
                                               Style="{StaticResource RowValue}"
                                               ToolTip="{Binding SelectedDevice.ImagePackage}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Foreground" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.ForegroundDisplay}"
                                               Style="{StaticResource RowValueMono}"
                                               ToolTip="{Binding SelectedDevice.Foreground}" />
                                </Grid>

                                <Border Style="{StaticResource RowRule}" />

                                <TextBlock Text="RESOURCES" Style="{StaticResource RowSection}" />
                                <Grid Margin="0,5,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Guest display" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding GuestDisplayText}"
                                               Style="{StaticResource RowValueNumeric}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Frame" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding DeliveredFrameText}"
                                               Style="{StaticResource RowValueNumeric}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Frame rate" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding FrameRateText}"
                                               Style="{StaticResource RowValueNumeric}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Dropped" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding DroppedFramesText}"
                                               Style="{StaticResource RowValueNumeric}" />
                                </Grid>
                                <!-- Fix pass item 6b: one 12 DIP text3 line with a
                                     small info icon instead of a paragraph. The
                                     full sentence stays in the tooltip. -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            ToolTip="The supervisor does not report CPU, memory or disk usage for a running guest, so those rows are not rendered.">
                                    <Path Data="{StaticResource IconInfo}" Width="12" Height="12" Stretch="Uniform"
                                          Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          VerticalAlignment="Center" Margin="0,1,6,0" />
                                    <TextBlock Text="CPU, memory and disk: not reported"
                                               Style="{StaticResource Caption}" FontSize="12"
                                               Foreground="{DynamicResource TextTertiary}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <Border Style="{StaticResource RowRule}" />

                                <TextBlock Text="SESSION" Style="{StaticResource RowSection}" />
                                <Grid Margin="0,5,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Supervisor" Style="{StaticResource RowLabel}" />
                                    <!-- Fix pass item 6c: the session state is an
                                         ok-soft / err-soft chip driven by the real
                                         IsConnected state, never a coloured word. -->
                                    <Border Grid.Column="1" HorizontalAlignment="Right">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource StatePill}">
                                                <Setter Property="Background" Value="{DynamicResource DangerBg}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBg}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource Danger}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource Success}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StatePillText}">
                                                        <Setter Property="Text" Value="not connected" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                <Setter Property="Text" Value="connected" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <!-- B2: short human values; the supervisor's own
                                     words stay in the tooltip, and a field it did
                                     not report is an em dash, not a sentence. -->
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ADB daemon" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding AdbUidValue}"
                                               Style="{StaticResource RowValueMono}"
                                               ToolTip="{Binding AdbUidTooltip}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Boot" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding BootValueText}"
                                               Style="{StaticResource RowValueMono}"
                                               ToolTip="{Binding BootTooltip}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Magisk lab" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding MagiskLabValue}"
                                               Style="{StaticResource RowValue}"
                                               ToolTip="{Binding MagiskLabTooltip}" />
                                </Grid>
                                <TextBlock Text="{Binding SelectedDevice.LastError}"
                                           Foreground="{DynamicResource Danger}" TextWrapping="Wrap"
                                           FontSize="12" Margin="0,8,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Capture">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,2,0,0">
                                <TextBlock Text="PIPELINE" Style="{StaticResource RowSection}" />
                                <Grid Margin="0,5,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Frame" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding DeliveredFrameText}"
                                               Style="{StaticResource RowValueNumeric}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Frame rate" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding FrameRateText}"
                                               Style="{StaticResource RowValueNumeric}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Dropped" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding DroppedFramesText}"
                                               Style="{StaticResource RowValueNumeric}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Zoom" Style="{StaticResource RowLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ZoomStatus}"
                                               Style="{StaticResource RowValue}" />
                                </Grid>

                                <Border Style="{StaticResource RowRule}" />

                                <TextBlock Text="INPUT" Style="{StaticResource RowSection}" />
                                <TextBlock Text="{Binding InputLatencyText}" Style="{StaticResource Mono}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <!-- UX-05: the capability sentence moved to the
                                     stage's bottom-right chip; the Capture tab
                                     keeps the measurement and one pointer line. -->
                                <TextBlock Text="{Binding InputCapabilityDetail}" Style="{StaticResource Caption}"
                                           Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap"
                                           FontSize="11" Margin="0,6,0,0" />

                                <Border Style="{StaticResource RowRule}" />

                                <TextBlock Text="LAST CAPTURE" Style="{StaticResource RowSection}" />
                                <TextBlock Text="{Binding ScreenshotPath}" Style="{StaticResource Mono}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"
                                           ToolTip="{Binding ScreenshotPath}"
                                           Visibility="{Binding ScreenshotPath, Converter={StaticResource TextToVis}}" />
                                <TextBlock Text="No capture in this session." Style="{StaticResource Caption}"
                                           Foreground="{DynamicResource TextTertiary}" Margin="0,6,0,0"
                                           Visibility="{Binding ScreenshotPath, Converter={StaticResource InverseTextToVis}}" />

                                <Border Style="{StaticResource RowRule}" />
                                <TextBlock Text="Multi-touch is not enabled in this phase; the viewport never overlays the guest frame."
                                           Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiary}"
                                           TextWrapping="Wrap" FontSize="11" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Diagnostics">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,2,0,0">
                                <!-- igr-feedback-ux10 item 10: the Diagnostics tab no
                                     longer prints the raw doctor dump. It shows the
                                     three rows an operator actually reads here - the
                                     image, the acceleration and the GPU - in the same
                                     label/value shape as Settings > Diagnostics; the
                                     full report stays behind Copy. -->
                                <TextBlock Text="DOCTOR" Style="{StaticResource RowSection}" />
                                <Border Style="{StaticResource InnerCard}" Padding="10,2" Margin="0,6,0,8">
                                    <StackPanel>
                                        <Grid MinHeight="28">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Image" Style="{StaticResource RowLabel}" />
                                            <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                                       Text="{Binding DoctorImage, Converter={StaticResource MiddleEllipsis}, ConverterParameter=36}"
                                                       ToolTip="{Binding DoctorImageTooltip}"
                                                       Style="{StaticResource SettingsDoctorValue}" />
                                        </Grid>
                                        <Border Style="{StaticResource SettingsDivider}" />
                                        <Grid MinHeight="28">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Acceleration" Style="{StaticResource RowLabel}" />
                                            <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                                       Text="{Binding DoctorAcceleration, Converter={StaticResource MiddleEllipsis}, ConverterParameter=36}"
                                                       ToolTip="{Binding DoctorAccelerationTooltip}"
                                                       Style="{StaticResource SettingsDoctorValue}" />
                                            <Border Grid.Column="2" Style="{StaticResource SettingsOkChip}"
                                                    Visibility="{Binding DoctorAccelerationReady, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Ready" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Success}" />
                                            </Border>
                                        </Grid>
                                        <Border Style="{StaticResource SettingsDivider}" />
                                        <Grid MinHeight="28">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="GPU" Style="{StaticResource RowLabel}" />
                                            <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                                       Text="{Binding DoctorGpu, Converter={StaticResource MiddleEllipsis}, ConverterParameter=36}"
                                                       ToolTip="{Binding DoctorGpuTooltip}"
                                                       Style="{StaticResource SettingsDoctorValue}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Copy" Style="{StaticResource ToolButton}"
                                            Command="{Binding CopyDiagnosticsCommand}"
                                            AutomationProperties.Name="Copy diagnostics" />
                                    <Button Content="Cold boot" Style="{StaticResource ToolButton}"
                                            Command="{Binding ColdBootCommand}"
                                            AutomationProperties.Name="Cold boot the guest" />
                                </StackPanel>

                                <Border Style="{StaticResource RowRule}" />

                                <!-- igr-feedback-ux05 item 6: the ROOT LAB eyebrow
                                     keeps a top gap so it is never flush against
                                     the rule (or the scroll edge) above it. -->
                                <TextBlock Text="ROOT LAB" Style="{StaticResource RowSection}" Margin="0,6,0,0" />

                                <!-- UX-05 (part D, 05-root-lab.png): the privileged
                                     surface. It names the exact target guest and
                                     serial, shows the ADB daemon identity and the
                                     Magisk lab state as worded chips, and keeps
                                     every action and confirmation exactly as it
                                     was: the same commands, the same OS consent
                                     dialog before anything is approved. Restyle
                                     only - no root logic lives in this markup. -->
                                <Border Style="{StaticResource InnerCard}" Padding="10" Margin="0,6,0,0"
                                        Background="{DynamicResource PanelAlt}">
                                    <StackPanel>
                                        <TextBlock Text="Target guest" Style="{StaticResource StatusLabel}" />
                                        <TextBlock Text="{Binding RootLabTarget}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,2"
                                                   ToolTip="{Binding RootLabTargetTooltip}" />
                                        <TextBlock Text="ADB root and the Magisk lab apply to this guest only. Nothing here runs without your explicit consent."
                                                   Style="{StaticResource Caption}" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- ADB daemon identity -->
                                <Border Style="{StaticResource InnerCard}" Padding="10" Margin="0,6,0,0"
                                        ToolTip="{Binding AdbRootState}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconShield}" Width="13" Height="13"
                                                      Stretch="Uniform" Stroke="{DynamicResource TextSecondary}"
                                                      StrokeThickness="1.5" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" VerticalAlignment="Center"
                                                      Margin="0,0,7,0" />
                                                <TextBlock Text="ADB daemon" Style="{StaticResource SectionHeader}"
                                                           FontSize="13" />
                                            </StackPanel>
                                            <!-- UX-06 (UX-05 nit 1): "Refresh state" left
                                                 the button row. It is a 28 DIP refresh icon in
                                                 the card header, left of the chip, with the
                                                 same command and the tooltip carrying the
                                                 words so the icon is never alone. -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Style="{StaticResource SettingsIconButton}"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding RefreshAdbStateCommand}"
                                                        ToolTip="Re-read the ADB daemon identity"
                                                        AutomationProperties.Name="Refresh ADB daemon state">
                                                    <Path Data="{StaticResource IconRefresh}" Style="{StaticResource Glyph}" />
                                                </Button>
                                                <Border Style="{StaticResource ToneTagPill}"
                                                        Tag="{Binding AdbDaemonChipTone}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Style="{StaticResource ToneTagDot}"
                                                                 Tag="{Binding AdbDaemonChipTone}" />
                                                        <TextBlock Text="{Binding AdbDaemonChip}"
                                                                   Style="{StaticResource ToneTagText}"
                                                                   Tag="{Binding AdbDaemonChipTone}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <!-- igr-feedback-ux05 item 6: one text3 line �?"
                                             "UID · not reported", or the real uid �?"
                                             instead of a 24 DIP em-dash badge. The
                                             daemon's detail sentence is the tooltip. -->
                                        <TextBlock Text="{Binding AdbUidLine}" Style="{StaticResource Caption}"
                                                   FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                                   ToolTip="{Binding AdbDaemonDetail}" />
                                        <!-- One row, no wrap: root and unroot are the
                                             pair an operator chooses between, and the
                                             quiet Refresh state now lives in the card
                                             header as a 28 DIP icon. Only ADB root keeps
                                             a tone outline (it is the consequential one);
                                             unroot is a hairline ghost. -->
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="ADB root" Style="{StaticResource WarnButton}"
                                                    Height="32" Padding="10,0"
                                                    Command="{Binding AdbRootCommand}" Margin="0,0,6,0"
                                                    ToolTip="Run adb root on the selected guest (confirmation is the supervisor's approval)"
                                                    AutomationProperties.Name="ADB root" />
                                            <Button Content="ADB unroot" Style="{StaticResource GhostButton}"
                                                    Command="{Binding AdbUnrootCommand}" Margin="0"
                                                    ToolTip="Return the guest ADB daemon to the shell user"
                                                    AutomationProperties.Name="ADB unroot" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Magisk lab state. igr-feedback-ux05 item 6: the raw
                                     "Magisk lab: not_configured" line is gone (it
                                     duplicated the chip's word), and the supervisor's
                                     own sentence is the card's tooltip. -->
                                <Border Style="{StaticResource InnerCard}" Padding="10" Margin="0,6,0,0"
                                        ToolTip="{Binding MagiskState}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Magisk lab" Style="{StaticResource SectionHeader}"
                                                       FontSize="13" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Style="{StaticResource ToneTagPill}"
                                                    Tag="{Binding LabDotTone}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Style="{StaticResource ToneTagDot}"
                                                             Tag="{Binding LabDotTone}" />
                                                    <TextBlock Text="{Binding MagiskLabValue}"
                                                               Style="{StaticResource ToneTagText}"
                                                               Tag="{Binding LabDotTone}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <!-- Recovery first: an err-soft callout only while a
                                             lab needs it, with the supervisor's own words. -->
                                        <Border Background="{DynamicResource DangerBg}"
                                                BorderBrush="{DynamicResource DangerBorder}" BorderThickness="1"
                                                CornerRadius="6" Padding="8,6" Margin="0,10,0,0"
                                                Visibility="{Binding LabDotTone, Converter={StaticResource StringVis}, ConverterParameter=err}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconWarning}" Width="13" Height="13"
                                                      Stretch="Uniform" Stroke="{DynamicResource Danger}"
                                                      StrokeThickness="1.5" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" VerticalAlignment="Top"
                                                      Margin="0,1,7,0" />
                                                <TextBlock Text="Recovery is required before this guest can start again. Agents stay fenced until stock is restored."
                                                           Style="{StaticResource Caption}" FontSize="11"
                                                           Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <!-- Both of these are consequential, so both keep
                                             their outlines: install is err-soft, recovery
                                             is warn. Same commands, same consent. -->
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="Install Magisk lab…" Style="{StaticResource DangerButton}"
                                                    Height="32" Padding="10,0"
                                                    Command="{Binding MagiskInstallCommand}" Margin="0,0,6,4"
                                                    ToolTip="Patch this guest's boot image with a verified Magisk build (asks for consent)"
                                                    AutomationProperties.Name="Install Magisk lab" />
                                            <Button Content="Recover stock…" Style="{StaticResource WarnButton}"
                                                    Height="32" Padding="10,0"
                                                    Command="{Binding MagiskRecoverCommand}" Margin="0,0,0,4"
                                                    ToolTip="Restore the stock boot image from the verified recovery point (asks for consent)"
                                                    AutomationProperties.Name="Recover stock boot" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- UX-11 reviewer refinement: below 1120 DIP the collapsed inspector
                 leaves this 48 DIP strip at the window edge. Three 36 DIP glyphs
                 reopen the panel on the tab they name; the strip hides while the
                 panel is open or the focus view is on. It is a strip, not a second
                 panel: no command, source or data is duplicated. -->
            <Border Grid.Column="5" Width="48" Background="{DynamicResource NavBg}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowInspectorStrip, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.Name="Inspector strip">
                <StackPanel VerticalAlignment="Center" Margin="0,8">
                    <Button Style="{StaticResource NavRailItem}" Click="OnInspectorStripOpen" Tag="Device"
                            ToolTip="Device details"
                            AutomationProperties.Name="Open device details">
                        <Path Data="{StaticResource IconDevice}" Style="{StaticResource Glyph}" />
                    </Button>
                    <Button Style="{StaticResource NavRailItem}" Click="OnInspectorStripOpen" Tag="Capture"
                            ToolTip="Capture details"
                            AutomationProperties.Name="Open capture details">
                        <Path Data="{StaticResource IconScreenshot}" Style="{StaticResource Glyph}" />
                    </Button>
                    <Button Style="{StaticResource NavRailItem}" Click="OnInspectorStripOpen" Tag="Diagnostics"
                            Margin="0" ToolTip="Diagnostics and Root Lab"
                            AutomationProperties.Name="Open diagnostics details">
                        <Path Data="{StaticResource IconShield}" Style="{StaticResource Glyph}" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Drawer tab bar: 36 DIP, one real destination (Logcat), the compact count
             line with warnings and errors in their own colours (only when above
             zero), a 28 DIP search that expands into the dock's only filter, the
             Resume that appears while the stream is held, the pop-out that opens
             the full Logcat page and the expand toggle. There is no Activity tab
             because the app has no real activity feed to show. The bar hides while
             the Logcat page is open, because the page is the same stream in its own
             surface. -->
        <Border Grid.Row="3" Grid.Column="1" Height="36"
                Background="{DynamicResource NavBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Visibility="{Binding IsStudioVisible, Converter={StaticResource BoolToVis}}">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource DrawerTab}" Command="{Binding ToggleLogcatCommand}"
                        Tag="{Binding IsLogcatOpen}" Height="28" Padding="8,0"
                        ToolTip="Logcat: the guest log stream"
                        AutomationProperties.Name="Toggle Logcat">
                    <TextBlock Text="Logcat" />
                </Button>
                <!-- The count line sits right after the tab: mono 11 on one baseline,
                     6 DIP separators, warn/err in their tokens, an empty drawer says
                     'No lines yet' in text3. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasLogEntries, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.LiveSetting="Polite">
                    <TextBlock Text="{Binding LogLineCountText}" Style="{StaticResource Mono}"
                               FontSize="11" Foreground="{DynamicResource TextTertiary}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="·" Style="{StaticResource Mono}" FontSize="11" Margin="6,0"
                               Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"
                               Visibility="{Binding HasLogWarnings, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding LogWarnCountText}" Style="{StaticResource Mono}"
                               FontSize="11" Foreground="{DynamicResource Warning}"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasLogWarnings, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="·" Style="{StaticResource Mono}" FontSize="11" Margin="6,0"
                               Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"
                               Visibility="{Binding HasLogErrors, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding LogErrorCountText}" Style="{StaticResource Mono}"
                               FontSize="11" Foreground="{DynamicResource Danger}"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasLogErrors, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource Caption}" FontSize="11"
                           Foreground="{DynamicResource TextTertiary}" Text="No lines yet"
                           Visibility="{Binding HasLogEntries, Converter={StaticResource InverseBoolToVis}}" />

                <!-- The dock's single filter: a 28 DIP icon that expands into a 200
                     DIP field. Ctrl+F opens it too. -->
                <Grid Grid.Column="2" HorizontalAlignment="Right" Margin="8,0,0,0"
                      VerticalAlignment="Center">
                    <Button x:Name="DockSearchButton" Style="{StaticResource IconButton}"
                            Width="28" Height="28" Margin="0"
                            Click="OnToggleDockSearch"
                            ToolTip="Search the dock (Ctrl+F)"
                            AutomationProperties.Name="Search the Logcat drawer">
                        <Path Data="{StaticResource IconSearch}" Style="{StaticResource Glyph}" Width="13" Height="13" />
                    </Button>
                    <Border x:Name="DockSearchHost" Style="{StaticResource LogField}" Width="200" Height="26"
                            HorizontalAlignment="Right" Visibility="Collapsed"
                            LostKeyboardFocus="OnDockSearchLostFocus">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconSearch}"
                                  Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="12" Height="12" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Search message or tag"
                                       Style="{StaticResource Mono}" FontSize="11"
                                       Foreground="{DynamicResource TextTertiary}"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding LogSearch, Converter={StaticResource InverseTextToVis}}" />
                            <TextBox x:Name="LogSearchField" Grid.Column="1"
                                     Text="{Binding LogSearch, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     MinHeight="0" VerticalContentAlignment="Center"
                                     FontFamily="{StaticResource MonoFont}" FontSize="11"
                                     ToolTip="Search the message and the tag (Ctrl+F)"
                                     AutomationProperties.Name="Search logcat" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- One resume affordance while the stream is held; the page owns the
                     larger paused chip and the buffered count. -->
                <Button Grid.Column="3" Style="{StaticResource GhostButton}" Height="26" MinHeight="26"
                        Padding="9,0" Margin="0,0,6,0" FontSize="11"
                        Command="{Binding ResumeLogCommand}"
                        ToolTip="Resume the stream (Ctrl+P)"
                        AutomationProperties.Name="Resume the log stream"
                        Visibility="{Binding LogPaused, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlay}" Width="10" Height="10" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="Resume" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="4" Style="{StaticResource IconButton}" Width="28" Height="28"
                        Margin="0,0,2,0" Command="{Binding OpenLogcatPageCommand}"
                        ToolTip="Open the full Logcat page"
                        AutomationProperties.Name="Open the full Logcat page">
                    <Path Data="{StaticResource IconPopOut}" Style="{StaticResource Glyph}" Width="13" Height="13" />
                </Button>
                <Button Grid.Column="5" Style="{StaticResource IconButton}" Width="28" Height="28"
                        Margin="0" Command="{Binding ToggleLogcatCommand}"
                        ToolTip="Expand or collapse the drawer"
                        AutomationProperties.Name="Expand or collapse the Logcat drawer">
                    <Path Data="{StaticResource IconChevronDown}" Style="{StaticResource Glyph}" Width="12" Height="12">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="DrawerChevron" Angle="0" CenterX="6" CenterY="6" />
                        </Path.RenderTransform>
                    </Path>
                </Button>
            </Grid>
        </Border>

        <!-- Drawer body (UX-08 fix pass). Its height is animated in code-behind
             (220 ms, the drawer curve) instead of snapping through a GridLength
             binding. The dock is header plus lines only: its one filter is the 28 DIP
             search in the tab bar, which expands into a 200 DIP field; pause, clear,
             copy and export live on the page the pop-out leads to. What is left here
             is the err-soft band (only while the subscription is refused) and the
             table - 20 DIP mono rows, each level a tinted glyph, warnings and errors
             marked by a 2 DIP leading bar. -->
        <Border x:Name="LogcatHost" Grid.Row="4" Grid.Column="1" Height="0" ClipToBounds="True"
                Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Visibility="{Binding IsLogcatOpen, Converter={StaticResource BoolToVis}}"
                AutomationProperties.Name="Logcat drawer">
            <Grid>
                <!-- The dock is a floating surface, so it carries the same 1 DIP
                     specular highlight as the settings drawer and the palette. -->
                <Border Height="1" VerticalAlignment="Top" IsHitTestVisible="False"
                        Background="{DynamicResource SpecularEdge}" />

                <Grid Margin="10,6,10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- err-soft band: the subscription was refused. One sentence in
                         the supervisor's own words plus the Retry that re-attaches it. -->
                    <Border Grid.Row="0" Margin="0,6,0,0" Padding="10,5"
                            Background="{DynamicResource DangerBg}"
                            BorderBrush="{DynamicResource DangerBorder}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusControl}"
                            Visibility="{Binding HasLogcatError, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Log stream error">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Retry" Style="{StaticResource ToolButton}"
                                    Height="26" MinHeight="26" Padding="10,0" Margin="10,0,0,0" FontSize="12"
                                    VerticalAlignment="Center" Command="{Binding RetryLogcatCommand}"
                                    ToolTip="Attach the log subscription again"
                                    AutomationProperties.Name="Retry the log stream" />
                            <Path DockPanel.Dock="Left" Data="{StaticResource IconWarning}" Width="14" Height="14"
                                  Stretch="Uniform" Stroke="{DynamicResource Danger}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding LogcatErrorText}" Style="{StaticResource Caption}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding LogcatErrorText}" />
                        </DockPanel>
                    </Border>

                    <!-- The table: sticky header, then the rows on the viewport-coloured
                         log surface, both inside one 1 px stroke-soft edge. Rows are
                         20 DIP mono 12; warnings and errors tint their own message. -->
                    <Border Grid.Row="1" Margin="0,6,0,0" Background="{DynamicResource LogBg}"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                            CornerRadius="6" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <ListBox x:Name="LogDockList" Grid.Row="0" ItemsSource="{Binding LogView}"
                                     Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource LogRowItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     AutomationProperties.Name="Logcat entries">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="20" Margin="10,0,10,0"
                                              AutomationProperties.Name="{Binding AccessibleLine}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="94" />
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="124" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Time}" Style="{StaticResource Mono}"
                                                       FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Border Grid.Column="1" Style="{StaticResource LogLevelGlyph}" HorizontalAlignment="Left" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Level}" Style="{StaticResource LogLevelGlyphText}" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Tag}" Style="{StaticResource LogTagText}"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding Message}"
                                                       Style="{StaticResource LogMessageText}"
                                                       ToolTip="{Binding Message}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Auto-scroll follows the tail while the operator is at
                                 the bottom. Scrolling up stops it and this pill
                                 counts what arrived since, until it is clicked. -->
                            <Button x:Name="LogJumpPill" Grid.Row="0" HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom" Margin="0,0,16,10"
                                    Padding="10,4" Height="26" MinHeight="26" FontSize="11"
                                    Style="{StaticResource GhostButton}"
                                    Background="{DynamicResource PanelAlt}"
                                    Content="Jump to latest"
                                    Click="OnJumpToLatest"
                                    Visibility="Collapsed"
                                    ToolTip="Scroll the dock back to the newest line"
                                    AutomationProperties.Name="Jump to the latest log lines" />

                            <!-- Calm empty state: icon, one line, one sentence and at most
                                 one action, each backed by a command the app really has. -->
                            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        MaxWidth="430" Margin="16,0"
                                        Visibility="{Binding ShowLogEmpty, Converter={StaticResource BoolToVis}}">
                                <Path Data="{StaticResource IconLogs}" Width="20" Height="20" Stretch="Uniform"
                                      Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding LogEmpty.Title}" Style="{StaticResource Body}"
                                           FontSize="13" Foreground="{DynamicResource TextSecondary}"
                                           HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding LogEmpty.Detail}" Style="{StaticResource Caption}"
                                           FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <Button Content="Clear filters" Style="{StaticResource ToolButton}"
                                            Height="26" MinHeight="26" Padding="10,0" FontSize="12" Margin="0,0,6,0"
                                            Command="{Binding ClearLogFiltersCommand}"
                                            Visibility="{Binding LogEmpty.Action, Converter={StaticResource StringVis}, ConverterParameter=filters}"
                                            AutomationProperties.Name="Clear the Logcat filters" />
                                    <Button Content="Retry" Style="{StaticResource ToolButton}"
                                            Height="26" MinHeight="26" Padding="10,0" FontSize="12" Margin="0,0,6,0"
                                            Command="{Binding RetryLogcatCommand}"
                                            Visibility="{Binding LogEmpty.Action, Converter={StaticResource StringVis}, ConverterParameter=retry}"
                                            AutomationProperties.Name="Retry the log stream" />
                                    <Button Content="Start the guest" Style="{StaticResource ToolButton}"
                                            Height="26" MinHeight="26" Padding="10,0" FontSize="12" Margin="0,0,6,0"
                                            Command="{Binding StartCommand}"
                                            Visibility="{Binding LogEmpty.Action, Converter={StaticResource StringVis}, ConverterParameter=start}"
                                            AutomationProperties.Name="Start the guest for the log stream" />
                                    <Button Content="Resume" Style="{StaticResource ToolButton}"
                                            Height="26" MinHeight="26" Padding="10,0" FontSize="12" Margin="0"
                                            Command="{Binding ResumeLogCommand}"
                                            Visibility="{Binding LogEmpty.Action, Converter={StaticResource StringVis}, ConverterParameter=resume}"
                                            AutomationProperties.Name="Resume the log stream" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- The dock's resize grip: a 4 DIP strip with a centred 24 x 3 handle,
             sitting on the gap above the tab bar. Dragging it sets the dock height
             between 120 DIP and half the window; the height is remembered for the
             session only. It is present only while the dock is open. -->
        <Border x:Name="LogcatSplitter" Grid.Row="2" Grid.Column="1"
                Height="4" VerticalAlignment="Bottom" Margin="8,0,8,0" Background="Transparent"
                Cursor="SizeNS" Panel.ZIndex="6"
                MouseLeftButtonDown="OnLogcatSplitterDown"
                MouseMove="OnLogcatSplitterMove"
                MouseLeftButtonUp="OnLogcatSplitterUp"
                LostMouseCapture="OnLogcatSplitterLostCapture"
                Visibility="{Binding IsLogcatOpen, Converter={StaticResource BoolToVis}}"
                ToolTip="Drag to resize the Logcat dock"
                AutomationProperties.Name="Resize the Logcat dock">
            <Border Width="24" Height="3" CornerRadius="1.5" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Background="{DynamicResource BorderBrush}" />
        </Border>

        <!-- UX-08 full Logcat page (shot 07). It is the same retained line set and
             the same subscription as the dock, shown with a page header, a filter
             row and a 28 DIP table. It adds no backend: no PID column (the
             supervisor's event has none), no activity feed and no sample row. -->
        <Grid x:Name="LogcatPage" Grid.Row="2" Grid.Column="1"
              Background="{DynamicResource WindowBg}"
              Visibility="{Binding IsLogcatPage, Converter={StaticResource BoolToVis}}"
              AutomationProperties.Name="Logcat page">
            <Grid Margin="20,14,20,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header: back to Studio, the DIAGNOSTICS eyebrow, the title and
                     the live-stream sentence, then the page's actions. -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource IconButton}" Width="32" Height="32"
                            Margin="0,2,10,0" VerticalAlignment="Top"
                            Command="{Binding CloseLogcatPageCommand}"
                            ToolTip="Back to Studio"
                            AutomationProperties.Name="Back to Studio">
                        <Path Data="{StaticResource IconBack}" Style="{StaticResource Glyph}" />
                    </Button>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="DIAGNOSTICS" FontFamily="{StaticResource UiFont}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiary}" />
                        <TextBlock Text="Logcat" FontFamily="{StaticResource UiFont}"
                                   FontSize="24" FontWeight="SemiBold" LineHeight="32"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="Live stream from" Style="{StaticResource Caption}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LogSerial}" Style="{StaticResource Mono}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="5,0,0,0"
                                       ToolTip="{Binding LogSerial}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                Command="{Binding ToggleLogPauseCommand}"
                                ToolTip="Pause or resume the stream (Ctrl+P)"
                                AutomationProperties.Name="Pause or resume the log stream">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPause}" Style="{StaticResource Glyph}"
                                      Width="13" Height="13" Margin="0,0,6,0"
                                      Visibility="{Binding LogPaused, Converter={StaticResource InverseBoolToVis}}" />
                                <Path Data="{StaticResource IconPlay}" Style="{StaticResource Glyph}"
                                      Width="13" Height="13" Margin="0,0,6,0"
                                      Visibility="{Binding LogPaused, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="Pause" FontSize="13" VerticalAlignment="Center"
                                           Visibility="{Binding LogPaused, Converter={StaticResource InverseBoolToVis}}" />
                                <TextBlock Text="Resume" FontSize="13" VerticalAlignment="Center"
                                           Visibility="{Binding LogPaused, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                Command="{Binding CopyLogCommand}"
                                ToolTip="Copy the lines the filter shows (Ctrl+C copies the selection)"
                                AutomationProperties.Name="Copy the log">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCopy}" Style="{StaticResource Glyph}"
                                      Width="13" Height="13" Margin="0,0,6,0" />
                                <TextBlock Text="Copy" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Command="{Binding ClearLogCommand}"
                                ToolTip="Clear the retained lines (Ctrl+Shift+K)"
                                AutomationProperties.Name="Clear the log">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconTrash}" Style="{StaticResource Glyph}"
                                      Width="13" Height="13" Margin="0,0,6,0" />
                                <TextBlock Text="Clear" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- The page's single accent primary: the one action that
                             leaves the app with a file. -->
                        <Button Style="{StaticResource PrimaryButton}" Height="32" MinHeight="32"
                                Margin="0" Padding="12,0"
                                Command="{Binding ExportLogCommand}"
                                ToolTip="Write the retained lines to the workspace log folder (Ctrl+E)"
                                AutomationProperties.Name="Export the log">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDownload}" Width="13" Height="13"
                                      Stretch="Uniform" Stroke="{DynamicResource AccentText}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Export" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- The same err-soft band, sentence and Retry as the dock. -->
                <Border Grid.Row="1" Margin="0,0,0,12" Padding="10,6"
                        Background="{DynamicResource DangerBg}"
                        BorderBrush="{DynamicResource DangerBorder}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusControl}"
                        Visibility="{Binding HasLogcatError, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.Name="Log stream error">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Retry" Style="{StaticResource GhostButton}"
                                Height="26" MinHeight="26" Padding="10,0" Margin="10,0,0,0" FontSize="12"
                                VerticalAlignment="Center" Command="{Binding RetryLogcatCommand}"
                                ToolTip="Attach the log subscription again"
                                AutomationProperties.Name="Retry the log stream" />
                        <Path DockPanel.Dock="Left" Data="{StaticResource IconWarning}" Width="14" Height="14"
                              Stretch="Uniform" Stroke="{DynamicResource Danger}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding LogcatErrorText}" Style="{StaticResource Caption}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding LogcatErrorText}" />
                    </DockPanel>
                </Border>

                <!-- Filter row: 240 DIP search, the tag field, five level chips and
                     the stream chip on the right. -->
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource LogField}" Width="240" Height="32"
                            VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconSearch}"
                                  Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="14" Height="14" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Search message or tag"
                                       Style="{StaticResource Mono}" FontSize="12"
                                       Foreground="{DynamicResource TextTertiary}"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding LogSearch, Converter={StaticResource InverseTextToVis}}" />
                            <TextBox x:Name="LogPageSearchField" Grid.Column="1"
                                     Text="{Binding LogSearch, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     MinHeight="0" VerticalContentAlignment="Center"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     ToolTip="Search the message and the tag (Ctrl+F)"
                                     AutomationProperties.Name="Search logcat page" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource LogField}" Width="180" Height="32"
                            Margin="8,0,0,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconFilter}"
                                  Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="13" Height="13" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Filter by tag"
                                       Style="{StaticResource Mono}" FontSize="12"
                                       Foreground="{DynamicResource TextTertiary}"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding LogTag, Converter={StaticResource InverseTextToVis}}" />
                            <TextBox x:Name="LogPageTagField" Grid.Column="1"
                                     Text="{Binding LogTag, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     MinHeight="0" VerticalContentAlignment="Center"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     ToolTip="Filter by tag name"
                                     AutomationProperties.Name="Filter logcat page by tag" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <ToggleButton Style="{StaticResource LogLevelChip}"
                                      IsChecked="{Binding LogShowVerbose}"
                                      ToolTip="Show verbose (V) lines" AutomationProperties.Name="Verbose lines">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource LogLevelDot}" Background="{DynamicResource TextTertiary}" />
                                <TextBlock Text="Verbose" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource LogLevelChip}"
                                      IsChecked="{Binding LogShowDebug}"
                                      ToolTip="Show debug (D) lines" AutomationProperties.Name="Debug lines">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource LogLevelDot}" Background="{DynamicResource TextSecondary}" />
                                <TextBlock Text="Debug" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource LogLevelChip}"
                                      IsChecked="{Binding LogShowInfo}"
                                      ToolTip="Show info (I) lines" AutomationProperties.Name="Info lines">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource LogLevelDot}" Background="{DynamicResource Accent}" />
                                <TextBlock Text="Info" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource LogLevelChip}"
                                      IsChecked="{Binding LogShowWarn}"
                                      ToolTip="Show warning (W) lines" AutomationProperties.Name="Warning lines">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource LogLevelDot}" Background="{DynamicResource Warning}" />
                                <TextBlock Text="Warn" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource LogLevelChip}"
                                      IsChecked="{Binding LogShowError}"
                                      ToolTip="Show error (E) lines" AutomationProperties.Name="Error lines">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource LogLevelDot}" Background="{DynamicResource Danger}" />
                                <TextBlock Text="Error" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <Border Grid.Column="4" Style="{StaticResource LogPageStateChip}"
                            ToolTip="{Binding LogPageState.Tooltip}"
                            AutomationProperties.Name="Log stream state"
                            AutomationProperties.HelpText="{Binding LogPageState.Tooltip}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource LogPageStateDot}" />
                            <!-- One paused indicator: while the stream is held this
                                 chip carries the real buffered count. -->
                            <TextBlock Text="{Binding LogPausedText}" Style="{StaticResource StatePillText}"
                                       Foreground="{DynamicResource Warning}"
                                       Visibility="{Binding LogPaused, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding LogPageState.Text}" Style="{StaticResource StatePillText}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Visibility="{Binding LogPaused, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Table: one 12 radius card, a sticky 32 DIP header in 11 DIP caps,
                     then 28 DIP rows with hairline dividers and no zebra. -->
                <Border Grid.Row="3" Style="{StaticResource LogPageCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource LogHeaderBg}" />
                        <Grid Grid.Row="0" Height="32" Margin="14,0,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TIME" Style="{StaticResource LogHeaderCell}" />
                            <TextBlock Grid.Column="1" Text="LVL" Style="{StaticResource LogHeaderCell}" />
                            <TextBlock Grid.Column="2" Text="TAG" Style="{StaticResource LogHeaderCell}" />
                            <TextBlock Grid.Column="3" Text="MESSAGE" Style="{StaticResource LogHeaderCell}" />
                        </Grid>
                        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                                Background="{DynamicResource BorderSubtle}" />

                        <ListBox x:Name="LogPageList" Grid.Row="1" ItemsSource="{Binding LogView}"
                                 Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource LogPageRowItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 SelectionMode="Extended"
                                 AutomationProperties.Name="Logcat page entries">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy selected lines" InputGestureText="Ctrl+C"
                                              Click="OnCopySelectedLog" />
                                    <MenuItem Header="Copy all filtered lines"
                                              Command="{Binding CopyLogCommand}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="28" Margin="14,0,14,0"
                                          AutomationProperties.Name="{Binding AccessibleLine}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Time}" Style="{StaticResource Mono}"
                                                   FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Style="{StaticResource LogLevelGlyph}" HorizontalAlignment="Left" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Level}" Style="{StaticResource LogLevelGlyphText}" />
                                        </Border>
                                        <views:HighlightTextBlock Grid.Column="2" TextValue="{Binding Tag}"
                                            HighlightIndexes="{Binding TagHighlightIndexes}"
                                            MarkMatches="True"
                                            Style="{StaticResource LogTagText}"
                                            Margin="0,0,12,0" ToolTip="{Binding Tag}" />
                                        <!-- Search hits are painted by the palette's own
                                             HighlightTextBlock, so the page and the
                                             palette mark a match the same way. The
                                             offsets are computed with the same
                                             case-insensitive comparison as the filter. -->
                                        <views:HighlightTextBlock Grid.Column="3"
                                                                  Style="{StaticResource LogMessageText}"
                                                                  TextValue="{Binding Message}"
                                                                  HighlightIndexes="{Binding HighlightIndexes}"
                                                                  MarkMatches="True"
                                                                  ToolTip="{Binding Message}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- The page's calm empty state: the two states the brief
                             names, plus the guest/subscription cases that can be
                             fixed from here. -->
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MaxWidth="440" Margin="16,0"
                                    Visibility="{Binding ShowLogPageEmpty, Converter={StaticResource BoolToVis}}">
                            <Path Data="{StaticResource IconLogs}" Width="22" Height="22" Stretch="Uniform"
                                  Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding LogPageEmpty.Title}" Style="{StaticResource Body}"
                                       FontSize="13" Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding LogPageEmpty.Detail}" Style="{StaticResource Caption}"
                                       FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                <Button Content="Clear filters" Style="{StaticResource GhostButton}"
                                        Height="28" MinHeight="28" Padding="10,0" FontSize="12" Margin="0,0,6,0"
                                        Command="{Binding ClearLogFiltersCommand}"
                                        Visibility="{Binding LogPageEmpty.Action, Converter={StaticResource StringVis}, ConverterParameter=filters}"
                                        AutomationProperties.Name="Clear the Logcat filters" />
                                <Button Content="Retry" Style="{StaticResource GhostButton}"
                                        Height="28" MinHeight="28" Padding="10,0" FontSize="12" Margin="0,0,6,0"
                                        Command="{Binding RetryLogcatCommand}"
                                        Visibility="{Binding LogPageEmpty.Action, Converter={StaticResource StringVis}, ConverterParameter=retry}"
                                        AutomationProperties.Name="Retry the log stream" />
                                <Button Content="Start the guest" Style="{StaticResource GhostButton}"
                                        Height="28" MinHeight="28" Padding="10,0" FontSize="12" Margin="0,0,6,0"
                                        Command="{Binding StartCommand}"
                                        Visibility="{Binding LogPageEmpty.Action, Converter={StaticResource StringVis}, ConverterParameter=start}"
                                        AutomationProperties.Name="Start the guest for the log stream" />
                                <Button Content="Resume" Style="{StaticResource GhostButton}"
                                        Height="28" MinHeight="28" Padding="10,0" FontSize="12" Margin="0"
                                        Command="{Binding ResumeLogCommand}"
                                        Visibility="{Binding LogPageEmpty.Action, Converter={StaticResource StringVis}, ConverterParameter=resume}"
                                        AutomationProperties.Name="Resume the log stream" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar (UX-05, MEDIUM 9; fix pass item 8): REAL segments only.
             ADB serial, FPS from the capture stream, GPU mode and the supervisor
             state, then the Agents and Workspace destinations. The CPU, RAM and
             em-dash uid segments are gone: a metric the supervisor does not
             report is not rendered at all. The uid appears only when a real value
             is already known, and that costs no supervisor call. The workspace
             path stays a tooltip, never on screen. -->
        <Border Grid.Row="5" Grid.Column="1" Background="{DynamicResource StatusBarBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconDevice}" Width="11" Height="11" Stretch="Uniform"
                          Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.4"
                          VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBlock Text="ADB" Style="{StaticResource StatusLabel}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding StatusSerial}" Style="{StaticResource StatusValue}"
                               ToolTip="{Binding StatusSerialTooltip}" />

                    <!-- uid only when the supervisor has already reported one. -->
                    <Border Style="{StaticResource StatusDivider}"
                            Visibility="{Binding HasAdbUid, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusUid}" Style="{StaticResource StatusValue}"
                               ToolTip="{Binding AdbUidTooltip}"
                               Visibility="{Binding HasAdbUid, Converter={StaticResource BoolToVis}}" />

                    <Border Style="{StaticResource StatusDivider}" />
                    <TextBlock Text="FPS" Style="{StaticResource StatusLabel}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding TelemetryFpsValue}" Style="{StaticResource StatusValue}"
                               ToolTip="{Binding FrameRateText}" />

                    <Border Style="{StaticResource StatusDivider}" />
                    <Path Data="{StaticResource IconChip}" Width="11" Height="11" Stretch="Uniform"
                          Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.4"
                          VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBlock Text="GPU" Style="{StaticResource StatusLabel}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding StatusGpu}" Style="{StaticResource StatusValue}"
                               ToolTip="{Binding StatusGpuTooltip}" />
                </StackPanel>

                <!-- The bar holds segments only. A transient sentence is a toast; the
                     one exception is an error that has no error bar of its own, so a
                     failure is never silent. -->
                <Grid Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}"
                               Style="{StaticResource StatusLabel}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="420"
                               ToolTip="{Binding ErrorMessage}"
                               Visibility="{Binding ShowStatusError, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- igr-feedback-ux11: the agents segment is the first to go at
                         1024; the rail still reaches Agent Sessions. -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding NarrowLayout, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}">
                        <Button Style="{StaticResource StatusLink}" Click="OnAgents"
                                ToolTip="Agent sessions: pairings, scopes and takeover"
                                AutomationProperties.Name="Agent sessions">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconAgents}" Width="11" Height="11" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="Agents" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Style="{StaticResource StatusDivider}" />
                    </StackPanel>
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,5,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource Danger}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Success}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatusLabel}">
                                <Setter Property="Text" Value="Supervisor not connected" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Text" Value="Supervisor connected" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Style="{StaticResource StatusDivider}" />
                    <!-- Item 11: the workspace temp path is a tooltip, not a
                         status-bar value. -->
                    <Path Data="{StaticResource IconStack}" Width="11" Height="11" Stretch="Uniform"
                          Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.4"
                          VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBlock Text="Workspace" Style="{StaticResource StatusLabel}"
                               VerticalAlignment="Center"
                               ToolTip="{Binding WorkspaceRoot}"
                               AutomationProperties.Name="Workspace root"
                               AutomationProperties.HelpText="{Binding WorkspaceRoot}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- UX-06 settings slide-over (polish addendum item 8). A 460 DIP panel
             on the right over a 50 % scrim, 220 ms on cubic-bezier(0.22,1,0.36,1)
             (instant under reduced motion), Esc and a scrim click close it, focus
             cycles inside while it is open and returns to the opener on close.
             It is a child of the window grid, never a second OS window. The
             tabs hold only groups that exist in code: Appearance (the real theme
             and the two Windows policies), Shortcuts (the gestures this build
             already handles) and Diagnostics (the real redaction/export paths). -->
        <Grid x:Name="SettingsDrawerHost" Grid.Row="0" Grid.RowSpan="6"
              Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="40"
              Visibility="Collapsed"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle"
              AutomationProperties.Name="Settings drawer">
            <Border x:Name="SettingsScrim" Background="{DynamicResource SettingsScrimBg}"
                    MouseLeftButtonDown="OnSettingsScrimClick" />
            <Grid x:Name="SettingsDrawerShell" Width="460" HorizontalAlignment="Right">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="SettingsDrawerSlide" X="0" />
                </Grid.RenderTransform>

                <Border Style="{StaticResource SettingsDrawerAmbient}" />
                <Border Style="{StaticResource SettingsDrawerSurface}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Specular edges of the floating surface: 1 DIP along
                             the top and down the leading edge, on the theme's
                             specular gradient so neither theme needs a fade of
                             its own. -->
                        <Border Height="1" Margin="12,0,0,0" VerticalAlignment="Top" IsHitTestVisible="False"
                                Background="{DynamicResource SpecularEdge}" />
                        <Border Width="1" VerticalAlignment="Stretch" HorizontalAlignment="Left"
                                IsHitTestVisible="False" Background="{DynamicResource SpecularEdge}" />

                        <!-- Header: exactly 56 DIP, "Settings" at 16 SemiBold and a
                             32 DIP ghost close on the right. The eyebrow and the
                             subtitle the first pass carried are gone: the spec
                             fixes the header height, and the tab names already
                             say what the drawer holds. -->
                        <Grid Grid.Row="0" Height="56" Margin="24,0,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Settings" FontFamily="{StaticResource UiFont}"
                                       FontSize="16" FontWeight="SemiBold" LineHeight="24"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="SettingsCloseButton" Grid.Column="1"
                                    Style="{StaticResource SettingsCloseButton}"
                                    Click="OnCloseSettings" ToolTip="Close (Esc)"
                                    AutomationProperties.Name="Close settings">
                                <Path Data="{StaticResource IconClose}" Style="{StaticResource Glyph}" />
                            </Button>
                        </Grid>

                        <TabControl x:Name="SettingsTabs" Grid.Row="1" Margin="24,0,24,0"
                                    Style="{StaticResource SettingsTabs}"
                                    ItemContainerStyle="{StaticResource SettingsTab}"
                                    AutomationProperties.Name="Settings sections">

                            <!-- 1. Appearance: the real theme switch plus the two
                                 Windows policies the app actually honours. There
                                 is no preference store, so the theme row says so
                                 instead of promising persistence. -->
                            <TabItem Header="Appearance" AutomationProperties.Name="Settings Appearance">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="0,0,4,16">
                                        <TextBlock Text="THEME" Style="{StaticResource RowSection}"
                                                   Margin="2,0,0,6" />
                                        <Border Style="{StaticResource SettingsCard}">
                                            <Grid MinHeight="64" Margin="16,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,10,12,10">
                                                    <TextBlock Text="Theme" Style="{StaticResource SettingsRowLabel}" />
                                                    <TextBlock Style="{StaticResource SettingsRowDescription}"
                                                               Text="Applies now · resets on next launch" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <!-- The quiet confirmation the spec asks for:
                                                         an ok-soft tick on the row for 1.5 s,
                                                         never a modal or an Apply footer. -->
                                                    <Border x:Name="ThemeSavedTick" Visibility="Collapsed"
                                                            Background="{DynamicResource SuccessBg}"
                                                            BorderBrush="{DynamicResource SuccessBorder}"
                                                            BorderThickness="1" CornerRadius="999"
                                                            Padding="7,2" Margin="0,0,8,0"
                                                            AutomationProperties.Name="Theme saved">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconCheck}" Width="11" Height="11"
                                                                  Stretch="Uniform" Stroke="{DynamicResource Success}"
                                                                  StrokeThickness="1.8" StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                                            <TextBlock Text="Saved" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Success}"
                                                                       Margin="4,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource SettingsSegment}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <RadioButton Content="Dark" Tag="Dark"
                                                                         GroupName="SettingsTheme"
                                                                         Style="{StaticResource SettingsSegmentRadio}"
                                                                         IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                                                         Checked="OnThemeChoice"
                                                                         ToolTip="Graphite Studio dark surfaces"
                                                                         AutomationProperties.Name="Dark theme" />
                                                            <RadioButton Content="Light" Tag="Light"
                                                                         GroupName="SettingsTheme"
                                                                         Style="{StaticResource SettingsSegmentRadio}"
                                                                         IsChecked="{Binding IsLightTheme, Mode=TwoWay}"
                                                                         Checked="OnThemeChoice"
                                                                         ToolTip="Porcelain light surfaces"
                                                                         AutomationProperties.Name="Light theme" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- UX-07 fix pass: the eyebrow is SYSTEM,
                                             with the origin on the right and the
                                             explanation in an info tooltip, so the
                                             card ends on its two rows. -->
                                        <Grid Margin="2,18,0,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="SYSTEM" Style="{StaticResource RowSection}"
                                                           VerticalAlignment="Center" />
                                                <Path Data="{StaticResource IconInfo}" Width="12" Height="12"
                                                      Stretch="Uniform" Stroke="{DynamicResource TextTertiary}"
                                                      StrokeThickness="1.5" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" VerticalAlignment="Center"
                                                      Margin="6,0,0,0"
                                                      ToolTip="Both are Windows policies the app honours and never overrides. High contrast is not a third theme: while it is on, the system palette replaces the selected theme." />
                                            </StackPanel>
                                            <TextBlock Text="Managed by Windows" FontSize="11"
                                                       Foreground="{DynamicResource TextTertiary}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Style="{StaticResource SettingsCard}">
                                            <StackPanel>
                                                <Grid MinHeight="56" Margin="16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,9,12,9">
                                                        <TextBlock Text="Animation effects"
                                                                   Style="{StaticResource SettingsRowLabel}" />
                                                        <TextBlock Style="{StaticResource SettingsRowDescription}"
                                                                   Text="Reduced motion drops every drawer, hover and pulse animation." />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Style="{StaticResource SettingsReadOnlyChip}">
                                                        <TextBlock Text="{Binding MotionState}" FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondary}" />
                                                    </Border>
                                                </Grid>
                                                <Border Style="{StaticResource SettingsDivider}" />
                                                <Grid MinHeight="56" Margin="16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,9,12,9">
                                                        <TextBlock Text="High contrast"
                                                                   Style="{StaticResource SettingsRowLabel}" />
                                                        <TextBlock Style="{StaticResource SettingsRowDescription}"
                                                                   Text="Wins over the theme with system colours." />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Style="{StaticResource SettingsReadOnlyChip}">
                                                        <TextBlock Text="{Binding HighContrastState}" FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondary}" />
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- 2. Shortcuts: every gesture this build handles, in
                                 Cascadia Mono chips. Read-only, because there is
                                 no key-binding store to rebind against. -->
                            <TabItem Header="Shortcuts" AutomationProperties.Name="Settings Shortcuts">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="0,0,4,16">
                                        <TextBlock Text="STUDIO" Style="{StaticResource RowSection}"
                                                   Margin="2,0,0,6" />
                                        <Border Style="{StaticResource SettingsCard}">
                                            <StackPanel>
                                                <Grid MinHeight="56" Margin="16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,9,12,9">
                                                        <TextBlock Text="Command palette"
                                                                   Style="{StaticResource SettingsRowLabel}" />
                                                        <TextBlock Style="{StaticResource SettingsRowDescription}"
                                                                   Text="Searches every command this build registers." />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Border Style="{StaticResource KeyChip}">
                                                            <TextBlock Text="Ctrl" Style="{StaticResource KeyChipText}" />
                                                        </Border>
                                                        <TextBlock Text="+" Style="{StaticResource Caption}"
                                                                   Foreground="{DynamicResource TextTertiary}"
                                                                   Margin="4,0" VerticalAlignment="Center" />
                                                        <Border Style="{StaticResource KeyChip}">
                                                            <TextBlock Text="K" Style="{StaticResource KeyChipText}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                                <Border Style="{StaticResource SettingsDivider}" />
                                                <Grid MinHeight="56" Margin="16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,9,12,9">
                                                        <TextBlock Text="Fullscreen"
                                                                   Style="{StaticResource SettingsRowLabel}" />
                                                        <TextBlock Style="{StaticResource SettingsRowDescription}"
                                                                   Text="Immersive stage; Esc leaves it." />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Style="{StaticResource KeyChip}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="F11" Style="{StaticResource KeyChipText}" />
                                                    </Border>
                                                </Grid>
                                                <Border Style="{StaticResource SettingsDivider}" />
                                                <Grid MinHeight="56" Margin="16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,9,12,9">
                                                        <TextBlock Text="Close the open overlay"
                                                                   Style="{StaticResource SettingsRowLabel}" />
                                                        <TextBlock Style="{StaticResource SettingsRowDescription}"
                                                                   Text="This drawer, or the command palette." />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Style="{StaticResource KeyChip}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="Esc" Style="{StaticResource KeyChipText}" />
                                                    </Border>
                                                </Grid>
                                                <Border Style="{StaticResource SettingsDivider}" />
                                                <Grid MinHeight="56" Margin="16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,9,12,9">
                                                        <TextBlock Text="Zoom the viewport"
                                                                   Style="{StaticResource SettingsRowLabel}" />
                                                        <TextBlock Style="{StaticResource SettingsRowDescription}"
                                                                   Text="Around the pointer, in 10 % steps." />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Border Style="{StaticResource KeyChip}">
                                                            <TextBlock Text="Ctrl" Style="{StaticResource KeyChipText}" />
                                                        </Border>
                                                        <TextBlock Text="+" Style="{StaticResource Caption}"
                                                                   Foreground="{DynamicResource TextTertiary}"
                                                                   Margin="4,0" VerticalAlignment="Center" />
                                                        <Border Style="{StaticResource KeyChip}">
                                                            <TextBlock Text="wheel" Style="{StaticResource KeyChipText}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="COMMAND PALETTE" Style="{StaticResource RowSection}"
                                                   Margin="2,18,0,6" />
                                        <Border Style="{StaticResource SettingsCard}">
                                            <StackPanel>
                                                <Grid MinHeight="52" Margin="16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Run the selected command"
                                                               Style="{StaticResource SettingsRowLabel}"
                                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                                    <Border Grid.Column="1" Style="{StaticResource KeyChip}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="Enter" Style="{StaticResource KeyChipText}" />
                                                    </Border>
                                                </Grid>
                                                <Border Style="{StaticResource SettingsDivider}" />
                                                <Grid MinHeight="52" Margin="16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Close without running anything"
                                                               Style="{StaticResource SettingsRowLabel}"
                                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                                    <Border Grid.Column="1" Style="{StaticResource KeyChip}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="Esc" Style="{StaticResource KeyChipText}" />
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Style="{StaticResource Caption}" FontSize="12"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   TextWrapping="Wrap" Margin="2,12,0,0"
                                                   Text="Read-only. Each gesture is bound once in code; this build has no key-binding store, so nothing can be reassigned and there is no conflict check to show." />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- 3. Diagnostics: the same redacted copy, the same
                                 logcat export, the same error bar state and the
                                 real paths. One accent primary in the drawer;
                                 everything else is a ghost. -->
                            <TabItem Header="Diagnostics" AutomationProperties.Name="Settings Diagnostics">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="0,0,4,16">
                                        <!-- err-soft infobar with Retry, mirroring
                                             the window's error bar: while the
                                             drawer is open the scrim hides that
                                             bar, so the same state is shown here
                                             instead of in two places at once. -->
                                        <Border Background="{DynamicResource DangerBg}"
                                                BorderBrush="{DynamicResource DangerBorder}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusCard}"
                                                Margin="0,0,0,14"
                                                Visibility="{Binding HasErrorBar, Converter={StaticResource BoolToVis}}"
                                                AutomationProperties.Name="Diagnostics error">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{DynamicResource Danger}" CornerRadius="10,0,0,10" />
                                                <StackPanel Grid.Column="1" Margin="12,10">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconWarning}"
                                                              Stroke="{DynamicResource Danger}" StrokeThickness="1.5"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round" Width="14" Height="14"
                                                              Stretch="None" VerticalAlignment="Top"
                                                              Margin="0,2,8,0" />
                                                        <TextBlock Text="{Binding ErrorBarTitle}" FontSize="13"
                                                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextPrimary}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ErrorBarText}"
                                                               Style="{StaticResource Caption}"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               TextWrapping="Wrap" Margin="22,3,0,0" />
                                                    <TextBlock Text="{Binding ErrorBarAction}"
                                                               Style="{StaticResource Caption}"
                                                               Foreground="{DynamicResource TextTertiary}"
                                                               TextWrapping="Wrap" Margin="22,3,0,0" />
                                                    <StackPanel Orientation="Horizontal" Margin="22,8,0,0">
                                                        <Button Content="Retry" Style="{StaticResource ToolButton}"
                                                                Command="{Binding RefreshCommand}"
                                                                Visibility="{Binding ShowErrorRetry, Converter={StaticResource BoolToVis}}"
                                                                ToolTip="Re-read the supervisor, the SDK report and the device state"
                                                                AutomationProperties.Name="Retry the failed operation" />
                                                        <Button Content="Dismiss" Style="{StaticResource ToolButton}"
                                                                Command="{Binding DismissErrorCommand}" Margin="0"
                                                                AutomationProperties.Name="Dismiss the error" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="ACTIONS" Style="{StaticResource RowSection}"
                                                   Margin="2,0,0,6" />
                                        <Border Style="{StaticResource SettingsCard}">
                                            <StackPanel>
                                                <Grid MinHeight="56" Margin="16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,9,12,9">
                                                        <TextBlock Text="Copy diagnostics"
                                                                   Style="{StaticResource SettingsRowLabel}" />
                                                        <TextBlock Style="{StaticResource SettingsRowDescription}"
                                                                   Text="The supervisor's redacted summary, ready to paste." />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Copy diagnostics"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Height="32" Padding="12,0" MinWidth="136" Margin="0"
                                                            Command="{Binding CopyDiagnosticsCommand}"
                                                            ToolTip="Copy the supervisor's redacted diagnostics summary"
                                                            AutomationProperties.Name="Copy diagnostics" />
                                                </Grid>
                                                <Border Style="{StaticResource SettingsDivider}" />
                                                <Grid MinHeight="56" Margin="16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,9,12,9">
                                                        <TextBlock Text="Export logcat"
                                                                   Style="{StaticResource SettingsRowLabel}" />
                                                        <TextBlock Style="{StaticResource SettingsRowDescription}"
                                                                   Text="Writes the retained lines to the workspace log folder." />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Export logcat"
                                                            Style="{StaticResource GhostButton}" MinWidth="136" Margin="0"
                                                            Command="{Binding ExportLogCommand}"
                                                            ToolTip="Write the retained Logcat lines to the workspace log folder"
                                                            AutomationProperties.Name="Export logcat" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- UX-07 fix pass: Inspector-style
                                             label/value rows. Every value is a
                                             real field of the supervisor's
                                             report, mono, one line, middle
                                             ellipsis, full text in the tooltip;
                                             the copy action on the right hands
                                             over the raw report. -->
                                        <Grid Margin="2,18,0,6">
                                            <TextBlock Text="DOCTOR" Style="{StaticResource RowSection}"
                                                       VerticalAlignment="Center" />
                                            <Button HorizontalAlignment="Right" Style="{StaticResource SettingsIconButton}"
                                                    Width="28" Height="28" Margin="0"
                                                    Click="OnCopyDoctor"
                                                    ToolTip="Copy the raw doctor report"
                                                    AutomationProperties.Name="Copy doctor report">
                                                <Path Data="{StaticResource IconCopy}" Style="{StaticResource Glyph}" />
                                            </Button>
                                        </Grid>
                                        <Border Style="{StaticResource SettingsCard}">
                                            <StackPanel>
                                                <Grid MinHeight="32" Margin="16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="SDK" Style="{StaticResource RowLabel}" />
                                                    <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                                               Text="{Binding DoctorSdk, Converter={StaticResource MiddleEllipsis}, ConverterParameter=44}"
                                                               ToolTip="{Binding DoctorSdk}"
                                                               Style="{StaticResource SettingsDoctorValue}" />
                                                </Grid>
                                                <Border Style="{StaticResource SettingsDivider}" />
                                                <Grid MinHeight="32" Margin="16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Emulator" Style="{StaticResource RowLabel}" />
                                                    <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                                               Text="{Binding DoctorEmulator, Converter={StaticResource MiddleEllipsis}, ConverterParameter=44}"
                                                               ToolTip="{Binding DoctorEmulator}"
                                                               Style="{StaticResource SettingsDoctorValue}" />
                                                </Grid>
                                                <Border Style="{StaticResource SettingsDivider}" />
                                                <Grid MinHeight="32" Margin="16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Image" Style="{StaticResource RowLabel}" />
                                                    <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                                               Text="{Binding DoctorImage, Converter={StaticResource MiddleEllipsis}, ConverterParameter=44}"
                                                               ToolTip="{Binding DoctorImageTooltip}"
                                                               Style="{StaticResource SettingsDoctorValue}" />
                                                </Grid>
                                                <Border Style="{StaticResource SettingsDivider}" />
                                                <Grid MinHeight="32" Margin="16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="ADB" Style="{StaticResource RowLabel}" />
                                                    <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                                               Text="{Binding DoctorAdb, Converter={StaticResource MiddleEllipsis}, ConverterParameter=44}"
                                                               ToolTip="{Binding DoctorAdb}"
                                                               Style="{StaticResource SettingsDoctorValue}" />
                                                </Grid>
                                                <Border Style="{StaticResource SettingsDivider}" />
                                                <Grid MinHeight="32" Margin="16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Acceleration" Style="{StaticResource RowLabel}" />
                                                    <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                                               Text="{Binding DoctorAcceleration, Converter={StaticResource MiddleEllipsis}, ConverterParameter=44}"
                                                               ToolTip="{Binding DoctorAccelerationTooltip}"
                                                               Style="{StaticResource SettingsDoctorValue}" />
                                                    <Border Grid.Column="2" Style="{StaticResource SettingsOkChip}"
                                                            Visibility="{Binding DoctorAccelerationReady, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Ready" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Success}" />
                                                    </Border>
                                                </Grid>
                                                <Border Style="{StaticResource SettingsDivider}" />
                                                <Grid MinHeight="32" Margin="16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="GPU" Style="{StaticResource RowLabel}" />
                                                    <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                                               Text="{Binding DoctorGpu, Converter={StaticResource MiddleEllipsis}, ConverterParameter=44}"
                                                               ToolTip="{Binding DoctorGpuTooltip}"
                                                               Style="{StaticResource SettingsDoctorValue}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="PATHS" Style="{StaticResource RowSection}"
                                                   Margin="2,18,0,6" />
                                        <Border Style="{StaticResource SettingsCard}">
                                            <StackPanel>
                                                <Grid MinHeight="56" Margin="16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,9,10,9">
                                                        <TextBlock Text="Workspace" Style="{StaticResource SettingsRowLabel}" />
                                                        <TextBlock Style="{StaticResource SettingsPathValue}"
                                                                   Margin="0,2,0,0"
                                                                   Text="{Binding WorkspaceRoot, Converter={StaticResource MiddleEllipsis}}"
                                                                   ToolTip="{Binding WorkspaceRoot}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button Style="{StaticResource SettingsIconButton}" Margin="0,0,2,0"
                                                                Tag="{Binding WorkspaceRoot}" Click="OnCopySettingsPath"
                                                                ToolTip="Copy this path" AutomationProperties.Name="Copy workspace path">
                                                            <Path Data="{StaticResource IconCopy}" Style="{StaticResource Glyph}" />
                                                        </Button>
                                                        <Button Style="{StaticResource SettingsIconButton}"
                                                                Tag="{Binding WorkspaceRoot}" Click="OnOpenSettingsPath"
                                                                ToolTip="Open this folder in Explorer" AutomationProperties.Name="Open workspace folder">
                                                            <Path Data="{StaticResource IconFolder}" Style="{StaticResource Glyph}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                                <Border Style="{StaticResource SettingsDivider}" />
                                                <Grid MinHeight="56" Margin="16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,9,10,9">
                                                        <TextBlock Text="Captures" Style="{StaticResource SettingsRowLabel}" />
                                                        <TextBlock Style="{StaticResource SettingsPathValue}"
                                                                   Margin="0,2,0,0"
                                                                   Text="{Binding CapturesFolder, Converter={StaticResource MiddleEllipsis}}"
                                                                   ToolTip="{Binding CapturesFolder}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button Style="{StaticResource SettingsIconButton}" Margin="0,0,2,0"
                                                                Tag="{Binding CapturesFolder}" Click="OnCopySettingsPath"
                                                                ToolTip="Copy this path" AutomationProperties.Name="Copy captures path">
                                                            <Path Data="{StaticResource IconCopy}" Style="{StaticResource Glyph}" />
                                                        </Button>
                                                        <Button Style="{StaticResource SettingsIconButton}"
                                                                Tag="{Binding CapturesFolder}" Click="OnOpenSettingsPath"
                                                                ToolTip="Open this folder in Explorer" AutomationProperties.Name="Open captures folder">
                                                            <Path Data="{StaticResource IconFolder}" Style="{StaticResource Glyph}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                                <Border Style="{StaticResource SettingsDivider}" />
                                                <Grid MinHeight="56" Margin="16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,9,10,9">
                                                        <TextBlock Text="Logs" Style="{StaticResource SettingsRowLabel}" />
                                                        <TextBlock Style="{StaticResource SettingsPathValue}"
                                                                   Margin="0,2,0,0"
                                                                   Text="{Binding LogsFolder, Converter={StaticResource MiddleEllipsis}}"
                                                                   ToolTip="{Binding LogsFolder}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button Style="{StaticResource SettingsIconButton}" Margin="0,0,2,0"
                                                                Tag="{Binding LogsFolder}" Click="OnCopySettingsPath"
                                                                ToolTip="Copy this path" AutomationProperties.Name="Copy logs path">
                                                            <Path Data="{StaticResource IconCopy}" Style="{StaticResource Glyph}" />
                                                        </Button>
                                                        <Button Style="{StaticResource SettingsIconButton}"
                                                                Tag="{Binding LogsFolder}" Click="OnOpenSettingsPath"
                                                                ToolTip="Open this folder in Explorer" AutomationProperties.Name="Open logs folder">
                                                            <Path Data="{StaticResource IconFolder}" Style="{StaticResource Glyph}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- The last capture exists only after a real
                                             capture in this session; with none, the
                                             whole group is absent rather than an
                                             empty card. -->
                                        <StackPanel Visibility="{Binding HasToastPath, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="LAST CAPTURE" Style="{StaticResource RowSection}"
                                                       Margin="2,18,0,6" />
                                            <Border Style="{StaticResource SettingsCard}">
                                                <Grid MinHeight="56" Margin="16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,9,10,9">
                                                        <TextBlock Text="Last file" Style="{StaticResource SettingsRowLabel}" />
                                                        <TextBlock Style="{StaticResource SettingsPathValue}" Margin="0,2,0,0"
                                                                   Text="{Binding ScreenshotPath, Converter={StaticResource MiddleEllipsis}}"
                                                                   ToolTip="{Binding ScreenshotPath}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button Style="{StaticResource SettingsIconButton}" Margin="0,0,2,0"
                                                                Command="{Binding CopyToastCommand}"
                                                                ToolTip="Copy the last file's path" AutomationProperties.Name="Copy the last saved path">
                                                            <Path Data="{StaticResource IconCopy}" Style="{StaticResource Glyph}" />
                                                        </Button>
                                                        <Button Style="{StaticResource SettingsIconButton}"
                                                                Command="{Binding OpenToastCommand}"
                                                                ToolTip="Show the last file in Explorer" AutomationProperties.Name="Open the last saved file">
                                                            <Path Data="{StaticResource IconFolder}" Style="{StaticResource Glyph}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="ABOUT" Style="{StaticResource RowSection}"
                                                   Margin="2,18,0,6" />
                                        <Border Style="{StaticResource SettingsCard}">
                                            <StackPanel>
                                                <Grid MinHeight="52" Margin="16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Version" Style="{StaticResource SettingsRowLabel}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding AppVersion}"
                                                               Style="{StaticResource SettingsRowValue}"
                                                               FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                               ToolTip="{Binding AppVersion}" />
                                                </Grid>
                                                <StackPanel Visibility="{Binding HasAppCommit, Converter={StaticResource BoolToVis}}">
                                                    <Border Style="{StaticResource SettingsDivider}" />
                                                    <Grid MinHeight="52" Margin="16,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Commit" Style="{StaticResource SettingsRowLabel}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding AppCommit}"
                                                                   Style="{StaticResource SettingsRowValue}"
                                                                   FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                                   ToolTip="{Binding AppCommit}" />
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
