<Window x:Class="EmulatorWorkspace.Desktop.DeviceLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:views="clr-namespace:EmulatorWorkspace.Desktop.Views"
        Title="Emulator Workspace - Devices"
        Width="1320" Height="840" MinWidth="1024" MinHeight="640"
        Background="{DynamicResource WindowBg}"
        KeyDown="OnKeyDown">

    <Window.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVis" />
        <views:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <views:TextToVisibilityConverter x:Key="TextToVis" />
        <views:TextToVisibilityConverter x:Key="EmptyToVis" Invert="True" />
        <views:StringEqualsToVisibilityConverter x:Key="KindVis" />
        <views:ToneToBrushConverter x:Key="ToneBrush" />

        <!-- Chips kept short: mono for identifiers and numbers. -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ChipBg}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ChipText" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <!-- Summary counters stay in the display face like the mockup, but with
             tabular figures and a fixed minimum width so a count that ticks from
             9 to 10 never shifts the card. Streaming numbers (frame rate, frame
             size, dropped, log lines) are mono + tabular instead. -->
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource PageText}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="MinWidth" Value="30" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="FieldError" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- UX-04b fix pass (item 7): drawer detail rows are label-left,
             value-right, on one line each. A long value ellipsizes instead of
             wrapping mid-token and keeps the whole string in its tooltip. -->
        <Style x:Key="DrawerRowLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="DrawerRowValue" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <!-- A value that is a state word, not a number: the wording carries the
             state and the tone only tints it. -->
        <Style x:Key="DrawerRowWord" TargetType="TextBlock" BasedOn="{StaticResource DrawerRowValue}">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        </Style>

        <!-- A tone chip inside a drawer row ("WHPX ready", "Enough space"): soft
             fill, 1px tone edge, tone text. The fill is bound per call site from
             the tone the view model reports, so nothing here is a literal. -->
        <Style x:Key="ValueChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,1,8,1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="ValueChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- UX-04b fix pass (item 1): the media strip behind the drawn device is
             the viewport colour plus a 12 % radial glow of the state tint; the
             screen itself is a soft vertical gradient of the same tint between
             45 % and 35 %. Both are DataTriggers on theme brushes, so a live
             theme switch repaints instead of leaving a frozen tint behind. -->
        <Style x:Key="CardMediaStage" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ViewportBg}" />
        </Style>

        <Style x:Key="CardGlow" TargetType="Ellipse">
            <Setter Property="Width" Value="196" />
            <Setter Property="Height" Value="164" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Fill" Value="{DynamicResource CardGlowIdle}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateKey}" Value="running">
                    <Setter Property="Fill" Value="{DynamicResource CardGlowRunning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="starting">
                    <Setter Property="Fill" Value="{DynamicResource CardGlowAttention}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="stopping">
                    <Setter Property="Fill" Value="{DynamicResource CardGlowAttention}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="failed">
                    <Setter Property="Fill" Value="{DynamicResource CardGlowAttention}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="dead">
                    <Setter Property="Fill" Value="{DynamicResource CardGlowAttention}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="stopped">
                    <Setter Property="Fill" Value="{DynamicResource CardGlowStopped}" />
                </DataTrigger>
                <!-- "Not started" (a Defined record) is the neutral tint. -->
                <DataTrigger Binding="{Binding State}" Value="Defined">
                    <Setter Property="Fill" Value="{DynamicResource CardGlowIdle}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardScreen" TargetType="Border">
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{DynamicResource CardScreenIdle}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateKey}" Value="running">
                    <Setter Property="Background" Value="{DynamicResource CardScreenRunning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="starting">
                    <Setter Property="Background" Value="{DynamicResource CardScreenAttention}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="stopping">
                    <Setter Property="Background" Value="{DynamicResource CardScreenAttention}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="failed">
                    <Setter Property="Background" Value="{DynamicResource CardScreenAttention}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="dead">
                    <Setter Property="Background" Value="{DynamicResource CardScreenAttention}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="stopped">
                    <Setter Property="Background" Value="{DynamicResource CardScreenStopped}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Defined">
                    <Setter Property="Background" Value="{DynamicResource CardScreenIdle}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StateChipSurface" TargetType="Border" BasedOn="{StaticResource Badge}">
            <Setter Property="Background" Value="{DynamicResource ChipBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateKey}" Value="running">
                    <Setter Property="Background" Value="{DynamicResource SuccessBg}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="starting">
                    <Setter Property="Background" Value="{DynamicResource WarningBg}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="stopping">
                    <Setter Property="Background" Value="{DynamicResource WarningBg}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="failed">
                    <Setter Property="Background" Value="{DynamicResource DangerBg}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="dead">
                    <Setter Property="Background" Value="{DynamicResource DangerBg}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StateChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateKey}" Value="running">
                    <Setter Property="Foreground" Value="{DynamicResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="starting">
                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="stopping">
                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="failed">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="dead">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StateDot" TargetType="Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Fill" Value="{DynamicResource TextSecondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateKey}" Value="running">
                    <Setter Property="Fill" Value="{DynamicResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="starting">
                    <Setter Property="Fill" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="stopping">
                    <Setter Property="Fill" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="failed">
                    <Setter Property="Fill" Value="{DynamicResource Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="dead">
                    <Setter Property="Fill" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The device silhouette is a dark object in both themes, like the
             mockup; it is a drawing, never a captured frame. UX-04b fix pass: it
             now carries a drawn screen (the state tint gradient) with a 3-4 line
             abstract UI placeholder at low alpha, and a 1px specular ring so the
             frame reads as a lit object instead of a flat cut-out. -->
        <Style x:Key="DeviceSilhouette" TargetType="Border">
            <Setter Property="Width" Value="62" />
            <Setter Property="Height" Value="118" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource DeviceBodyBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DeviceBodyBorder}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>

        <!-- One card is 157 DIP of media plus a 131 DIP body and two 1 DIP
             borders. The dashed create tile reads the same value so the two are
             exactly the same height (item 4). -->
        <sys:Double x:Key="CardTileHeight">290</sys:Double>

        <Style x:Key="CompatibleChip" TargetType="Border" BasedOn="{StaticResource Badge}">
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource PanelAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Compatible}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SuccessBg}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Success}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompatibleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Warning}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Compatible}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Success}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One inline error band, reused inside every dialog: a failed
             supervisor call must be visible in the dialog that triggered it,
             not only in the page behind the scrim. B4: same tones and 3 px error
             bar as the Studio infobar, at the inner-card radius. -->
        <ControlTemplate x:Key="InlineError" TargetType="ContentControl">
            <Border Background="{DynamicResource DangerBg}" BorderBrush="{DynamicResource DangerBorder}"
                    BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource Danger}" />
                    <StackPanel Grid.Column="1" Margin="12,8,10,8">
                        <TextBlock Text="{Binding ErrorTitle}" Foreground="{DynamicResource TextPrimary}"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </ControlTemplate>

        <!-- Floating overlays fade in over 220 ms on the dialog curve
             cubic-bezier(0.22,1,0.36,1); nothing bounces, and the guest viewport
             is never animated. Reduced motion is honoured by the code-behind
             paths (drawer) and by WPF's own storyboard suppression is not used
             here because a fade that lands on the same value reads identically. -->
        <Style x:Key="Overlay" TargetType="Grid">
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                    <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="1"
                                                          KeySpline="0.22,1,0.36,1" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Slide-over drawer surface. A drawer is a floating panel, so it is the
             one place besides dialogs that carries a shadow, and it carries two
             layers: a wide ambient shadow behind the panel and a tight key
             shadow on the panel itself. 12 radius on the left corners only,
             because the right edge is the window edge; the specular highlight
             runs down from the top edge. -->
        <Style x:Key="DrawerAmbient" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PopupBg}" />
            <Setter Property="CornerRadius" Value="12,0,0,12" />
            <Setter Property="Effect" Value="{DynamicResource FloatingShadowAmbient}" />
        </Style>

        <Style x:Key="DrawerSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PopupBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="CornerRadius" Value="12,0,0,12" />
            <Setter Property="Effect" Value="{DynamicResource FloatingShadowKey}" />
        </Style>

        <!-- Rail item: a 36 DIP icon target inside a 40 DIP tile. On hover the
             glyph scales to 1.07 and a soft accent-soft radial fades in behind
             it (polish addendum item 10, local to this window's rail; the global
             version is UX-04b). views:RailHover drives the two named parts and
             skips the motion when Windows reports reduced motion. -->
        <Style x:Key="RailItem" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="PART_Glow" Width="34" Height="34" Opacity="0"
                                     Fill="{DynamicResource HoverGlow}" />
                            <Border x:Name="B" Background="Transparent" CornerRadius="6" />
                            <ContentPresenter x:Name="PART_Glyph" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource PressedBg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation rail. Only the two destinations this window can reach are
             present: the Studio window and this Devices view. -->
        <Border x:Name="NavRail" Grid.Column="0" Background="{DynamicResource NavBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,12">
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource RailItem}" Command="{Binding RefreshCommand}"
                            views:RailHover.IsEnabled="True"
                            ToolTip="Reload instances, profiles and readiness"
                            AutomationProperties.Name="Refresh the device library">
                        <Path Data="{StaticResource IconRefresh}" Style="{StaticResource Glyph}" />
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top">
                    <Button Style="{StaticResource RailItem}" Command="{Binding OpenStudioCommand}"
                            views:RailHover.IsEnabled="True"
                            ToolTip="Studio: the running guest view"
                            AutomationProperties.Name="Studio">
                        <Path Data="{StaticResource IconMonitor}" Style="{StaticResource Glyph}" />
                    </Button>
                    <Grid Width="44" Height="40" Margin="6,0,0,0" ToolTip="Devices: the managed instance library"
                          AutomationProperties.Name="Devices (current view)">
                        <Border Background="{DynamicResource AccentSoftBg}" CornerRadius="6" />
                        <Border Width="2" Height="18" HorizontalAlignment="Left"
                                Background="{DynamicResource Accent}" CornerRadius="1" />
                        <Path Data="{StaticResource IconGrid}" Stroke="{DynamicResource Accent}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Width="16" Height="16" Stretch="None"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
                <Grid />
            </DockPanel>
        </Border>

        <!-- Page. It is made inert (no hit-testing, no tab stop) while a
             slide-over drawer is open, so nothing behind the scrim can take
             focus from the drawer. -->
        <Grid x:Name="LibraryPage" Grid.Column="1" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: eyebrow, page title, one sentence; then search, sort and
                 the single accent action of the page. -->
            <Grid Grid.Row="0" Margin="24,20,24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                    <!-- Fix pass: the LIBRARY eyebrow carries the design sheet's
                         tracking. The text stays 'LIBRARY' for a screen reader
                         (Caps.Tracking keeps the original as the accessible name). -->
                    <TextBlock Text="LIBRARY" Style="{StaticResource Eyebrow}" views:Caps.Tracking="True" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Devices" Style="{StaticResource PageText}" Margin="0,2,0,0" />
                        <!-- Item 5: the count sits inline after the title as a
                             mono text3 suffix, from instance.list. -->
                        <TextBlock Text="{Binding CardCountText}" Style="{StaticResource Mono}"
                                   FontSize="15" Foreground="{DynamicResource TextTertiary}"
                                   VerticalAlignment="Bottom" Margin="10,0,0,4"
                                   ToolTip="Managed devices the supervisor reports; while a search narrows the grid it reads shown of total" />
                    </StackPanel>
                    <TextBlock Text="Managed instances in this workspace. Each runs isolated, with its own ports and data."
                               Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                               HorizontalAlignment="Left" MaxWidth="520" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource InputBorder}"
                            BorderThickness="1" CornerRadius="6" Height="32" Width="268" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconSearch}"
                                  Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="16" Height="16" Stretch="None"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Search name, API, ABI, serial"
                                       IsHitTestVisible="False" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiary}"
                                       Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}}" />
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Filter the library (name, image, ABI, API level, serial)"
                                     AutomationProperties.Name="Search devices" />
                        </Grid>
                    </Border>

                    <!-- Item 6: sort is a 32 DIP ghost button that opens the shared
                         menu style; only orders the library really applies are
                         offered, and the button always names the active one. -->
                    <Button x:Name="SortButton" Style="{StaticResource ToolButton}" Height="32"
                            Margin="0,0,8,0" Click="OnSortMenu"
                            ToolTip="Sort order for the cards"
                            AutomationProperties.Name="Sort the device library">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Name" Tag="Name" Click="OnSortPicked"
                                          AutomationProperties.Name="Sort by name" />
                                <MenuItem Header="State" Tag="State" Click="OnSortPicked"
                                          AutomationProperties.Name="Sort by state" />
                                <MenuItem Header="RAM" Tag="RAM" Click="OnSortPicked"
                                          AutomationProperties.Name="Sort by configured RAM" />
                                <MenuItem Header="API level" Tag="API level" Click="OnSortPicked"
                                          AutomationProperties.Name="Sort by API level" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Sort:" Foreground="{DynamicResource TextTertiary}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SortKey}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            <Path Data="{StaticResource IconChevronDown}" Width="12" Height="12" Stretch="None"
                                  Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" Margin="6,1,0,0" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NewDeviceButton" Style="{StaticResource PrimaryButton}"
                            Command="{Binding NewDeviceCommand}"
                            Height="32" Margin="0" Padding="14,0"
                            ToolTip="Create a device from the pinned AOSP profile"
                            AutomationProperties.Name="New device">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Style="{StaticResource Glyph}"
                                  VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="New device" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Summary: four counters, every one of them from supervisor data. -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="18,0,18,6">
                <Border Style="{StaticResource Card}" Margin="6" Padding="14,12" MinHeight="80">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconStack}" Width="16" Height="16" Stretch="None"
                                  Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Instances" Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding InstanceCountText}" Style="{StaticResource StatValue}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="6" Padding="14,12" MinHeight="80">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlay}" Width="16" Height="16" Stretch="None"
                                  Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.5"
                                  StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Running" Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding RunningCountText}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="{Binding RunningOfText}" Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="6" Padding="14,12" MinHeight="80">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconChip}" Width="16" Height="16" Stretch="None"
                                  Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Configured RAM" Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding RamText}" Style="{StaticResource StatValue}"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding RamOfText}" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource TextTertiary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="6" Padding="14,12" MinHeight="80">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconWarning}" Width="16" Height="16" Stretch="None"
                                  Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Needs attention" Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding AttentionCountText}" Style="{StaticResource StatValue}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding AttentionText}" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource TextTertiary}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Typed error band: err-soft surface, coloured title, one next safe
                 action, and the details stay copyable. -->
            <Border Grid.Row="2" Margin="24,4,24,8" Background="{DynamicResource DangerBg}"
                    BorderBrush="{DynamicResource DangerBorder}" BorderThickness="1" CornerRadius="10"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.Name="Library error">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource Danger}" CornerRadius="10,0,0,10" />
                    <Path Grid.Column="1" Data="{StaticResource IconWarning}" Stroke="{DynamicResource Danger}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Width="16" Height="16" Stretch="None"
                          VerticalAlignment="Top" Margin="12,12,10,0" />
                    <StackPanel Grid.Column="2" Margin="0,10,12,10">
                        <!-- B4: the library band uses the Studio infobar's tones —
                             title in text, body in text2 — so one error looks the
                             same in both windows. -->
                        <TextBlock Text="{Binding ErrorTitle}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Body}"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding ErrorAction}" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,8,8,0">
                        <Button Content="Copy details" Style="{StaticResource ToolButton}"
                                Command="{Binding CopyErrorDetailsCommand}"
                                AutomationProperties.Name="Copy the error details" />
                        <Button Content="Dismiss" Style="{StaticResource ToolButton}" Margin="0"
                                Command="{Binding DismissErrorCommand}"
                                AutomationProperties.Name="Dismiss the error" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Cards -->
            <Grid Grid.Row="3" Margin="24,0,24,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Tiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Polish item 10: hovering one card dims every
                                     sibling (including the dashed tile) to 82 %
                                     over 120 ms; the hovered card stays at 100 %. -->
                                <Grid Width="280" Margin="0,0,16,16"
                                      views:CardHoverFocus.IsEnabled="True">
                                    <!-- Item 2: a keyboard-focused card gets an
                                         accent-soft halo behind it and a 1px accent
                                         border on the frame; hover keeps the
                                         selection stroke. -->
                                    <Border Margin="-4" CornerRadius="14" IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Opacity" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                                 Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBg}" />
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <!-- Real card -->
                                    <Border Visibility="{Binding IsPlaceholder, Converter={StaticResource InverseBoolToVis}}"
                                            Height="{StaticResource CardTileHeight}"
                                            views:CardFocusGlow.IsEnabled="True">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SelectionBorder}" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <!-- 16:9 media at the card's 280 DIP width. -->
                                                <RowDefinition Height="157" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Media (item 1): the viewport colour plus a
                                                 12 % radial glow of the state tint centred
                                                 behind a drawn device whose screen carries
                                                 the same tint as a soft vertical gradient.
                                                 It is a drawing, never a captured frame. -->
                                            <Grid Grid.Row="0">
                                                <Border CornerRadius="9,9,0,0" Style="{StaticResource CardMediaStage}" />
                                                <Ellipse Style="{StaticResource CardGlow}" />

                                                <Grid Width="62" Height="118" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center">
                                                    <Border Style="{StaticResource DeviceSilhouette}">
                                                        <Grid Margin="3">
                                                            <Border Style="{StaticResource CardScreen}" />
                                                            <!-- 3-4 line abstract UI placeholder, low alpha. -->
                                                            <StackPanel Margin="6,9,6,0" IsHitTestVisible="False">
                                                                <Border Height="3" Width="24" CornerRadius="1.5"
                                                                        HorizontalAlignment="Left"
                                                                        Background="{DynamicResource TextPrimary}" Opacity="0.30" />
                                                                <Border Height="2" Width="30" CornerRadius="1" Margin="0,7,0,0"
                                                                        HorizontalAlignment="Left"
                                                                        Background="{DynamicResource TextPrimary}" Opacity="0.16" />
                                                                <Border Height="2" Width="22" CornerRadius="1" Margin="0,4,0,0"
                                                                        HorizontalAlignment="Left"
                                                                        Background="{DynamicResource TextPrimary}" Opacity="0.16" />
                                                                <Border Height="2" Width="27" CornerRadius="1" Margin="0,4,0,0"
                                                                        HorizontalAlignment="Left"
                                                                        Background="{DynamicResource TextPrimary}" Opacity="0.16" />
                                                            </StackPanel>
                                                            <Path Data="{StaticResource IconPower}" Width="16" Height="16" Stretch="None"
                                                                  Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.5"
                                                                  Opacity="0.7"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Visibility="{Binding PrimaryKind, Converter={StaticResource KindVis}, ConverterParameter=start}" />
                                                            <Border Height="2" Width="18" CornerRadius="1" Margin="0,0,0,7"
                                                                    Background="{DynamicResource TextPrimary}" Opacity="0.45"
                                                                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                                    Visibility="{Binding PrimaryKind, Converter={StaticResource KindVis}, ConverterParameter=open}" />
                                                        </Grid>
                                                    </Border>
                                                    <!-- 1px specular ring on the frame. -->
                                                    <Border CornerRadius="14" BorderThickness="1" IsHitTestVisible="False"
                                                            BorderBrush="{DynamicResource SpecularEdge}" />
                                                </Grid>

                                                <Border Style="{StaticResource StateChipSurface}" Margin="10,10,0,0"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        ToolTip="{Binding StateTooltip}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Style="{StaticResource StateDot}" />
                                                        <TextBlock Text="{Binding DisplayState}" Style="{StaticResource StateChipText}" />
                                                    </StackPanel>
                                                </Border>

                                                <Button Style="{StaticResource IconButton}" Width="36" Height="36" Margin="0,6,6,0"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Click="OnCardMenu"
                                                        ToolTip="More actions for this device"
                                                        AutomationProperties.Name="More actions">
                                                    <Button.ContextMenu>
                                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                            <MenuItem Header="Open in Studio" Command="{Binding OpenCommand}" />
                                                            <MenuItem Header="Clone device..." Command="{Binding CloneCommand}" />
                                                            <MenuItem Header="Recovery points..." Command="{Binding RecoveryCommand}" />
                                                            <Separator />
                                                            <MenuItem Header="Reset to baseline..." Command="{Binding ResetCommand}" />
                                                            <MenuItem Header="Delete device..." Command="{Binding DeleteCommand}" />
                                                            <Separator />
                                                            <MenuItem Header="Copy profile JSON" Command="{Binding CopyProfileCommand}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <Path Data="{StaticResource IconMore}" Style="{StaticResource Glyph}"
                                                          Stroke="{DynamicResource TextPrimary}" />
                                                </Button>
                                            </Grid>

                                            <!-- Body -->
                                            <StackPanel Grid.Row="1" Margin="14,12,14,14">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeader}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding NameTooltip}" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"
                                                           Foreground="{DynamicResource TextTertiary}"
                                                           Margin="0,1,0,8" TextTrimming="CharacterEllipsis" />

                                                <WrapPanel Margin="0,0,0,10" ToolTip="{Binding ChipTooltip}">
                                                    <Border Style="{StaticResource Chip}">
                                                        <TextBlock Text="{Binding RamChip}" Style="{StaticResource ChipText}" />
                                                    </Border>
                                                    <Border Style="{StaticResource Chip}">
                                                        <TextBlock Text="{Binding TagText}" Style="{StaticResource ChipText}" />
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Item 3: one accent action per card; Open in
                                                     Studio is a 32 DIP ghost, and Stop is a
                                                     32 DIP ghost icon button that names the
                                                     guest it stops. -->
                                                <Grid Height="32">
                                                    <Button Style="{StaticResource ToolButton}" Command="{Binding OpenCommand}"
                                                            HorizontalAlignment="Stretch" Margin="0,0,38,0"
                                                            Visibility="{Binding PrimaryKind, Converter={StaticResource KindVis}, ConverterParameter=open}"
                                                            ToolTip="Show this guest in the Studio window"
                                                            AutomationProperties.Name="Open the device in Studio">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconMonitor}" Style="{StaticResource Glyph}"
                                                                  VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <TextBlock Text="Open in Studio" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>

                                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}"
                                                            HorizontalAlignment="Stretch" Margin="0" Height="32"
                                                            Visibility="{Binding PrimaryKind, Converter={StaticResource KindVis}, ConverterParameter=start}"
                                                            ToolTip="Start this guest (instance.start, cold boot)"
                                                            AutomationProperties.Name="Start the device">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconPlay}" Style="{StaticResource Glyph}"
                                                                  VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <TextBlock Text="Start" VerticalAlignment="Center"
                                                                       FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Button>

                                                    <Button Style="{StaticResource WarnButton}" Command="{Binding RecoveryCommand}"
                                                            HorizontalAlignment="Stretch" Margin="0" Height="32"
                                                            Visibility="{Binding PrimaryKind, Converter={StaticResource KindVis}, ConverterParameter=recover}"
                                                            ToolTip="The guest failed; open its recovery points"
                                                            AutomationProperties.Name="Recover the device">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconRecovery}" Style="{StaticResource Glyph}"
                                                                  VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <TextBlock Text="Recover…" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>

                                                    <Button Content="Starting…" Style="{StaticResource ToolButton}"
                                                            HorizontalAlignment="Stretch" Margin="0" Height="32" IsEnabled="False"
                                                            Visibility="{Binding PrimaryKind, Converter={StaticResource KindVis}, ConverterParameter=starting}" />
                                                    <Button Content="Stopping…" Style="{StaticResource ToolButton}"
                                                            HorizontalAlignment="Stretch" Margin="0" Height="32" IsEnabled="False"
                                                            Visibility="{Binding PrimaryKind, Converter={StaticResource KindVis}, ConverterParameter=stopping}" />
                                                    <Button Content="State unknown" Style="{StaticResource ToolButton}"
                                                            HorizontalAlignment="Stretch" Margin="0" Height="32" IsEnabled="False"
                                                            Visibility="{Binding PrimaryKind, Converter={StaticResource KindVis}, ConverterParameter=unknown}" />

                                                    <Button Style="{StaticResource IconButton}" Width="32" Height="32"
                                                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"
                                                            Command="{Binding StopCommand}"
                                                            Visibility="{Binding PrimaryKind, Converter={StaticResource KindVis}, ConverterParameter=open}"
                                                            ToolTip="{Binding StopTooltip}"
                                                            AutomationProperties.Name="{Binding StopTooltip}">
                                                        <Path Data="{StaticResource IconPower}" Style="{StaticResource Glyph}" />
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Dashed "New device" tile (item 4): a 40 DIP
                                         accent-soft circle with an accent glyph, the
                                         same height as a card, and a dashed accent
                                         edge on hover. -->
                                    <Button Command="{Binding DataContext.NewDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Height="{StaticResource CardTileHeight}"
                                            Visibility="{Binding IsPlaceholder, Converter={StaticResource BoolToVis}}"
                                            AutomationProperties.Name="Create a device"
                                            ToolTip="Create a device from the pinned AOSP profile">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid>
                                                    <Rectangle x:Name="Frame" RadiusX="10" RadiusY="10"
                                                               Stroke="{DynamicResource BorderBrush}" StrokeThickness="1"
                                                               StrokeDashArray="4 3" Fill="Transparent" />
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Frame" Property="Stroke" Value="{DynamicResource Accent}" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Frame" Property="Stroke" Value="{DynamicResource FocusRing}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Margin="24,0" MaxWidth="220">
                                            <!-- Fix pass item 9: accent-soft fill with
                                                 an accent glyph. AccentSoftBg is the
                                                 neutral nav tint and read as grey. -->
                                            <Border Width="40" Height="40" CornerRadius="20"
                                                    Background="{DynamicResource AccentSoftTint}"
                                                    HorizontalAlignment="Center">
                                                <Path Data="{StaticResource IconPlus}" Width="18" Height="18" Stretch="None"
                                                      Stroke="{DynamicResource Accent}" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="Create device" Style="{StaticResource SectionHeader}"
                                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                                            <TextBlock Text="Pick an image, profile and resources. The pinned AOSP API 35 profile is one click."
                                                       Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiary}"
                                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state: icon, one sentence, one action. -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                            Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource PanelAlt}"
                            HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconStack}" Width="24" Height="24" Stretch="Uniform"
                              Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.26"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Border>
                    <TextBlock Text="No managed devices yet" Style="{StaticResource PageText}" FontSize="20"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="This workspace has no AVD to run. Create one from the pinned AOSP API 35 image; it gets its own ports and disk."
                               Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,6,0,16" />
                    <Button Content="Create device" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Center" Command="{Binding NewDeviceCommand}"
                            AutomationProperties.Name="Create device" />
                </StackPanel>

                <!-- No-match state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                            Visibility="{Binding ShowNoMatchState, Converter={StaticResource BoolToVis}}">
                    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource PanelAlt}"
                            HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconSearch}" Width="22" Height="22" Stretch="Uniform"
                              Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.36"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Border>
                    <TextBlock Text="{Binding NoMatchTitle}" Style="{StaticResource PageText}" FontSize="20"
                               HorizontalAlignment="Center" Margin="0,14,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding NoMatchText}" Style="{StaticResource Caption}" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,6,0,16" />
                    <Button Content="Clear search" Style="{StaticResource ToolButton}" HorizontalAlignment="Center"
                            Command="{Binding ClearSearchCommand}"
                            AutomationProperties.Name="Clear the search" />
                </StackPanel>

                <!-- Busy strip: real indeterminate progress, no dimming. -->
                <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8,0,0" MaxWidth="460"
                        Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="12,10" IsHitTestVisible="False"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.Name="Operation in progress">
                    <StackPanel>
                        <TextBlock Text="{Binding BusyText}" TextWrapping="Wrap" />
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="4" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="24,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource Danger}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Success}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource TextTertiary}" Margin="0,0,14,0" />
                        <!-- Item 11: the temp workspace path never reaches the bar;
                             the segment names it and the full path is a tooltip. -->
                        <Path Data="{StaticResource IconStack}" Width="12" Height="12" Stretch="Uniform"
                              Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.4"
                              VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Workspace" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"
                                   ToolTip="{Binding WorkspaceRoot}"
                                   AutomationProperties.Name="Workspace root"
                                   AutomationProperties.HelpText="{Binding WorkspaceRoot}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Create device: a 460 DIP right-side slide-over, full window height,
             over a ~50 % scrim. Open slides in from the right over 220 ms on
             cubic-bezier(0.22,1,0.36,1) and the scrim fades in alongside; Esc
             and a scrim click close. Tab focus cycles inside the host, and the
             page behind is made inert while it is open
             (DeviceLibraryWindow.xaml.cs). The width is min(460, window-48),
             clamped in code-behind on SizeChanged. -->
        <Grid x:Name="CreateDrawerHost" Grid.ColumnSpan="2"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
              Visibility="Collapsed">
            <Border x:Name="CreateScrim" Background="{DynamicResource ScrimBg}"
                    MouseLeftButtonDown="OnCreateScrimClick" />
            <Grid x:Name="CreateDrawerShell" Width="460" HorizontalAlignment="Right">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="CreateDrawerSlide" X="0" />
                </Grid.RenderTransform>

                <Border Style="{StaticResource DrawerAmbient}" />
                <Border Style="{StaticResource DrawerSurface}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Specular top edge of the floating surface. -->
                        <Border Height="1" Margin="12,0,0,0" VerticalAlignment="Top" IsHitTestVisible="False"
                                Background="{DynamicResource SpecularEdge}" />

                        <Grid Grid.Row="0" Margin="24,20,20,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="NEW DEVICE" Style="{StaticResource Eyebrow}" />
                                <TextBlock Text="Create device" Style="{StaticResource DialogTitle}" Margin="0,2,0,0" />
                                <TextBlock Text="One AVD from the pinned image, with its own port pair and writable disk."
                                           Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="0"
                                    VerticalAlignment="Top" Command="{Binding CloseCreateCommand}"
                                    ToolTip="Close (Esc)" AutomationProperties.Name="Close the create drawer">
                                <Path Data="{StaticResource IconClose}" Style="{StaticResource Glyph}" />
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,0,0">
                        <StackPanel Margin="0,0,24,8">

                        <TextBlock Text="NAME" Style="{StaticResource Eyebrow}" />
                        <TextBox x:Name="CreateNameBox" Margin="0,4,0,0"
                                 Text="{Binding CreateName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Device name"
                                 ToolTip="Lowercase letters, digits and hyphens; 1-32 characters" />
                        <!-- Item 10: the validation error sits in err directly under
                             the field, above the helper line. -->
                        <TextBlock Text="{Binding CreateNameError}" Style="{StaticResource FieldError}"
                                   Visibility="{Binding HasCreateNameError, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="Lowercase, unique. Used as ws_&lt;name&gt;."
                                   Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiary}"
                                   TextWrapping="Wrap" Margin="0,4,0,14" />

                        <TextBlock Text="IMAGE &amp; PROFILE" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" />
                        <Border Style="{StaticResource Card}" Padding="12,10" Background="{DynamicResource PanelAlt}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Item 7: label left, value right, one line per
                                     row, CharacterEllipsis plus the full string in
                                     the tooltip. -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Image" Style="{StaticResource DrawerRowLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CreateImageText}"
                                           ToolTip="{Binding CreateImageText}" Margin="0,0,0,2">
                                    <!-- The identifier stays in text; only a real
                                         problem (missing or wrong revision) tints
                                         it, so a healthy image is not green ink. -->
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource DrawerRowValue}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CreateImageTone}" Value="warning">
                                                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CreateImageTone}" Value="error">
                                                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Profile" Style="{StaticResource DrawerRowLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CreateProfileText}"
                                           Style="{StaticResource DrawerRowValue}" ToolTip="{Binding CreateProfileText}"
                                           Margin="0,0,0,2" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Acceleration" Style="{StaticResource DrawerRowLabel}" />
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueChip}"
                                        Background="{Binding CreateWhpxChipTone, Converter={StaticResource ToneBrush}, ConverterParameter=bg}"
                                        BorderBrush="{Binding CreateWhpxChipTone, Converter={StaticResource ToneBrush}, ConverterParameter=border}"
                                        ToolTip="{Binding CreateWhpxText}">
                                    <TextBlock Text="{Binding CreateWhpxChip}" Style="{StaticResource ValueChipText}"
                                               Foreground="{Binding CreateWhpxChipTone, Converter={StaticResource ToneBrush}, ConverterParameter=fg}" />
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Text="DISK CHECK" Style="{StaticResource Eyebrow}"
                                   Margin="0,14,0,6" />
                        <Border Style="{StaticResource Card}" Padding="12,10" Background="{DynamicResource PanelAlt}"
                                ToolTip="instance.diskEstimate">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Data partition" Style="{StaticResource DrawerRowLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="2048M" Style="{StaticResource DrawerRowValue}"
                                           ToolTip="The data partition this create asks for (2048M)" Margin="0,0,0,2" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="With one snapshot" Style="{StaticResource DrawerRowLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CreateDiskReserveText}"
                                           Style="{StaticResource DrawerRowValue}" ToolTip="{Binding CreateDiskReserveText}"
                                           Margin="0,0,0,2" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Free on the volume" Style="{StaticResource DrawerRowLabel}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CreateDiskFreeText}"
                                           Style="{StaticResource DrawerRowValue}" ToolTip="{Binding CreateDiskFreeText}"
                                           Margin="0,0,0,2" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Verdict" Style="{StaticResource DrawerRowLabel}" />
                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueChip}"
                                        Background="{Binding CreateDiskChipTone, Converter={StaticResource ToneBrush}, ConverterParameter=bg}"
                                        BorderBrush="{Binding CreateDiskChipTone, Converter={StaticResource ToneBrush}, ConverterParameter=border}"
                                        ToolTip="{Binding CreateDiskVerdict}">
                                    <TextBlock Text="{Binding CreateDiskChip}" Style="{StaticResource ValueChipText}"
                                               Foreground="{Binding CreateDiskChipTone, Converter={StaticResource ToneBrush}, ConverterParameter=fg}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Item 8: one plain line; the technical detail lives
                             behind the info glyph's tooltip. -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="{Binding CreateNote}" Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap"
                                       MaxWidth="330" VerticalAlignment="Center" />
                            <Path Data="{StaticResource IconInfo}" Width="14" Height="14" Stretch="None"
                                  Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" Margin="6,1,0,0"
                                  ToolTip="{Binding CreateNoteDetail}"
                                  AutomationProperties.Name="Where the profile values come from" />
                        </StackPanel>
                        <TextBlock Text="{Binding CreateBlockedReason}" Style="{StaticResource FieldError}"
                                   Visibility="{Binding CreateBlockedReason, Converter={StaticResource TextToVis}}" />
                        <ContentControl Template="{StaticResource InlineError}" Margin="0,10,0,0"
                                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                        </StackPanel>
                        </ScrollViewer>

                        <!-- Sticky footer: the drawer's single accent action stays
                             visible while the body scrolls. Item 9: a 1px
                             stroke-soft divider above it and 16 DIP of padding. -->
                        <Border Grid.Row="2" Background="{DynamicResource PanelBg}"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
                                Padding="16,16">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Style="{StaticResource ToolButton}"
                                        Command="{Binding CloseCreateCommand}"
                                        AutomationProperties.Name="Cancel creating a device" />
                                <Button Content="Create device" Style="{StaticResource PrimaryButton}" Margin="0"
                                        Command="{Binding SubmitCreateCommand}"
                                        AutomationProperties.Name="Create the device" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Clone device: the same 460 DIP right-side slide-over as Create. -->
        <Grid x:Name="CloneDrawerHost" Grid.ColumnSpan="2"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
              Visibility="Collapsed">
            <Border x:Name="CloneScrim" Background="{DynamicResource ScrimBg}"
                    MouseLeftButtonDown="OnCloneScrimClick" />
            <Grid x:Name="CloneDrawerShell" Width="460" HorizontalAlignment="Right">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="CloneDrawerSlide" X="0" />
                </Grid.RenderTransform>

                <Border Style="{StaticResource DrawerAmbient}" />
                <Border Style="{StaticResource DrawerSurface}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Height="1" Margin="12,0,0,0" VerticalAlignment="Top" IsHitTestVisible="False"
                                Background="{DynamicResource SpecularEdge}" />

                        <Grid Grid.Row="0" Margin="24,20,20,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CLONE" Style="{StaticResource Eyebrow}" />
                                <TextBlock Text="Clone device" Style="{StaticResource DialogTitle}" Margin="0,2,0,0" />
                                <TextBlock Text="instance.duplicate copies a stopped guest into an independent instance."
                                           Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="0"
                                    VerticalAlignment="Top" Command="{Binding CloseCloneCommand}"
                                    ToolTip="Close (Esc)" AutomationProperties.Name="Close the clone drawer">
                                <Path Data="{StaticResource IconClose}" Style="{StaticResource Glyph}" />
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,0,0">
                        <StackPanel Margin="0,0,24,8">

                    <Border Style="{StaticResource Card}" Padding="12,10" Background="{DynamicResource PanelAlt}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Source" Style="{StaticResource DrawerRowLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CloneSource}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"
                                       ToolTip="{Binding CloneSource}" Margin="0,0,0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="State" Style="{StaticResource DrawerRowLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CloneSourceState}"
                                       Style="{StaticResource DrawerRowWord}" Margin="0,0,0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Image" Style="{StaticResource DrawerRowLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CloneSourceImage}"
                                       Style="{StaticResource DrawerRowValue}"
                                       ToolTip="{Binding CloneSourceImage}" />
                        </Grid>
                    </Border>

                    <TextBlock Text="NEW NAME" Style="{StaticResource Eyebrow}" Margin="0,14,0,4" />
                    <TextBox x:Name="CloneNameBox" Text="{Binding CloneName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Clone target name" />
                    <TextBlock Text="{Binding CloneNameError}" Style="{StaticResource FieldError}"
                               Visibility="{Binding HasCloneNameError, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="Lowercase, unique. Used as ws_&lt;name&gt;." Style="{StaticResource Caption}"
                               Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding CloneBlockedReason}" Style="{StaticResource FieldError}"
                               Visibility="{Binding CloneBlockedReason, Converter={StaticResource TextToVis}}" />
                    <TextBlock Text="{Binding CloneNote}" Style="{StaticResource Caption}"
                               Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <ContentControl Template="{StaticResource InlineError}" Margin="0,10,0,0"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                        </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2" Background="{DynamicResource PanelBg}"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
                                Padding="16,16">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Style="{StaticResource ToolButton}" Command="{Binding CloseCloneCommand}"
                                        AutomationProperties.Name="Cancel cloning" />
                                <Button Content="Clone device" Style="{StaticResource PrimaryButton}" Margin="0"
                                        Command="{Binding SubmitCloneCommand}"
                                        AutomationProperties.Name="Clone the device" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Recovery points dialog -->
        <Grid Grid.ColumnSpan="2" Style="{StaticResource Overlay}"
              Visibility="{Binding IsRecoveryOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource ScrimBg}" />
            <views:FloatingSurface Style="{StaticResource FloatingDialog}" Width="760" MaxHeight="720"
                                   KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Recovery points" Style="{StaticResource DialogTitle}" />
                            <TextBlock Text="{Binding RecoveryDevice}" Style="{StaticResource SectionHeader}"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                       Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding RecoverySubtitle}" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,14,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="240" Text="{Binding SavePointTag, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="New recovery point tag"
                                     ToolTip="Letters, digits, dot, dash and underscore" />
                            <Button Content="Save point" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                    Command="{Binding SavePointCommand}"
                                    AutomationProperties.Name="Save a recovery point" />
                        </StackPanel>
                        <TextBlock Text="{Binding SavePointError}" Style="{StaticResource FieldError}"
                                   Visibility="{Binding HasSavePointError, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding SavePointHint}" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding SavePointHint, Converter={StaticResource TextToVis}}" />
                        <TextBlock Text="{Binding RecoveryMessage}" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource Success}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding HasRecoveryMessage, Converter={StaticResource BoolToVis}}" />
                        <ContentControl Template="{StaticResource InlineError}" Margin="0,8,0,0"
                                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="380">
                        <ItemsControl ItemsSource="{Binding RecoveryPoints}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8"
                                            Background="{DynamicResource PanelAlt}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Tag}" Style="{StaticResource Mono}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding MetaText}" Style="{StaticResource Caption}"
                                                           Foreground="{DynamicResource TextTertiary}" />
                                                <TextBlock Text="{Binding Reason}" Style="{StaticResource Caption}"
                                                           Foreground="{DynamicResource Warning}" TextWrapping="Wrap"
                                                           Visibility="{Binding Reason, Converter={StaticResource TextToVis}}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource CompatibleChip}" Margin="8,0">
                                                <TextBlock Text="{Binding CompatibleText}" Style="{StaticResource CompatibleText}" />
                                            </Border>
                                            <Button Grid.Column="2" Content="Restore" Style="{StaticResource ToolButton}"
                                                    Margin="0,0,6,0" Command="{Binding RestoreCommand}"
                                                    ToolTip="{Binding RestoreTooltip}"
                                                    AutomationProperties.Name="Restore this recovery point" />
                                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="32" Height="32"
                                                    Margin="0" Command="{Binding DeleteCommand}"
                                                    ToolTip="Delete this recovery point"
                                                    AutomationProperties.Name="Delete this recovery point">
                                                <Path Data="{StaticResource IconTrash}" Style="{StaticResource Glyph}" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380"
                                Visibility="{Binding ShowRecoveryEmpty, Converter={StaticResource BoolToVis}}">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource PanelAlt}"
                                HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconRecovery}" Width="20" Height="20" Stretch="Uniform"
                                  Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Border>
                        <TextBlock Text="No recovery point yet" Style="{StaticResource SectionHeader}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock Text="Start the guest, then save a point. The supervisor records the image, the device profile and the configuration fingerprint with each point."
                                   Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="Close" Style="{StaticResource ToolButton}" Margin="0"
                                Command="{Binding CloseRecoveryCommand}"
                                AutomationProperties.Name="Close the recovery points" />
                    </StackPanel>
                </Grid>
            </views:FloatingSurface>
        </Grid>

        <!-- Destructive confirmation -->
        <Grid Grid.ColumnSpan="2" Style="{StaticResource Overlay}"
              Visibility="{Binding IsConfirmOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource ScrimBg}" />
            <views:FloatingSurface Style="{StaticResource FloatingDialog}" Width="520"
                                   KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding ConfirmTitle}" Style="{StaticResource DialogTitle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ConfirmText}" Style="{StaticResource Body}"
                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Cancel" Style="{StaticResource ToolButton}"
                                Command="{Binding CancelConfirmCommand}"
                                AutomationProperties.Name="Cancel" />
                        <Button Content="{Binding ConfirmActionText}" Style="{StaticResource DangerButton}" Margin="0"
                                Command="{Binding ConfirmCommand}"
                                AutomationProperties.Name="Confirm the destructive action" />
                    </StackPanel>
                </StackPanel>
            </views:FloatingSurface>
        </Grid>
    </Grid>
</Window>
