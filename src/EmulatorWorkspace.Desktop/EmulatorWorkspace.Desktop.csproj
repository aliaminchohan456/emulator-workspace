  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmulatorWorkspace.Core\EmulatorWorkspace.Core.csproj" />
    <ProjectReference Include="..\EmulatorWorkspace.Contracts\EmulatorWorkspace.Contracts.csproj" />
    <ProjectReference Include="..\EmulatorWorkspace.Controller\EmulatorWorkspace.Controller.csproj" />
  </ItemGroup>
</Project>
