    <UseWPF>true</UseWPF>
    <RootNamespace>EmulatorWorkspace.Desktop</RootNamespace>
    <AssemblyName>EmulatorWorkspace.Desktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
