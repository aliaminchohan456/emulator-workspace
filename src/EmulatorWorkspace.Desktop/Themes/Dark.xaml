<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Graphite Studio dark surfaces. Base/navigation/panel/raised match the
         approved design tokens; the viewport stays near-black so the guest
         supplies the dominant color. -->
    <SolidColorBrush x:Key="WindowBg" Color="#111315" />
    <SolidColorBrush x:Key="NavBg" Color="#151719" />
    <SolidColorBrush x:Key="PanelBg" Color="#1B1E21" />
    <SolidColorBrush x:Key="PanelAlt" Color="#23272B" />
    <SolidColorBrush x:Key="ChipBg" Color="#2C3236" />
    <SolidColorBrush x:Key="PressedBg" Color="#262B2F" />
    <SolidColorBrush x:Key="HoverBg" Color="#24282C" />
    <SolidColorBrush x:Key="PopupBg" Color="#23272B" />
    <SolidColorBrush x:Key="BorderBrush" Color="#353C42" />
    <SolidColorBrush x:Key="BorderSubtle" Color="#282D31" />

    <SolidColorBrush x:Key="TextPrimary" Color="#F0F2F4" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A4AFB8" />
    <SolidColorBrush x:Key="TextTertiary" Color="#8D99A3" />
    <SolidColorBrush x:Key="TextDisabled" Color="#6E7A83" />

    <SolidColorBrush x:Key="Accent" Color="#B3D9FA" />
    <SolidColorBrush x:Key="AccentHover" Color="#C4E2FB" />
    <SolidColorBrush x:Key="AccentPressed" Color="#9CC8EF" />
    <SolidColorBrush x:Key="AccentText" Color="#142A3B" />
    <SolidColorBrush x:Key="Danger" Color="#FFA6A6" />
    <SolidColorBrush x:Key="DangerBg" Color="#3A2528" />
    <SolidColorBrush x:Key="Success" Color="#8ED8AF" />
    <SolidColorBrush x:Key="SuccessBg" Color="#1E2E26" />
    <SolidColorBrush x:Key="Warning" Color="#EFC58A" />
    <SolidColorBrush x:Key="WarningBg" Color="#33291C" />
    <SolidColorBrush x:Key="LogBg" Color="#0C0E10" />
    <SolidColorBrush x:Key="ViewportBg" Color="#0C0E10" />
    <SolidColorBrush x:Key="SelectionBg" Color="#243441" />
    <SolidColorBrush x:Key="SelectionBorder" Color="#3D5266" />
    <SolidColorBrush x:Key="FocusRing" Color="#B3D9FA" />
</ResourceDictionary>
