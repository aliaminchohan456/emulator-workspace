<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Graphite Studio dark surfaces. Base/navigation/panel/raised match the
         approved design tokens; the viewport stays near-black so the guest
         supplies the dominant color. -->
    <SolidColorBrush x:Key="WindowBg" Color="#111315" />
    <SolidColorBrush x:Key="NavBg" Color="#151719" />
    <SolidColorBrush x:Key="PanelBg" Color="#1B1E21" />
    <SolidColorBrush x:Key="PanelAlt" Color="#23272B" />
    <SolidColorBrush x:Key="ChipBg" Color="#2C3236" />
    <SolidColorBrush x:Key="PressedBg" Color="#262B2F" />
    <SolidColorBrush x:Key="HoverBg" Color="#24282C" />
    <SolidColorBrush x:Key="PopupBg" Color="#23272B" />
    <!-- UX-10: the status bar keeps the dark PanelBg it always had; the token
         exists so the light theme can use the navigation strip without a second
         dark value. -->
    <SolidColorBrush x:Key="StatusBarBg" Color="#1B1E21" />
    <!-- UX-10: the log table header keeps its transparent surface in the dark
         theme; the light theme paints the navigation strip there. -->
    <SolidColorBrush x:Key="LogHeaderBg" Color="Transparent" />
    <SolidColorBrush x:Key="BorderBrush" Color="#353C42" />
    <SolidColorBrush x:Key="BorderSubtle" Color="#282D31" />

    <SolidColorBrush x:Key="TextPrimary" Color="#F0F2F4" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A4AFB8" />
    <!-- TextTertiary is brightened one step from the design package value so
          meta text reaches >=4.5:1 on every tinted surface (ChipBg, SelectionBg,
          PopupBg), not just on plain panels. -->
    <SolidColorBrush x:Key="TextTertiary" Color="#99A5B0" />
    <SolidColorBrush x:Key="TextDisabled" Color="#6E7A83" />

    <SolidColorBrush x:Key="Accent" Color="#B3D9FA" />
    <SolidColorBrush x:Key="AccentHover" Color="#C4E2FB" />
    <SolidColorBrush x:Key="AccentPressed" Color="#9CC8EF" />
    <SolidColorBrush x:Key="AccentText" Color="#142A3B" />
    <!-- UX-10: the muted accent a disabled primary keeps (accent at 40 % over
         the panel) instead of turning into a ghost, as the dark design sheet
         draws its Disabled state. -->
    <SolidColorBrush x:Key="AccentDisabled" Color="#556675" />
    <SolidColorBrush x:Key="AccentDisabledText" Color="#142A3B" />
    <!-- Accent-soft = accent at 10% over the navigation surface (#252A30); used
          by the active navigation item and the neutral "info" chip. -->
    <SolidColorBrush x:Key="AccentSoftBg" Color="#252A30" />
    <SolidColorBrush x:Key="ScrimBg" Color="#80000000" />
    <!-- UX-06: the settings slide-over dims the studio at 50 % in the dark
          theme. It is its own token because the UX-04 library drawers keep the
          original ScrimBg; the settings drawer is the only surface the reviewer
          specified at 50 / 30 instead of a single 50 % value. -->
    <SolidColorBrush x:Key="SettingsScrimBg" Color="#80000000" />
    <!-- UX-07 fix pass: the command palette dims the studio at 40 % (its own
          spec), one step lighter than the drawer so a 640 DIP panel keeps the
          studio readable behind it. -->
    <SolidColorBrush x:Key="PaletteScrimBg" Color="#66000000" />
    <!-- UX-10: dialogs dim at 40 % in the light theme; the dark consent keeps the
         50 % the UX-09 review asked for. -->
    <SolidColorBrush x:Key="DialogScrimBg" Color="#80000000" />
    <!-- UX-11 (igr-feedback-ux11): the inspector overlay's 30 % dim. The light
         theme is the one the reviewer specified; the dark theme matches it so the
         panel separates from the near-black stage at the same weight. -->
    <SolidColorBrush x:Key="InspectorScrimBg" Color="#4D000000" />
    <!-- UX-04b: the 1px specular edge of a floating surface is a VERTICAL
          gradient (top edge .14 white fading to .03 at the bottom), so the
          highlight runs along the top edge and dies out down the panel. It is
          used both as a 1px border brush and as a 1px top-edge line. -->
    <LinearGradientBrush x:Key="SpecularEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#24FFFFFF" Offset="0" />
        <GradientStop Color="#08FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <!-- Accent-soft radial behind a hovered rail/toolbar icon. -->
    <RadialGradientBrush x:Key="HoverGlow" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#26B3D9FA" Offset="0" />
        <GradientStop Color="#00B3D9FA" Offset="1" />
    </RadialGradientBrush>
    <!-- Two-layer floating shadow: a wide ambient halo plus a tight key shadow.
          CSS 0 20 50 / 0 4 16 maps to ShadowDepth 10 / 2 and BlurRadius 25 / 8. -->
    <DropShadowEffect x:Key="FloatingShadowAmbient" BlurRadius="25" ShadowDepth="10"
                      Direction="270" Opacity="0.65" Color="#000000" />
    <DropShadowEffect x:Key="FloatingShadowKey" BlurRadius="8" ShadowDepth="2"
                      Direction="270" Opacity="0.4" Color="#000000" />
    <SolidColorBrush x:Key="Danger" Color="#FFA6A6" />
    <!-- UX-10: the label on a solid error primary (the consent confirm): the deep
         red-brown the dark sheet pairs with its salmon fill. -->
    <SolidColorBrush x:Key="OnDanger" Color="#3B1215" />
    <!-- UX-04: err-soft is error at 12% over the base surface (not a solid
          maroon): #2E2526 = #111315 + 12% #FFA6A6. DangerBorder is the same
          error colour at 35% so the band keeps a visible 1px edge without a
          saturated fill. Error text on DangerBg measures 8.0:1. -->
    <SolidColorBrush x:Key="DangerBg" Color="#2E2526" />
    <SolidColorBrush x:Key="DangerBorder" Color="#59FFA6A6" />
    <SolidColorBrush x:Key="Success" Color="#8ED8AF" />
    <SolidColorBrush x:Key="SuccessBg" Color="#1E2E26" />
    <!-- UX-04b fix pass: 1px tone edges for ok/warn chips so a soft chip keeps a
         readable shape on the viewport-coloured card media (item 12). Alphas
         match DangerBorder (35%). -->
    <SolidColorBrush x:Key="SuccessBorder" Color="#598ED8AF" />
    <SolidColorBrush x:Key="Warning" Color="#EFC58A" />
    <SolidColorBrush x:Key="WarningBg" Color="#33291C" />
    <SolidColorBrush x:Key="WarningBorder" Color="#59EFC58A" />
    <SolidColorBrush x:Key="LogBg" Color="#0C0E10" />
    <SolidColorBrush x:Key="ViewportBg" Color="#0C0E10" />
    <!-- UX-04b fix pass: a card keeps a visible stroke in every theme (#CDD5DC
          in the light sheet); dark uses the existing panel stroke value. -->
    <SolidColorBrush x:Key="CardStroke" Color="#353C42" />
    <!-- UX-04: the library card silhouette is a drawn device, dark in every
          theme like the mockup, so it never impersonates a captured frame. -->
    <SolidColorBrush x:Key="DeviceBodyBg" Color="#0B0D0F" />
    <SolidColorBrush x:Key="DeviceBodyBorder" Color="#3A4249" />
    <!-- UX-04b fix pass: the drawn screen is a soft vertical gradient of the
          state tint between 45 % and 35 %, and the glow behind the device is the
          same tint at 12 % fading out. Both live in the theme dictionaries so a
          live theme switch repaints the cards (the state brushes themselves are
          DynamicResource, never frozen colours in the window). -->
    <LinearGradientBrush x:Key="CardScreenRunning" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#738ED8AF" Offset="0" />
        <GradientStop Color="#598ED8AF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardScreenStopped" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#73B3D9FA" Offset="0" />
        <GradientStop Color="#59B3D9FA" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardScreenAttention" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#73EFC58A" Offset="0" />
        <GradientStop Color="#59EFC58A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardScreenIdle" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7399A5B0" Offset="0" />
        <GradientStop Color="#5999A5B0" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SelectionBg" Color="#243441" />
    <SolidColorBrush x:Key="SelectionBorder" Color="#3D5266" />
    <SolidColorBrush x:Key="FocusRing" Color="#B3D9FA" />

    <!-- Essential control boundaries (>=3:1 against the surfaces they sit on):
          InputBorder on PanelBg 3.3:1, ScrollThumb on PanelBg 3.3:1 and on the
          near-black LogBg 3.9:1; hover is a brighter step, dragging uses the
          focus/accent brush. -->
    <SolidColorBrush x:Key="InputBorder" Color="#64717C" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#64717C" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#7E8A94" />

    <!-- UX-05 ambient stage (addendum 6): a STATIC radial glow behind the device
          on the viewport colour - accent at ~7 % with a small ok core at ~3 % -
          plus a 1.5 % monochrome noise tile that kills the banding of a large
          flat viewport. Nothing here samples the guest frame, and none of it is
          tinted by device state. -->
    <RadialGradientBrush x:Key="StageGlow" Center="0.5,0.5" GradientOrigin="0.5,0.5"
                         RadiusX="0.6" RadiusY="0.72">
        <GradientStop Color="#12B3D9FA" Offset="0" />
        <GradientStop Color="#06B3D9FA" Offset="0.6" />
        <GradientStop Color="#00B3D9FA" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="StageGlowOk" Center="0.5,0.5" GradientOrigin="0.5,0.5"
                         RadiusX="0.3" RadiusY="0.38">
        <GradientStop Color="#0A8ED8AF" Offset="0" />
        <GradientStop Color="#008ED8AF" Offset="1" />
    </RadialGradientBrush>
    <!-- 8x8 tile of 1 px monochrome specks at 1.5-2.5 % alpha: a static dither,
          not a texture the eye can read. -->
    <DrawingBrush x:Key="StageNoise" TileMode="Tile" Stretch="None"
                  Viewport="0,0,8,8" ViewportUnits="Absolute"
                  Viewbox="0,0,8,8" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#05FFFFFF" Geometry="M0,0 L1,0 L1,1 L0,1 Z" />
                <GeometryDrawing Brush="#05FFFFFF" Geometry="M3,0 L4,0 L4,1 L3,1 Z" />
                <GeometryDrawing Brush="#06FFFFFF" Geometry="M6,1 L7,1 L7,2 L6,2 Z" />
                <GeometryDrawing Brush="#05FFFFFF" Geometry="M1,2 L2,2 L2,3 L1,3 Z" />
                <GeometryDrawing Brush="#04FFFFFF" Geometry="M4,2 L5,2 L5,3 L4,3 Z" />
                <GeometryDrawing Brush="#05FFFFFF" Geometry="M7,4 L8,4 L8,5 L7,5 Z" />
                <GeometryDrawing Brush="#06FFFFFF" Geometry="M0,4 L1,4 L1,5 L0,5 Z" />
                <GeometryDrawing Brush="#05FFFFFF" Geometry="M2,5 L3,5 L3,6 L2,6 Z" />
                <GeometryDrawing Brush="#04FFFFFF" Geometry="M5,6 L6,6 L6,7 L5,7 Z" />
                <GeometryDrawing Brush="#05FFFFFF" Geometry="M3,7 L4,7 L4,8 L3,8 Z" />
                <GeometryDrawing Brush="#05FFFFFF" Geometry="M6,7 L7,7 L7,8 L6,8 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- The APK dropzone covers the whole viewport card, so it needs a raised
          veil rather than a translucent box: panel at 92 % (igr-feedback-ux05
          item 7), so the ghost phone and the pill do not read through it. -->
    <SolidColorBrush x:Key="DropVeilBg" Color="#EB1B1E21" />
    <!-- The decorative device frame is a drawn bezel AROUND the live frame, so
          it has to read as a device body on the near-black stage (a shade above
          the viewport colour) and stays dark in the light theme like the
          library's drawn device. -->
    <SolidColorBrush x:Key="DeviceFrameBg" Color="#1C2024" />
    <!-- The decorative device frame is a drawn bezel behind the live frame, so
          its shadow never sits under the streaming bitmap. -->
    <DropShadowEffect x:Key="DeviceFrameShadow" BlurRadius="22" ShadowDepth="6"
                      Direction="270" Opacity="0.55" Color="#000000" />

    <!-- UX-05 fix pass (igr-feedback-ux04b item 2): the focus glow on the single
          focused library card. FocusGlowColor is the accent as a raw Color for
          the DropShadowEffect (an effect takes a Color, not a brush) and
          FocusGlowOpacity is the weight the effect animates to over 120 ms. -->
    <Color x:Key="FocusGlowColor">#B3D9FA</Color>
    <sys:Double x:Key="FocusGlowOpacity">0.35</sys:Double>
    <!-- UX-05 fix pass (item 9): the library Create tile's '+' disc needs an
          accent-soft FILL. AccentSoftBg is the neutral navigation tint (#252A30),
          which reads as grey here; this is the accent at ~22 % over the panel so
          the disc reads as the accent family without becoming a solid fill. -->
    <SolidColorBrush x:Key="AccentSoftTint" Color="#3A4650" />
</ResourceDictionary>
