<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Porcelain light surfaces: the same structure as Graphite Studio with
         neutral light panels and a deep blue action accent. -->
    <SolidColorBrush x:Key="WindowBg" Color="#F6F7F8" />
    <SolidColorBrush x:Key="NavBg" Color="#EEF0F2" />
    <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelAlt" Color="#E4E9ED" />
    <SolidColorBrush x:Key="ChipBg" Color="#EDF1F4" />
    <SolidColorBrush x:Key="PressedBg" Color="#DFE5EA" />
    <SolidColorBrush x:Key="HoverBg" Color="#F0F3F5" />
    <SolidColorBrush x:Key="PopupBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#B8C2CB" />
    <SolidColorBrush x:Key="BorderSubtle" Color="#DDE2E7" />

    <SolidColorBrush x:Key="TextPrimary" Color="#1C2933" />
    <SolidColorBrush x:Key="TextSecondary" Color="#52616E" />
    <SolidColorBrush x:Key="TextTertiary" Color="#62727F" />
    <SolidColorBrush x:Key="TextDisabled" Color="#9AA6B0" />

    <SolidColorBrush x:Key="Accent" Color="#235E89" />
    <SolidColorBrush x:Key="AccentHover" Color="#1D5078" />
    <SolidColorBrush x:Key="AccentPressed" Color="#18445F" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Danger" Color="#A52C36" />
    <SolidColorBrush x:Key="DangerBg" Color="#F6E3E5" />
    <SolidColorBrush x:Key="Success" Color="#216443" />
    <SolidColorBrush x:Key="SuccessBg" Color="#E2EFE8" />
    <SolidColorBrush x:Key="Warning" Color="#845716" />
    <SolidColorBrush x:Key="WarningBg" Color="#F5EEDF" />
    <SolidColorBrush x:Key="LogBg" Color="#E0E5E9" />
    <SolidColorBrush x:Key="ViewportBg" Color="#E0E5E9" />
    <SolidColorBrush x:Key="SelectionBg" Color="#DCEAF4" />
    <SolidColorBrush x:Key="SelectionBorder" Color="#9DC1D9" />
    <SolidColorBrush x:Key="FocusRing" Color="#235E89" />
</ResourceDictionary>
