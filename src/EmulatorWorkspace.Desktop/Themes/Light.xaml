<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Porcelain light surfaces: the same structure as Graphite Studio with
         neutral light panels and a deep blue action accent. -->
    <SolidColorBrush x:Key="WindowBg" Color="#F6F7F8" />
    <SolidColorBrush x:Key="NavBg" Color="#EEF0F2" />
    <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF" />
    <!-- UX-10: raised is the design sheet's #EEF1F4. It was #E4E9ED, which read
         as a grey slab inside the white settings cards, the inspector's target
         card and the palette's icon tiles. -->
    <SolidColorBrush x:Key="PanelAlt" Color="#EEF1F4" />
    <!-- UX-10: the neutral chip is #E9EDF0 - between the sheet's #F3F4F5 (chips
         on white) and the raised surface, so one chip reads on both. -->
    <SolidColorBrush x:Key="ChipBg" Color="#E9EDF0" />
    <SolidColorBrush x:Key="PressedBg" Color="#DFE5EA" />
    <SolidColorBrush x:Key="HoverBg" Color="#F0F3F5" />
    <SolidColorBrush x:Key="PopupBg" Color="#FFFFFF" />
    <!-- UX-10: the status bar is the navigation surface (#EEF0F2), the quiet
         strip the light mockup draws, instead of a second white band. -->
    <SolidColorBrush x:Key="StatusBarBg" Color="#EEF0F2" />
    <!-- UX-10 (igr-feedback-ux10 Logcat light): the log table's sticky header sits
         on the navigation surface, not on the log surface. -->
    <SolidColorBrush x:Key="LogHeaderBg" Color="#EEF0F2" />
    <!-- UX-10: stroke is the design sheet's #CDD5DC. It was #B8C2CB, two steps
         darker, so every chip, field and group edge in the light theme read as a
         border instead of the sheet's hairline. -->
    <SolidColorBrush x:Key="BorderBrush" Color="#CDD5DC" />
    <!-- UX-04b fix pass (B3): stroke-soft darkened one step (#DDE2E7 ->
          #D6DDE3) so the inspector's IDENTITY/RESOURCES/SESSION rules and the
          viewport card edge read on white the way 02/17 do. Still a hairline,
          never a border. -->
    <SolidColorBrush x:Key="BorderSubtle" Color="#D6DDE3" />

    <SolidColorBrush x:Key="TextPrimary" Color="#1C2933" />
    <SolidColorBrush x:Key="TextSecondary" Color="#52616E" />
    <!-- TextTertiary is the sheet's #5A6976: 4.98:1 on Raised (EEF1F4), 5.07:1
         on ChipBg and 4.88:1 on SelectionBg, so meta text still clears 4.5:1 on
         every tinted surface as well as on plain white. -->
    <SolidColorBrush x:Key="TextTertiary" Color="#5A6976" />
    <SolidColorBrush x:Key="TextDisabled" Color="#9AA6B0" />

    <SolidColorBrush x:Key="Accent" Color="#235E89" />
    <SolidColorBrush x:Key="AccentHover" Color="#1D5078" />
    <SolidColorBrush x:Key="AccentPressed" Color="#18445F" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
    <!-- Accent-soft is the sheet's active-tile / selection tint (#DCEAF4). The
         old #E1E8ED was accent at 10 % over the base, which read as grey next to
         the sheet's clear blue tile. -->
    <SolidColorBrush x:Key="AccentSoftBg" Color="#DCEAF4" />
    <!-- UX-10: the muted accent a disabled primary keeps instead of turning into
         a ghost, as the design sheet draws it (accent at 40 % over the base). -->
    <SolidColorBrush x:Key="AccentDisabled" Color="#9CB6C9" />
    <SolidColorBrush x:Key="AccentDisabledText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScrimBg" Color="#80000000" />
    <!-- UX-06: the light settings slide-over dims the studio at 30 %, not 50 %.
          On a near-white studio the same scrim weight reads twice as heavy, and
          the reviewer's spec is base black at 30 % for the light theme. The
          UX-04 library drawers keep ScrimBg. -->
    <SolidColorBrush x:Key="SettingsScrimBg" Color="#4D000000" />
    <!-- UX-10: dialogs dim the app at 40 % (igr-feedback-ux10), the consent
         surface included. It is its own token so the settings drawer keeps its
         30 % light dim and the palette keeps its own weight. -->
    <SolidColorBrush x:Key="DialogScrimBg" Color="#66000000" />
    <!-- UX-07 fix pass: the palette's own dim. UX-10 brings it to the reviewer's
         30 % in the light theme. -->
    <SolidColorBrush x:Key="PaletteScrimBg" Color="#4D000000" />
    <!-- UX-11 (igr-feedback-ux11): the inspector's narrow-layout overlay dims the
         stage at 30 % in the light theme, the same weight the reviewer set for the
         other light scrims; the dark theme keeps that weight so the panel separates
         from a near-black stage the same way. -->
    <SolidColorBrush x:Key="InspectorScrimBg" Color="#4D000000" />
    <!-- UX-10 (igr-feedback-ux10 elevation): the specular highlight is OFF in the
          light theme - a white line on white is invisible and the ink version read
          as a shadow. Floating surfaces carry the same #CDD5DC stroke the sheet
          uses for every other edge. -->
    <SolidColorBrush x:Key="SpecularEdge" Color="#CDD5DC" />
    <!-- Accent-soft radial behind a hovered rail/toolbar icon. -->
    <RadialGradientBrush x:Key="HoverGlow" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#24235E89" Offset="0" />
        <GradientStop Color="#00235E89" Offset="1" />
    </RadialGradientBrush>
    <!-- UX-10 (igr-feedback-ux10 elevation): the light sheet's two-layer shadow is
         a very soft slate tint - #1C2933 at 8 % (blur 16, y6) and 6 % (blur 2, y1)
         - not the near-black halo the dark theme needs. -->
    <DropShadowEffect x:Key="FloatingShadowAmbient" BlurRadius="16" ShadowDepth="6"
                      Direction="270" Opacity="0.08" Color="#1C2933" />
    <DropShadowEffect x:Key="FloatingShadowKey" BlurRadius="2" ShadowDepth="1"
                      Direction="270" Opacity="0.06" Color="#1C2933" />
    <SolidColorBrush x:Key="Danger" Color="#A52C36" />
    <!-- UX-04: err-soft is error at 12% over the light base; UX-10 lifts it to
          the design sheet's #F8EEEF so the consent acknowledgement callout and
          the err band read as a soft rose instead of a pink slab. The border is
          the same error at 35%; error text on the band measures 6.1:1. -->
    <SolidColorBrush x:Key="DangerBg" Color="#F8EEEF" />
    <!-- UX-10: the label on a solid error primary (the consent confirm), as the
         design sheet draws it: white on the light red, the deep red-brown on the
         dark salmon. -->
    <SolidColorBrush x:Key="OnDanger" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBorder" Color="#59A52C36" />
    <SolidColorBrush x:Key="Success" Color="#216443" />
    <!-- UX-10: soft state tints follow the design sheet (ok #E8EFEC, warn
         #F8EFE3, err #F8EEEF). The previous values were 12 % of each tone over
         the base, which sat a step darker than the sheet and made the err-soft
         acknowledgement callout read as a pink slab. -->
    <SolidColorBrush x:Key="SuccessBg" Color="#E8EFEC" />
    <!-- UX-04b fix pass: 1px tone edges for ok/warn chips, at the same 35 %
         alpha as DangerBorder, so the Running chip reads as a chip on the
         viewport-coloured card media (item 12). -->
    <SolidColorBrush x:Key="SuccessBorder" Color="#59216443" />
    <SolidColorBrush x:Key="Warning" Color="#845716" />
    <SolidColorBrush x:Key="WarningBg" Color="#F8EFE3" />
    <SolidColorBrush x:Key="WarningBorder" Color="#59845716" />
    <SolidColorBrush x:Key="LogBg" Color="#E0E5E9" />
    <SolidColorBrush x:Key="ViewportBg" Color="#E0E5E9" />
    <!-- UX-04b fix pass: the light card edge from the design sheet; BorderBrush
          alone was too close to a white panel to read as a card. -->
    <SolidColorBrush x:Key="CardStroke" Color="#CDD5DC" />
    <!-- UX-04: the drawn device silhouette stays a dark object on a light
          surface, as in the light mockup. -->
    <SolidColorBrush x:Key="DeviceBodyBg" Color="#171C20" />
    <SolidColorBrush x:Key="DeviceBodyBorder" Color="#2B3238" />
    <!-- UX-04b fix pass: screen gradient (45 % -> 35 %) and the glow behind the
          device. The drawn screen uses the theme's BRIGHT state tints (the ones
          the dark theme paints with) because the silhouette body is dark in both
          themes: 45 % of #216443 over a near-black body would read as black. Text
          tokens are untouched. The glow is the same hue at 20 % here, which is
          the perceptual weight 12 % of the bright tint has on the dark stage. -->
    <LinearGradientBrush x:Key="CardScreenRunning" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#738ED8AF" Offset="0" />
        <GradientStop Color="#598ED8AF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardScreenStopped" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#73B3D9FA" Offset="0" />
        <GradientStop Color="#59B3D9FA" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardScreenAttention" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#73EFC58A" Offset="0" />
        <GradientStop Color="#59EFC58A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardScreenIdle" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7399A5B0" Offset="0" />
        <GradientStop Color="#5999A5B0" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SelectionBg" Color="#DCEAF4" />
    <SolidColorBrush x:Key="SelectionBorder" Color="#9DC1D9" />
    <SolidColorBrush x:Key="FocusRing" Color="#235E89" />

    <!-- Essential control boundaries (>=3:1 against the surfaces they sit on):
          InputBorder on white panels 3.6:1, ScrollThumb on white 4.1:1 and on
          the tinted LogBg 3.2:1; hover is a darker step, dragging uses the
          focus/accent brush. -->
    <SolidColorBrush x:Key="InputBorder" Color="#7C8894" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#70808B" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#5C6B76" />

    <!-- UX-05 ambient stage (addendum 6): the same static glow in ink. igr
          feedback-ux05 item 3: the light stage banded, so the accent run is now
          ~4 % at the centre (no 8 %/5 % pair) and the ok core ~2.5 %, with one
          intermediate stop so the falloff stays smooth on the light viewport
          (#E0E5E9). The noise tile is still black specks at 1.5-2 % so it
          dithers without greying the stage. -->
    <!-- UX-06 (igr-feedback-ux06, UX-05 nit 2): the two stacked radials still
          left faint concentric rings on the light stage. The ok layer is dropped
          here (transparent, so the key still resolves) and the single accent
          radial carries five stops, which is enough to make each alpha step fall
          below the banding threshold on #E0E5E9. The dark stage is unchanged. -->
    <RadialGradientBrush x:Key="StageGlow" Center="0.5,0.5" GradientOrigin="0.5,0.5"
                         RadiusX="0.6" RadiusY="0.72">
        <GradientStop Color="#0A235E89" Offset="0" />
        <GradientStop Color="#08235E89" Offset="0.3" />
        <GradientStop Color="#05235E89" Offset="0.55" />
        <GradientStop Color="#02235E89" Offset="0.8" />
        <GradientStop Color="#00235E89" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="StageGlowOk" Color="#00000000" />
    <!-- UX-10 (igr-feedback-ux10 stage): the light stage carries no noise tile -
         the five-stop glow is already smooth on #E0E5E9 and the dither read as a
         faint grey film. The key still resolves. -->
    <SolidColorBrush x:Key="StageNoise" Color="#00000000" />
    <!-- igr-feedback-ux05 item 7: the veil is 92 % here too, so the ghost phone
          and the pill do not read through a light dropzone. -->
    <SolidColorBrush x:Key="DropVeilBg" Color="#EBFFFFFF" />
    <!-- The bezel stays a dark device body on the light stage, like the drawn
          devices in the library cards. UX-10 uses the sheet's deep slate. -->
    <SolidColorBrush x:Key="DeviceFrameBg" Color="#1C2933" />
    <DropShadowEffect x:Key="DeviceFrameShadow" BlurRadius="22" ShadowDepth="6"
                      Direction="270" Opacity="0.2" Color="#101820" />

    <!-- UX-05 fix pass (igr-feedback-ux04b item 2): the focus glow on the single
          focused library card. The light theme carries the softer .25 weight. -->
    <Color x:Key="FocusGlowColor">#235E89</Color>
    <sys:Double x:Key="FocusGlowOpacity">0.25</sys:Double>
    <!-- UX-05 fix pass (item 9): accent-soft fill for the Create tile's disc. -->
    <SolidColorBrush x:Key="AccentSoftTint" Color="#DCE9F3" />
</ResourceDictionary>
