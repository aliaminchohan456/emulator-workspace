<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EmulatorWorkspace.Desktop.Views">

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- UX-04b fix pass (B1): Cascadia Code is the second choice so a host that
         ships the Code variant still gets a Cascadia face; Consolas is the
         measured fallback (this host has neither Cascadia family). Mono runs are
         always Normal weight: the design sheet prints light mono values, and a
         Consolas fallback at 12 DIP turns bold into a slab. -->
    <FontFamily x:Key="MonoFont">Cascadia Mono, Cascadia Code, Consolas</FontFamily>

    <!-- Radii, UX-04b: the whole app reads the shape from these four values so
         an outer surface is always its inner surface plus the padding between
         them. Controls 6, cards/panels 10, inner cards 8, dialogs 12, the
         floating pill 14 with 10 DIP buttons inside 4 DIP of padding. -->
    <CornerRadius x:Key="RadiusControl">6</CornerRadius>
    <CornerRadius x:Key="RadiusInnerCard">8</CornerRadius>
    <CornerRadius x:Key="RadiusCard">10</CornerRadius>
    <CornerRadius x:Key="RadiusDialog">12</CornerRadius>
    <CornerRadius x:Key="RadiusPill">14</CornerRadius>
    <CornerRadius x:Key="RadiusPillButton">10</CornerRadius>

    <!-- Type ramp (DIP): title 28/36, page 24/32, section 16/24, body 13/20,
         control 14, caption 12/16. Technical identifiers use Cascadia Mono. -->
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="PageText" TargetType="TextBlock" BasedOn="{StaticResource TitleText}">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="LineHeight" Value="32" />
    </Style>

    <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource TitleText}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="24" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource H1}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- Cascadia Mono for identifiers. Tabular figures are global: every number
         that streams through a mono run (fps, ms, sizes, elapsed, counts) then
         holds its width instead of jittering. -->
    <Style x:Key="Mono" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- A live number on its own: mono, tabular, and a fixed minimum width so a
         value that ticks from 9 to 10 never shifts the layout around it. -->
    <Style x:Key="MonoNumeric" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- Line-icon geometry (16x16 grid, ~1.5 stroke) shared by controls. -->
    <Geometry x:Key="IconMinus">M 3,8 L 13,8</Geometry>
    <Geometry x:Key="IconPlus">M 8,3 L 8,13 M 3,8 L 13,8</Geometry>
    <Geometry x:Key="IconChevronDown">M 3.8,6.2 L 8,10.4 L 12.2,6.2</Geometry>
    <Geometry x:Key="IconBack">M 10.2,3.8 L 6,8 L 10.2,12.2</Geometry>
    <Geometry x:Key="IconHome">M 3.2,8.2 L 8,4 L 12.8,8.2 M 4.8,7.2 L 4.8,12.6 L 11.2,12.6 L 11.2,7.2</Geometry>
    <Geometry x:Key="IconRecents">M 6,6 L 6,3 L 13,3 L 13,10 L 10,10 M 3,6 L 3,13 L 10,13 L 10,10</Geometry>
    <Geometry x:Key="IconScreenshot">M 3,5.5 L 6,5.5 L 6.8,3.8 L 9.2,3.8 L 10,5.5 L 13,5.5 L 13,12.5 L 3,12.5 Z M 10,9 A 2,2 0 1 1 6,9 A 2,2 0 1 1 10,9</Geometry>
    <Geometry x:Key="IconInstall">M 8,3 L 8,9.2 M 5.4,6.8 L 8,9.4 L 10.6,6.8 M 3,10.8 L 3,13 L 13,13 L 13,10.8</Geometry>
    <Geometry x:Key="IconPlay">M 5.8,3.8 L 12,8 L 5.8,12.2 Z</Geometry>
    <Geometry x:Key="IconRotate">M 12.6,9.3 A 4.6,4.6 0 1 1 10.9,3.9 M 8.7,3.3 L 11.1,3.7 L 10.5,6</Geometry>
    <!-- UX-05 fix pass (item 5): restart is a counter-clockwise rotate arrow, so
         the power segment reads restart | stop. It is the IconRotate arc mirrored
         on the 16-unit grid (sweep flag flipped), not a new icon language. -->
    <Geometry x:Key="IconRestart">M 3.4,9.3 A 4.6,4.6 0 1 0 5.1,3.9 M 7.3,3.3 L 4.9,3.7 L 5.5,6</Geometry>
    <Geometry x:Key="IconFit">M 6.2,6.2 L 2.8,2.8 M 5.2,2.6 L 2.6,2.6 L 2.6,5.2 M 9.8,9.8 L 13.2,13.2 M 10.8,13.4 L 13.4,13.4 L 13.4,10.8</Geometry>
    <Geometry x:Key="IconActualSize">M 4.2,4.2 L 11.8,4.2 L 11.8,11.8 L 4.2,11.8 Z M 8.9,8 A 0.9,0.9 0 1 1 7.1,8 A 0.9,0.9 0 1 1 8.9,8</Geometry>
    <Geometry x:Key="IconPopOut">M 3,6 L 3,13 L 10,13 L 10,10 M 6.5,9.5 L 13,3 M 9.4,3 L 13,3 L 13,6.6</Geometry>
    <Geometry x:Key="IconFullscreen">M 6,3 L 3,3 L 3,6 M 10,3 L 13,3 L 13,6 M 3,10 L 3,13 L 6,13 M 13,10 L 13,13 L 10,13</Geometry>
    <Geometry x:Key="IconFocus">M 3,8 C 4.6,5.6 11.4,5.6 13,8 C 11.4,10.4 4.6,10.4 3,8 Z M 9.6,8 A 1.6,1.6 0 1 1 6.4,8 A 1.6,1.6 0 1 1 9.6,8</Geometry>
    <Geometry x:Key="IconDetails">M 3,4 L 13,4 L 13,12 L 3,12 Z M 9.2,4 L 9.2,12</Geometry>
    <!-- UX-03 state glyphs: an alert triangle for persistent errors and a check
         for a finished boot stage. -->
    <Geometry x:Key="IconWarning">M 8,2.8 L 14,12.6 L 2,12.6 Z M 8,6.4 L 8,9.4 M 8,11 L 8,11.01</Geometry>
    <Geometry x:Key="IconCheck">M 3.4,8.4 L 6.6,11.4 L 12.6,4.6</Geometry>
    <!-- UX-04 library glyphs. -->
    <Geometry x:Key="IconSearch">M 7,3.4 A 3.6,3.6 0 1 1 6.99,3.4 Z M 9.9,9.9 L 13,13</Geometry>
    <Geometry x:Key="IconSort">M 4,5 L 12,5 M 5,8 L 11,8 M 6.4,11 L 9.6,11</Geometry>
    <Geometry x:Key="IconMore">M 3.2,8 L 3.21,8 M 8,8 L 8.01,8 M 12.8,8 L 12.81,8</Geometry>
    <Geometry x:Key="IconClone">M 6,5.6 L 6,12.8 L 12.8,12.8 L 12.8,5.6 Z M 3.2,10.4 L 3.2,3.2 L 10.4,3.2</Geometry>
    <Geometry x:Key="IconRecovery">M 3.4,8 A 4.6,4.6 0 1 1 8,12.6 A 4.6,4.6 0 1 1 3.4,8 M 8,5.4 L 8,8 L 10.2,9.2</Geometry>
    <Geometry x:Key="IconTrash">M 3.2,4.8 L 12.8,4.8 M 6.2,4.8 L 6.2,3 L 9.8,3 L 9.8,4.8 M 4.8,4.8 L 5.6,13 L 10.4,13 L 11.2,4.8 M 6.9,7 L 6.9,11 M 9.1,7 L 9.1,11</Geometry>
    <Geometry x:Key="IconRefresh">M 12.6,5.6 A 4.8,4.8 0 1 0 13,9.8 M 12.6,2.6 L 12.6,5.9 L 9.3,5.9</Geometry>
    <Geometry x:Key="IconInfo">M 3.4,8 A 4.6,4.6 0 1 1 12.6,8 A 4.6,4.6 0 1 1 3.4,8 M 8,7.4 L 8,11 M 8,5.1 L 8,5.11</Geometry>
    <Geometry x:Key="IconClose">M 4.2,4.2 L 11.8,11.8 M 11.8,4.2 L 4.2,11.8</Geometry>
    <!-- UX-12 caption glyphs, drawn in a 10 x 10 box so the title bar can render
         them at their real size with Stretch=None (no pen thickening). -->
    <Geometry x:Key="IconWindowMinimize">M 1,5 L 9,5</Geometry>
    <Geometry x:Key="IconWindowMaximize">M 1.5,1.5 L 8.5,1.5 L 8.5,8.5 L 1.5,8.5 Z</Geometry>
    <Geometry x:Key="IconWindowRestore">M 3,1 L 9,1 L 9,7 M 1,3 L 7,3 L 7,9 L 1,9 Z</Geometry>
    <Geometry x:Key="IconWindowClose">M 1.5,1.5 L 8.5,8.5 M 8.5,1.5 L 1.5,8.5</Geometry>
    <Geometry x:Key="IconMonitor">M 3,3.6 L 13,3.6 L 13,11.4 L 3,11.4 Z M 6.2,13.6 L 9.8,13.6 M 8,11.4 L 8,13.6</Geometry>
    <Geometry x:Key="IconGrid">M 3,3.6 L 7.2,3.6 L 7.2,7.6 L 3,7.6 Z M 8.8,3.6 L 13,3.6 L 13,7.6 L 8.8,7.6 Z M 3,8.8 L 7.2,8.8 L 7.2,12.8 L 3,12.8 Z M 8.8,8.8 L 13,8.8 L 13,12.8 L 8.8,12.8 Z</Geometry>
    <Geometry x:Key="IconPower">M 8,2.8 L 8,7.8 M 5.4,4.4 A 4.6,4.6 0 1 0 10.6,4.4</Geometry>
    <Geometry x:Key="IconStack">M 3,5.2 L 8,2.8 L 13,5.2 L 8,7.6 Z M 3,8.6 L 8,11 L 13,8.6 M 3,11.6 L 8,14 L 13,11.6</Geometry>
    <Geometry x:Key="IconChip">M 4.6,4.6 L 11.4,4.6 L 11.4,11.4 L 4.6,11.4 Z M 2.8,6.4 L 4.6,6.4 M 2.8,9.6 L 4.6,9.6 M 11.4,6.4 L 13.2,6.4 M 11.4,9.6 L 13.2,9.6</Geometry>
    <!-- UX-04b shell glyphs: destinations, the identity tile and the theme. -->
    <Geometry x:Key="IconDevice">M 5.4,2.4 L 10.6,2.4 C 11.2,2.4 11.6,2.8 11.6,3.4 L 11.6,12.6 C 11.6,13.2 11.2,13.6 10.6,13.6 L 5.4,13.6 C 4.8,13.6 4.4,13.2 4.4,12.6 L 4.4,3.4 C 4.4,2.8 4.8,2.4 5.4,2.4 Z M 7,11.8 L 9,11.8</Geometry>
    <Geometry x:Key="IconLogs">M 3,4.4 L 13,4.4 M 3,8 L 13,8 M 3,11.6 L 9,11.6</Geometry>
    <Geometry x:Key="IconAgents">M 8,3.2 A 2.3,2.3 0 1 1 7.99,3.2 Z M 3.8,13.2 C 3.8,10.8 5.7,9.4 8,9.4 C 10.3,9.4 12.2,10.8 12.2,13.2</Geometry>
    <Geometry x:Key="IconShield">M 8,2.4 L 13,4.4 L 13,8.4 C 13,11 10.8,12.9 8,13.8 C 5.2,12.9 3,11 3,8.4 L 3,4.4 Z</Geometry>
    <Geometry x:Key="IconTheme">M 5.6,8 A 2.4,2.4 0 1 1 10.4,8 A 2.4,2.4 0 1 1 5.6,8 M 8,2.2 L 8,3.8 M 8,12.2 L 8,13.8 M 2.2,8 L 3.8,8 M 12.2,8 L 13.8,8 M 3.9,3.9 L 5,5 M 11,11 L 12.1,12.1 M 12.1,3.9 L 11,5 M 5,11 L 3.9,12.1</Geometry>
    <!-- UX-05: a pointer cursor, used by the stage's input-capability chip. -->
    <Geometry x:Key="IconTouch">M 5.6,3.4 L 5.6,11.4 L 7.6,9.6 L 9.2,12.6 L 10.8,11.8 L 9.2,8.8 L 11.8,8.4 Z</Geometry>
    <!-- UX-06: the settings cog. A 4.2 radius ring with an inner hub and eight
         teeth, so it cannot be confused with IconTheme's sun (a small disc with
         detached rays). Same 16-grid and 1.5 stroke as every other glyph. -->
    <Geometry x:Key="IconSettings">M 3.8,8 A 4.2,4.2 0 1 1 12.2,8 A 4.2,4.2 0 1 1 3.8,8 M 6.2,8 A 1.8,1.8 0 1 1 9.8,8 A 1.8,1.8 0 1 1 6.2,8 M 8,3.8 L 8,2.4 M 8,12.2 L 8,13.6 M 3.8,8 L 2.4,8 M 12.2,8 L 13.6,8 M 5.03,5.03 L 4.04,4.04 M 10.97,10.97 L 11.96,11.96 M 10.97,5.03 L 11.96,4.04 M 5.03,10.97 L 4.04,11.96</Geometry>
    <!-- UX-06 path actions: a copy sheet and a folder, same 16-grid and 1.5
         stroke as every other glyph. The folder tab is drawn as the step in the
         top edge, so it reads at 16 DIP without a second line. -->
    <Geometry x:Key="IconCopy">M 5.6,5.6 L 12.4,5.6 L 12.4,12.4 L 5.6,12.4 Z M 5.6,10.4 L 3.6,10.4 L 3.6,3.6 L 10.4,3.6 L 10.4,5.6</Geometry>
    <Geometry x:Key="IconFolder">M 2.8,4.8 L 6.3,4.8 L 7.6,6.2 L 13.2,6.2 L 13.2,12.2 L 2.8,12.2 Z</Geometry>
    <!-- UX-07 command-palette glyphs. The set above already covered most of the
         fifteen palette commands; these six fill the gaps (a stop square, a cold
         boot bolt, an APK package, a download, a key and an undo arrow) and one
         launch arrow, all on the same 16 grid with the same 1.5 stroke so the
         result rows keep one icon language. -->
    <Geometry x:Key="IconStop">M 4.4,4.4 L 11.6,4.4 L 11.6,11.6 L 4.4,11.6 Z</Geometry>
    <Geometry x:Key="IconBolt">M 9.2,2.4 L 4.4,8.8 L 7.4,8.8 L 6.8,13.6 L 11.6,7.2 L 8.6,7.2 Z</Geometry>
    <Geometry x:Key="IconPackage">M 8,2.6 L 13.2,5.4 L 13.2,10.6 L 8,13.4 L 2.8,10.6 L 2.8,5.4 Z M 2.8,5.4 L 8,8.2 L 13.2,5.4 M 8,8.2 L 8,13.4</Geometry>
    <Geometry x:Key="IconDownload">M 8,2.6 L 8,9.4 M 5.2,6.8 L 8,9.6 L 10.8,6.8 M 3,11.2 L 3,13.2 L 13,13.2 L 13,11.2</Geometry>
    <Geometry x:Key="IconKey">M 6.2,6.2 A 2.4,2.4 0 1 1 6.19,6.2 Z M 7.9,7.9 L 12.8,12.8 M 10.4,10.4 L 11.7,9.1 M 11.6,11.6 L 12.9,10.3</Geometry>
    <Geometry x:Key="IconUndo">M 4.4,5.2 L 2.4,7.2 L 4.4,9.2 M 2.6,7.2 L 9,7.2 A 3.3,3.3 0 0 1 9,13.8 L 7.2,13.8</Geometry>
    <Geometry x:Key="IconLaunch">M 8,2.8 L 8,9.4 M 5.4,5.4 L 8,2.8 L 10.6,5.4 M 3.2,9.4 L 3.2,13.2 L 12.8,13.2 L 12.8,9.4</Geometry>
    <!-- UX-08 logcat glyphs: pause (two bars, so it cannot be confused with the
         play triangle) and the funnel the mockup's "Filter by tag" field leads
         with. Same 16 grid and 1.5 stroke as every other glyph. -->
    <Geometry x:Key="IconPause">M 5.8,3.8 L 5.8,12.2 M 10.2,3.8 L 10.2,12.2</Geometry>
    <Geometry x:Key="IconFilter">M 2.8,4 L 13.2,4 L 9.2,8.6 L 9.2,12.8 L 6.8,11.4 L 6.8,8.6 Z</Geometry>

    <Style x:Key="FocusRingBorder" TargetType="Border">
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Margin" Value="-4" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="BorderBrush" Value="{DynamicResource FocusRing}" />
    </Style>

    <!-- Keyboard-only focus visual. WPF shows a FocusVisualStyle only when the
         element received focus through keyboard navigation, so a mouse click
         never draws the ring while tab users still see exactly one. Set this
         as FocusVisualStyle on every style that draws no other focus border. -->
    <Style x:Key="FocusRingVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border Style="{StaticResource FocusRingBorder}" Opacity="1"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon glyph: a 16x16 stroke path colored by the host control foreground,
         so hover/pressed/disabled states restyle the icon for free. -->
    <Style x:Key="Glyph" TargetType="Path">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
    </Style>

    <!-- Secondary (surface + border) button: normal/hover/pressed/focus/disabled
         states, pressed feedback without layout shift. Hover and press are two
         overlay layers faded by views:Motion (120 ms / 80 ms on
         cubic-bezier(.2,.8,.2,1)) instead of a colour snap, and both layers sit
         under the label so the text never dims. Disabled uses one mechanism: the
         whole control dims via opacity. -->
    <Style x:Key="ToolButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PanelBg}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="views:Motion.HoverFade" Value="True" />
        <!-- The FocusVisualStyle ring is the one focus indicator and WPF
             shows it only for keyboard-initiated focus, so a mouse click
             never draws it and no system dashed rectangle appears. -->
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="B"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusControl}" />
                        <Border x:Name="PART_Hover" Background="{DynamicResource ChipBg}"
                                CornerRadius="{StaticResource RadiusControl}" Opacity="0"
                                IsHitTestVisible="False" />
                        <Border x:Name="PART_Press" Background="{DynamicResource PressedBg}"
                                CornerRadius="{StaticResource RadiusControl}" Opacity="0"
                                IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="B" Property="Opacity" Value="0.5" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
                            <Setter Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary action: strong accent fill, one per local decision. A primary
         that cannot run keeps a muted accent surface (accent at 40 % over the
         panel) with its on-accent label, exactly as the design sheet draws the
         Disabled state; it never becomes an invisible ghost on a white panel. The
         call site explains why in its tooltip. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="views:Motion.HoverFade" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="B"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusControl}" />
                        <Border x:Name="PART_Hover" Background="{DynamicResource AccentHover}"
                                CornerRadius="{StaticResource RadiusControl}" Opacity="0"
                                IsHitTestVisible="False" />
                        <Border x:Name="PART_Press" Background="{DynamicResource AccentPressed}"
                                CornerRadius="{StaticResource RadiusControl}" Opacity="0"
                                IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentDisabled}" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentDisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- UX-04: caution and destructive ghost actions. Same geometry as the
         secondary button; only the text and border carry the tone, and the
         words in the label always name the consequence. UX-10: the privileged
         action carries the warn-soft fill both design sheets draw (the outline
         alone vanished into the light panel). -->
    <Style x:Key="WarnButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Foreground" Value="{DynamicResource Warning}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBorder}" />
        <Setter Property="Background" Value="{DynamicResource WarningBg}" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}" />
        <Setter Property="Background" Value="{DynamicResource DangerBg}" />
    </Style>

    <!-- 36 DIP icon-only action with an accessible name supplied at the call
         site. Hover fades a ChipBg layer (120 ms) while the glyph scales to 1.07
         over an accent-soft radial (views:RailHover); press is an 80 ms
         PressedBg layer. Both behaviours are shared with the device-library
         rail, so the rail and the toolbar icons move identically. -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="views:Motion.HoverFade" Value="True" />
        <Setter Property="views:RailHover.IsEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="PART_Glow" Width="34" Height="34" Opacity="0"
                                 Fill="{DynamicResource HoverGlow}" IsHitTestVisible="False" />
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusControl}" />
                        <Border x:Name="PART_Hover" Background="{DynamicResource ChipBg}"
                                CornerRadius="{StaticResource RadiusControl}" Opacity="0"
                                IsHitTestVisible="False" />
                        <Border x:Name="PART_Press" Background="{DynamicResource PressedBg}"
                                CornerRadius="{StaticResource RadiusControl}" Opacity="0"
                                IsHitTestVisible="False" />
                        <ContentPresenter x:Name="PART_Glyph" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                          RecognizesAccessKey="True">
                            <ContentPresenter.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A 34x30 icon inside a segmented group: the group is the surface, so the
         button itself draws no resting background and keeps the same hover,
         press, focus and hover-scale behaviour as IconButton. -->
    <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- UX-05: a 36 DIP icon inside the floating toolbar pill. The pill is the
         raised surface, so the button is transparent; its hover/press layers
         take the 10 DIP inner radius (14 outer = 10 + 4 DIP of pill padding).
         Hover, press, focus ring, tooltip and the 1.07 glyph scale are the same
         behaviours every IconButton has. -->
    <Style x:Key="PillIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="PART_Glow" Width="34" Height="34" Opacity="0"
                                 Fill="{DynamicResource HoverGlow}" IsHitTestVisible="False" />
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusPillButton}" />
                        <Border x:Name="PART_Hover" Background="{DynamicResource ChipBg}"
                                CornerRadius="{StaticResource RadiusPillButton}" Opacity="0"
                                IsHitTestVisible="False" />
                        <Border x:Name="PART_Press" Background="{DynamicResource PressedBg}"
                                CornerRadius="{StaticResource RadiusPillButton}" Opacity="0"
                                IsHitTestVisible="False" />
                        <ContentPresenter x:Name="PART_Glyph" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                          RecognizesAccessKey="True">
                            <ContentPresenter.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented icon group: one raised surface holding related commands, 1 px
         stroke-soft dividers between them. Outer 8 = inner 6 + 1 DIP of padding,
         so the radii stay concentric. -->
    <Style x:Key="SegmentGroup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusInnerCard}" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="SegmentDivider" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="Margin" Value="1,4" />
    </Style>

    <!-- State pill, LOW item 10: ok-soft for Running, warn-soft for Starting,
         err-soft for Failed, and a plain chip for anything the supervisor did
         not classify. Always a word plus a 6 DIP dot, never colour alone. -->
    <Style x:Key="StatePill" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,2,9,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource ChipBg}" />
    </Style>

    <Style x:Key="StatePillText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StatePillDot" TargetType="Ellipse">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource TextTertiary}" />
    </Style>

    <!-- UX-10: tone chips driven by the element's own Tag. The converters that did
         this job resolved a brush ONCE, so a live theme switch left a dark-theme
         chip on a light surface (the Magisk lab chip stayed #23272B in the light
         theme). A tag-driven style keeps every brush a DynamicResource, so the chip
         repaints with the theme like the rest of the window. Tags are the tone
         words ("ok"/"warning"/"error") and the supervisor's state words. -->
    <Style x:Key="ToneTagPill" TargetType="Border" BasedOn="{StaticResource StatePill}">
        <Setter Property="Background" Value="{DynamicResource PanelAlt}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="ok">
                <Setter Property="Background" Value="{DynamicResource SuccessBg}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Running">
                <Setter Property="Background" Value="{DynamicResource SuccessBg}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="warning">
                <Setter Property="Background" Value="{DynamicResource WarningBg}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Starting">
                <Setter Property="Background" Value="{DynamicResource WarningBg}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stopping">
                <Setter Property="Background" Value="{DynamicResource WarningBg}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="error">
                <Setter Property="Background" Value="{DynamicResource DangerBg}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Failed">
                <Setter Property="Background" Value="{DynamicResource DangerBg}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToneTagText" TargetType="TextBlock" BasedOn="{StaticResource StatePillText}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="ok">
                <Setter Property="Foreground" Value="{DynamicResource Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Running">
                <Setter Property="Foreground" Value="{DynamicResource Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="warning">
                <Setter Property="Foreground" Value="{DynamicResource Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Starting">
                <Setter Property="Foreground" Value="{DynamicResource Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stopping">
                <Setter Property="Foreground" Value="{DynamicResource Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="error">
                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Failed">
                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToneTagDot" TargetType="Ellipse" BasedOn="{StaticResource StatePillDot}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="ok">
                <Setter Property="Fill" Value="{DynamicResource Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Running">
                <Setter Property="Fill" Value="{DynamicResource Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="warning">
                <Setter Property="Fill" Value="{DynamicResource Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Starting">
                <Setter Property="Fill" Value="{DynamicResource Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stopping">
                <Setter Property="Fill" Value="{DynamicResource Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="error">
                <Setter Property="Fill" Value="{DynamicResource Danger}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Failed">
                <Setter Property="Fill" Value="{DynamicResource Danger}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- UX-07: the key chip moved here from MainWindow.xaml so the command
         palette prints the same mono key as the Settings drawer's Shortcuts
         rows. Nothing about it changed; it is shared, not duplicated. -->
    <Style x:Key="KeyChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ChipBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="KeyChipText" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- Floating surfaces carry the depth: a wide ambient shadow, a tight key
         shadow and a 1 px specular edge whose highlight runs top to bottom. The
         two raise tokens live in each theme dictionary, so a light surface gets
         the soft dark-alpha pair the addendum asks for. -->
    <Style TargetType="{x:Type views:FloatingSurface}">
        <Setter Property="Background" Value="{DynamicResource PopupBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusDialog}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:FloatingSurface}">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Effect="{DynamicResource FloatingShadowAmbient}" />
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Effect="{DynamicResource FloatingShadowKey}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <Border BorderThickness="1" IsHitTestVisible="False"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                BorderBrush="{DynamicResource SpecularEdge}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A dialog is a floating surface at the dialog radius. -->
    <Style x:Key="FloatingDialog" TargetType="{x:Type views:FloatingSurface}"
           BasedOn="{StaticResource {x:Type views:FloatingSurface}}" />

    <!-- A toast / palette row card is a floating surface at the card radius. -->
    <Style x:Key="FloatingCard" TargetType="{x:Type views:FloatingSurface}"
           BasedOn="{StaticResource {x:Type views:FloatingSurface}}">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- UX-05: the device toolbar pill. Outer 14 with 4 DIP of padding around
         the 10 DIP buttons (concentric: 14 = 10 + 4), the two-layer float
         shadow and the specular top edge that every floating surface carries. -->
    <Style x:Key="FloatingPill" TargetType="{x:Type views:FloatingSurface}"
           BasedOn="{StaticResource {x:Type views:FloatingSurface}}">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- Tabs (the Studio inspector): a plain header strip over a 1 px
         stroke-soft rule, the active tab underlined in accent. No system tab
         chrome, no gradient, no 3D edge. -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Margin="0" Background="Transparent" />
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                          ContentSource="SelectedContent" Margin="0,10,0,0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Background="Transparent">
                        <Border x:Name="B" Background="Transparent" Padding="10,5,10,7">
                            <!-- The selected tab's weight is set on the header
                                 presenter, not the TabItem: FontWeight inherits,
                                 and a SemiBold TabItem also emboldened every mono
                                 value in the tab body (UX-04b fix pass, B1). -->
                            <ContentPresenter x:Name="H" ContentSource="Header" RecognizesAccessKey="True"
                                              TextElement.FontWeight="Normal"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="U" Height="2" VerticalAlignment="Bottom" Opacity="0"
                                Background="{DynamicResource Accent}" CornerRadius="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource HoverBg}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="U" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            <Setter TargetName="H" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    </Style>

    <!-- UX-04: a library card is a panel surface with a 1px stroke; depth comes
         from the surface colour, never from a hard shadow. CardStroke is its own
         token so the light theme can keep the edge visible on white (item 12). -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- A card nested inside a card or dialog: outer 10 minus the 2 DIP inset
         keeps the corners concentric. -->
    <Style x:Key="InnerCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusInnerCard}" />
    </Style>

    <!-- Floating surfaces (dialogs and flyouts) are the only place a soft,
         large shadow is allowed. -->
    <Style x:Key="DialogSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusDialog}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Effect" Value="{DynamicResource FloatingShadowAmbient}" />
    </Style>

    <Style x:Key="DialogTitle" TargetType="TextBlock" BasedOn="{StaticResource PageText}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="28" />
    </Style>

    <!-- Caps eyebrow above a page title (LIBRARY). -->
    <Style x:Key="Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Text input: resting border uses the InputBorder token (>=3:1 against
          the surface), visible focus, themed selection, no default white
          surfaces. Disabled dims once via opacity. -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource PanelBg}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBg}" />
        <Setter Property="SelectionTextBrush" Value="{DynamicResource TextPrimary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="B"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusControl}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover is declared first so a focused TextBox keeps
                             the focus ring border while the pointer is over it. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource TextTertiary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="B" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox with a themed popup; the chevron is a line icon and the open
         state is highlighted on the border. Keyboard focus draws the
         FocusVisualStyle ring; mouse clicks do not. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!-- The template draws the keyboard-focus border itself; the system
             dashed FocusVisualStyle would draw a second one on top. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="views:Motion.HoverFade" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid>
                        <Border x:Name="B" Background="Transparent" CornerRadius="4" Margin="4,1" />
                        <Border x:Name="PART_Hover" Background="{DynamicResource HoverBg}" Opacity="0"
                                CornerRadius="4" Margin="4,1" IsHitTestVisible="False" />
                        <Border x:Name="PART_Press" Background="{DynamicResource PressedBg}" Opacity="0"
                                CornerRadius="4" Margin="4,1" IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource SelectionBg}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource FocusRing}" />
                            <Setter TargetName="B" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource PanelBg}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <!-- Non-editable template: no PART_EditableTextBox, so IsEditable="True"
             is not supported by this style. -->
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border x:Name="B"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusControl}"
                                IsHitTestVisible="False">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  VerticalAlignment="Center"
                                                  IsHitTestVisible="False" />
                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="{StaticResource IconChevronDown}"
                                      Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               PopupAnimation="None">
                            <Border Background="{DynamicResource PopupBg}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusCard}"
                                    Margin="0,4,0,0"
                                    Padding="0,4"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Effect="{DynamicResource FloatingShadowAmbient}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource TextTertiary}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="B" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CheckBox with a drawn check so the box never falls back to system white. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                Background="{DynamicResource PanelBg}"
                                BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="Check" Data="M 3,8 L 6.5,11.5 L 12,4"
                                  Stroke="{DynamicResource AccentText}" StrokeThickness="1.75"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Opacity="0"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <!-- Hover first: a checked box keeps its accent border
                             under the pointer, unchecked boxes get the hover. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextTertiary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Check" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <!-- One disabled mechanism: muted text and a muted
                                 box border; no extra opacity dimming. -->
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="views:Motion.HoverFade" Value="True" />
        <!-- The template draws the keyboard-focus border itself; the system
             dashed FocusVisualStyle would draw a second one on top. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="B" Background="Transparent" CornerRadius="6" />
                        <Border x:Name="PART_Hover" Background="{DynamicResource HoverBg}" Opacity="0"
                                CornerRadius="6" IsHitTestVisible="False" />
                        <ContentPresenter Margin="10,7" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource SelectionBg}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource FocusRing}" />
                            <Setter TargetName="B" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{DynamicResource PanelBg}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <!-- Named PART_HeaderGripper so WPF re-hooks column
                             resize and double-click auto-fit to this Thumb.
                             Its own transparent template hides the default
                             Thumb chrome while keeping hit-testing. -->
                        <Thumb x:Name="PART_HeaderGripper"
                               HorizontalAlignment="Right"
                               Width="8"
                               Margin="0,0,0,1"
                               Background="Transparent"
                               Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!-- The template draws the keyboard-focus border itself; the system
             dashed FocusVisualStyle would draw a second one on top. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <!-- The border is always 1 DIP (transparent while unfocused)
                         so the keyboard-focus ring never shifts row content. -->
                    <Border x:Name="B" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1" Padding="0">
                        <GridViewRowPresenter Content="{TemplateBinding Content}"
                                              Columns="{TemplateBinding GridView.ColumnCollection}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource HoverBg}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource SelectionBg}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim overlay-style scrollbar shared by every scroll surface. UX-05: the
         bar is a 4 DIP pill in a 10 DIP transparent gutter, painted with
         text3 at low alpha so it reads as an overlay rather than a chrome rail;
         it widens to 6 DIP and darkens on hover, and while dragging it takes
         the accent. The gutter never disappears, so content never shifts. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="T" Background="{DynamicResource TextTertiary}"
                                                    Opacity="0.38" CornerRadius="3" Width="4"
                                                    HorizontalAlignment="Center" Margin="0,1" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="T" Property="Width" Value="6" />
                                                    <Setter TargetName="T" Property="Opacity" Value="0.8" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="T" Property="Width" Value="6" />
                                                    <Setter TargetName="T" Property="Opacity" Value="1" />
                                                    <Setter TargetName="T" Property="Background" Value="{DynamicResource Accent}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="T" Background="{DynamicResource TextTertiary}"
                                                            Opacity="0.38" CornerRadius="3" Height="4"
                                                            VerticalAlignment="Center" Margin="1,0" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="T" Property="Height" Value="6" />
                                                            <Setter TargetName="T" Property="Opacity" Value="0.8" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="T" Property="Height" Value="6" />
                                                            <Setter TargetName="T" Property="Opacity" Value="1" />
                                                            <Setter TargetName="T" Property="Background" Value="{DynamicResource Accent}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource PopupBg}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="HorizontalOffset" Value="0" />
        <Setter Property="VerticalOffset" Value="6" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Context menus (including the text-box default menu) stay on theme and
         float: 10 radius, specular edge and the two-layer shadow. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource PopupBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusCard}"
                                Effect="{DynamicResource FloatingShadowAmbient}" />
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusCard}"
                                Padding="0,4"
                                Grid.IsSharedSizeScope="True"
                                Effect="{DynamicResource FloatingShadowKey}">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                        <Border BorderThickness="1" IsHitTestVisible="False"
                                CornerRadius="{StaticResource RadiusCard}"
                                BorderBrush="{DynamicResource SpecularEdge}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="views:Motion.HoverFade" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="B" Background="Transparent" CornerRadius="4" Margin="4,1" />
                        <Border x:Name="PART_Hover" Background="{DynamicResource HoverBg}" Opacity="0"
                                CornerRadius="4" Margin="4,1" IsHitTestVisible="False" />
                        <Border x:Name="PART_Press" Background="{DynamicResource PressedBg}" Opacity="0"
                                CornerRadius="4" Margin="4,1" IsHitTestVisible="False" />
                        <Grid Margin="10,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIcon" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemGesture" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Icon" Margin="0,0,8,0"
                                              VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource TextTertiary}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                       Margin="16,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Keyboard highlight (arrow keys) paints the base layer
                             instantly; pointer hover is the animated layer above
                             it, so both paths show the same tint. -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource HoverBg}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="Margin" Value="0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" Height="1"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Progress: determinate mode sizes PART_Indicator itself; indeterminate
         mode hides it and runs a clipped marquee block instead (a static full
         bar was indistinguishable from a completed operation). -->
    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource PanelAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="Height" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid ClipToBounds="True">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                CornerRadius="2" HorizontalAlignment="Left" />
                        <Border x:Name="PART_Marquee" Width="48" Height="4"
                                Background="{TemplateBinding Foreground}" CornerRadius="2"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="MarqueeTransform" X="-48" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_Marquee" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MarqueeStoryboard">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="MarqueeTransform"
                                            Storyboard.TargetProperty="X"
                                            From="-48" To="400" Duration="0:0:1.4"
                                            RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="MarqueeStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGrid surfaces (agent sessions) follow the same tokens. -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource PanelBg}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBg}" />
            </Trigger>
            <!-- Keyboard focus within the row (e.g. arrow keys in the grid)
                 shows the same hover tint; selection keeps the selection tint. -->
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBg}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectionBg}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <!-- The border is always 1 DIP (transparent when unfocused) so the
             focus ring never shifts cell content. -->
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="8,4" />
        <!-- Foreground is inherited from the row on purpose: a disabled row's
             muted color then reaches its cells instead of being overridden. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource FocusRing}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Background="Transparent" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <DockPanel>
                            <ContentPresenter ContentSource="Header" DockPanel.Dock="Top"
                                              Margin="0,0,0,6" TextElement.FontSize="12"
                                              TextElement.FontFamily="{StaticResource UiFont}"
                                              TextElement.Foreground="{DynamicResource TextSecondary}" />
                            <ContentPresenter />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
