<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBg" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="PanelBg" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="PanelAlt" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="ChipBg" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{x:Static SystemColors.WindowFrameColor}" />
    <SolidColorBrush x:Key="TextPrimary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="Accent" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentText" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="Danger" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Success" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Warning" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="LogBg" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="SelectionBg" Color="{x:Static SystemColors.HighlightColor}" />
</ResourceDictionary>
