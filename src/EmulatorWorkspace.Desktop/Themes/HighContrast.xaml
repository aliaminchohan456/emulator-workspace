<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- High contrast: system colors override every custom accent and surface.
         Labels and border distinctions are preserved; state brushes fall back
         to the window text color because color alone never carries state. -->
    <SolidColorBrush x:Key="WindowBg" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="NavBg" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="PanelBg" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="PanelAlt" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="ChipBg" Color="{x:Static SystemColors.ControlLightColor}" />
    <SolidColorBrush x:Key="PressedBg" Color="{x:Static SystemColors.ControlDarkColor}" />
    <SolidColorBrush x:Key="HoverBg" Color="{x:Static SystemColors.ControlLightColor}" />
    <SolidColorBrush x:Key="PopupBg" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{x:Static SystemColors.WindowFrameColor}" />
    <SolidColorBrush x:Key="BorderSubtle" Color="{x:Static SystemColors.WindowFrameColor}" />

    <SolidColorBrush x:Key="TextPrimary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="TextTertiary" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="TextDisabled" Color="{x:Static SystemColors.GrayTextColor}" />

    <SolidColorBrush x:Key="Accent" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentPressed" Color="{x:Static SystemColors.ControlDarkColor}" />
    <SolidColorBrush x:Key="AccentText" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="Danger" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="DangerBg" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Success" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="SuccessBg" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Warning" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="WarningBg" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="LogBg" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="ViewportBg" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="SelectionBg" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="SelectionBorder" Color="{x:Static SystemColors.WindowFrameColor}" />
    <SolidColorBrush x:Key="FocusRing" Color="{x:Static SystemColors.HighlightColor}" />
</ResourceDictionary>
