<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>EmulatorWorkspace.Controller</RootNamespace>
    <AssemblyName>EmulatorWorkspace.Controller</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.31.1" />
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
    <PackageReference Include="Grpc.Tools" Version="2.71.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\emulator_controller.proto" ProtoRoot="Protos" GrpcServices="Client" />
    <Protobuf Include="Protos\snapshot_service.proto" ProtoRoot="Protos" GrpcServices="Client" />
    <Protobuf Include="Protos\snapshot.proto" ProtoRoot="Protos" GrpcServices="None" />
  </ItemGroup>
</Project>
