<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>EmulatorWorkspace.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../src/EmulatorWorkspace.Supervisor/OperationDispatcher.cs" Link="Supervisor/OperationDispatcher.cs" />
    <!-- UX-07: the command palette's grouping, fuzzy ranking and the Settings
         doctor readings are pure logic, so the tests compile those source files
         instead of referencing the WPF desktop assembly. -->
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/PaletteQuery.cs" Link="Desktop/PaletteQuery.cs" />
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/DoctorSummary.cs" Link="Desktop/DoctorSummary.cs" />
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/ImageNaming.cs" Link="Desktop/ImageNaming.cs" />
    <!-- UX-08: the Logcat drawer's count line, level filter, stream chip and empty
         state are pure rules, so the tests compile that source file too. -->
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/LogcatPresentation.cs" Link="Desktop/LogcatPresentation.cs" />
    <!-- UX-09: the Agent Sessions table's chip words, tones and scope chips, and
         the shared consent dialog's digest display, are pure rules as well. -->
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/AgentSessionsPresentation.cs" Link="Desktop/AgentSessionsPresentation.cs" />
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/ConsentDialogModel.cs" Link="Desktop/ConsentDialogModel.cs" />
    <!-- UX-16: the shell's overlay state and the supervisor watchdog are pure
         rules too, so they compile here instead of linking the WPF desktop. -->
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/OverlayStack.cs" Link="Desktop/OverlayStack.cs" />
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/SupervisorWatchdog.cs" Link="Desktop/SupervisorWatchdog.cs" />
    <!-- UX-17: the theme store and the Windows build gates hold no WPF types,
         so their thresholds and failure paths are unit-tested here. -->
    <Compile Include="../../src/EmulatorWorkspace.Desktop/Services/ThemeMode.cs" Link="Desktop/ThemeMode.cs" />
    <Compile Include="../../src/EmulatorWorkspace.Desktop/Services/ThemeSettingsStore.cs" Link="Desktop/ThemeSettingsStore.cs" />
    <Compile Include="../../src/EmulatorWorkspace.Desktop/Services/PlatformSupport.cs" Link="Desktop/PlatformSupport.cs" />
    <!-- UX-18: the one instance lifecycle every surface reads is a pure rule,
         so it is compiled here instead of linking the WPF desktop assembly.
         The lab phase rules live in Core, which this project already
         references. -->
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/DeviceLifecycle.cs" Link="Desktop/DeviceLifecycle.cs" />
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/FrameStreamHealth.cs" Link="Desktop/FrameStreamHealth.cs" />
    <!-- EV-04: the lab's one reading and the stage's one decision are pure
         rules too, so they are pinned here instead of through a WPF window. -->
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/LabUiState.cs" Link="Desktop/LabUiState.cs" />
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/StudioStage.cs" Link="Desktop/StudioStage.cs" />
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/SubscriptionClose.cs" Link="Desktop/SubscriptionClose.cs" />
    <!-- EV-05: the frame and log subscriptions' one transition function is a
         pure rule, so the races (late grant, close while subscribing, lost
         pipe, double request) are pinned here instead of needing a guest. -->
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/StreamSubscription.cs" Link="Desktop/StreamSubscription.cs" />
    <!-- EV-10: the viewport's pixel conversion, one-deep frame mailbox and
         bitmap-reuse rule are pure, so they are pinned here instead of needing a
         window, a guest or a WPF bitmap. -->
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/ViewportFramePipeline.cs" Link="Desktop/ViewportFramePipeline.cs" />
    <!-- EV-12: the capture-size rule and its 300 ms burst coalescing are pure,
         so the aspect, even, cap, floor, threshold and DPI cases are pinned
         here without a window or a display-scaling change. -->
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/CaptureSizePolicy.cs" Link="Desktop/CaptureSizePolicy.cs" />
    <!-- EV-13: the version gate and the event/fallback cadences are pure
         rules, so the stale-event and disconnected-poll cases are pinned here
         without a supervisor or a window. -->
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/StatusEventRules.cs" Link="Desktop/StatusEventRules.cs" />
    <!-- EV-06: the shell's one page and the inspector's five session-only rows
         are pure rules too, so they are pinned here instead of through a WPF
         window. -->
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/ShellPage.cs" Link="Desktop/ShellPage.cs" />
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/InspectorSessionRows.cs" Link="Desktop/InspectorSessionRows.cs" />
    <!-- EV-07: the device library's one sheet and its one load state are pure
         rules too, so the sheet transitions and the single-flight refresh are
         pinned here instead of through a WPF window. -->
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/LibrarySheet.cs" Link="Desktop/LibrarySheet.cs" />
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/LibraryLoad.cs" Link="Desktop/LibraryLoad.cs" />
    <!-- UX-18: the remembered Magisk lab inputs hold no WPF types either, so
         their failure paths are unit-tested here. -->
    <Compile Include="../../src/EmulatorWorkspace.Desktop/Services/LabInputsStore.cs" Link="Desktop/LabInputsStore.cs" />
    <ProjectReference Include="..\..\src\EmulatorWorkspace.Core\EmulatorWorkspace.Core.csproj" />
    <ProjectReference Include="../EmulatorWorkspace.FakeAdb/EmulatorWorkspace.FakeAdb.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyFakeAdb" AfterTargets="Build">
    <ItemGroup>
      <FakeAdbFiles Include="../EmulatorWorkspace.FakeAdb/bin/$(Configuration)/$(TargetFramework)/*" />
    </ItemGroup>
    <Copy SourceFiles="@(FakeAdbFiles)" DestinationFolder="$(OutDir)fake-adb" />
  </Target>
</Project>
