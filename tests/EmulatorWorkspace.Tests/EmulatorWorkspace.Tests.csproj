<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>EmulatorWorkspace.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../src/EmulatorWorkspace.Supervisor/OperationDispatcher.cs" Link="Supervisor/OperationDispatcher.cs" />
    <!-- UX-07: the command palette's grouping, fuzzy ranking and the Settings
         doctor readings are pure logic, so the tests compile those source files
         instead of referencing the WPF desktop assembly. -->
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/PaletteQuery.cs" Link="Desktop/PaletteQuery.cs" />
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/DoctorSummary.cs" Link="Desktop/DoctorSummary.cs" />
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/ImageNaming.cs" Link="Desktop/ImageNaming.cs" />
    <!-- UX-08: the Logcat drawer's count line, level filter, stream chip and empty
         state are pure rules, so the tests compile that source file too. -->
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/LogcatPresentation.cs" Link="Desktop/LogcatPresentation.cs" />
    <!-- UX-09: the Agent Sessions table's chip words, tones and scope chips, and
         the shared consent dialog's digest display, are pure rules as well. -->
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/AgentSessionsPresentation.cs" Link="Desktop/AgentSessionsPresentation.cs" />
    <Compile Include="../../src/EmulatorWorkspace.Desktop/ViewModels/ConsentDialogModel.cs" Link="Desktop/ConsentDialogModel.cs" />
    <ProjectReference Include="..\..\src\EmulatorWorkspace.Core\EmulatorWorkspace.Core.csproj" />
    <ProjectReference Include="../EmulatorWorkspace.FakeAdb/EmulatorWorkspace.FakeAdb.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyFakeAdb" AfterTargets="Build">
    <ItemGroup>
      <FakeAdbFiles Include="../EmulatorWorkspace.FakeAdb/bin/$(Configuration)/$(TargetFramework)/*" />
    </ItemGroup>
    <Copy SourceFiles="@(FakeAdbFiles)" DestinationFolder="$(OutDir)fake-adb" />
  </Target>
</Project>
